      },
      {
        "name": "user.screen_media_uri",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.screen_media_path",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.screen_width",
        "type": "string",

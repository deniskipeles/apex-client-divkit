{
 "type": "container",
 "item_spacing": 8,
 "items": [
  {
   "type": "container",
   "item_spacing": 8,
   "items": [
    {
     "type": "button",
     "text": "Back",
     "font_size": 12,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "background_color": "#16233A",
     "corner_radius": 12,
     "height": {
      "type": "fixed",
      "value": 40
     },
     "width": {
      "type": "fixed",
      "value": 80
     },
     "actions": [
      {
       "url": "nav://pop"
      }
     ],
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#1E293B",
       "width": 1
      }
     },
     "id": "btn_back"
    },
    {
     "type": "container",
     "items": [
      {
       "type": "text",
       "font_size": 18,
       "font_weight": "bold",
       "text": "Data views",
       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_size": 12,
       "font_weight": "regular",
       "text": "Chart and list blocks fed by the live collection",
       "text_color": "#94A3B8"
      }
     ],
     "orientation": "vertical"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 16,
    "top": 32,
    "right": 16,
    "bottom": 8
   }
  },
  {
   "type": "container",
   "item_spacing": 12,
   "items": [
    {
     "type": "container",
     "border": {
      "corner_radius": 16,
      "stroke": {
       "color": "#1E293B",
       "width": 1
      }
     },
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Sample count",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 26,
       "font_weight": "bold",
       "text": "@{user.samples_count}",
       "text_color": "#34D399"
      },
      {
       "type": "inline_banner",
       "custom_props": {
        "text": "@{user.tools_error == '' ? 'No errors' : user.tools_error}",
        "tone": "warn"
       }
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 12,
      "top": 12,
      "right": 12,
      "bottom": 12
     }
    },
    {
     "type": "custom",
     "custom_props": {
      "chart_type": "bar",
      "title": "POS Analytics Chart",
      "subtitle": "",
      "label_field": "label",
      "value_field": "value",
      "value_prefix": "",
      "value_suffix": "",
      "accent_hex": "#38BDF8",
      "height": 160,
      "show_grid": true,
      "show_legend": true,
      "interactive": true,
      "data_var": "user.chart_json"
     },
     "custom_type": "sdui_chart",
     "id": "samples_chart"
    },
    {
     "type": "json_list",
     "data_var": "user.samples_json",
     "empty_text": "No records",
     "row_card": {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 8,
      "paddings": {
       "left": 12,
       "top": 8,
       "right": 12,
       "bottom": 8
      },
      "items": [
       {
        "type": "text",
        "text": "@{item.name}",
        "font_size": 14,
        "font_weight": "bold",
        "text_color": "#F8FAFC"
       },
       {
        "type": "text",
        "text": "@{item.note}",
        "font_size": 12,
        "text_color": "#94A3B8"
       }
      ]
     },
     "id": "samples_list"
    },
    {
     "type": "container",
     "border": {
      "corner_radius": 16,
      "stroke": {
       "color": "#1E293B",
       "width": 1
      }
     },
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Refresh samples",
       "font_size": 12,
       "font_weight": "bold",
       "text_color": "#FFFFFF",
       "background_color": "#7C3AED",
       "corner_radius": 12,
       "height": {
        "type": "fixed",
        "value": 44
       },
       "width": {
        "type": "match_parent"
       },
       "actions": [
        {
         "url": "local-db://op/db.query",
         "payload": {
          "collection": "samples",
          "order_by": "id",
          "limit": 50,
          "output": {
           "_json": "user.samples_json"
          }
         }
        }
       ],
       "id": "data_refresh"
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 12,
      "top": 12,
      "right": 12,
      "bottom": 12
     }
    }
   ],
   "orientation": "vertical",
   "paddings": {
    "left": 16,
    "top": 0,
    "right": 16,
    "bottom": 0
   }
  }
 ],
 "orientation": "vertical",
 "paddings": {
  "left": 0,
  "top": 0,
  "right": 0,
  "bottom": 16
 }
}

{
 "card": {
  "log_id": "apex_tools_test_data_views",
  "variables": [
   {
    "name": "user.workspace_title",
    "type": "string",
    "value": "APEX TOOLS"
   },
   {
    "name": "user.tools_status",
    "type": "string",
    "value": "Idle"
   },
   {
    "name": "user.tools_result",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.tools_error",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.samples_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.samples_count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "user.db_result",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.chart_json",
    "type": "string",
    "value": "[]"
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "orientation": "vertical",
     "items": [
      {
       "type": "container",
       "orientation": "horizontal",
       "items": [
        {
         "type": "button",
         "text": "Back",
         "font_size": 12,
         "font_weight": "bold",
         "text_color": "#F8FAFC",
         "background_color": "#16233A",
         "corner_radius": 12,
         "height": {
          "type": "fixed",
          "value": 40
         },
         "width": {
          "type": "fixed",
          "value": 80
         },
         "actions": [
          {
           "url": "nav://pop"
          }
         ],
         "border": {
          "corner_radius": 12,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         },
         "id": "btn_back"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Data views",
           "font_size": 18,
           "font_weight": "bold",
           "text_color": "#F8FAFC"
          },
          {
           "type": "text",
           "text": "Chart and list blocks fed by the live collection",
           "font_size": 12,
           "font_weight": "regular",
           "text_color": "#94A3B8"
          }
         ],
         "weight": 1
        }
       ],
       "item_spacing": 8,
       "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
       }
      },
      {
       "type": "container",
       "orientation": "vertical",
       "items": [
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Sample count",
           "font_size": 11,
           "font_weight": "bold",
           "text_color": "#94A3B8"
          },
          {
           "type": "text",
           "text": "@{user.samples_count}",
           "font_size": 26,
           "font_weight": "bold",
           "text_color": "#34D399"
          },
          {
           "type": "inline_banner",
           "custom_props": {
            "text": "@{user.tools_error == '' ? 'No errors' : user.tools_error}",
            "tone": "warn"
           }
          }
         ],
         "item_spacing": 8,
         "background_color": "#111C2E",
         "paddings": {
          "left": 12,
          "top": 12,
          "right": 12,
          "bottom": 12
         },
         "border": {
          "corner_radius": 16,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         }
        },
        {
         "type": "custom",
         "custom_type": "sdui_chart",
         "custom_props": {
          "chart_type": "bar",
          "subtitle": "",
          "label_field": "label",
          "value_field": "value",
          "value_prefix": "",
          "value_suffix": "",
          "accent_color": "#38BDF8",
          "height": 160,
          "show_grid": true,
          "show_legend": true,
          "interactive": true
         },
         "id": "samples_chart"
        },
        {
         "type": "json_list",
         "id": "samples_list"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "button",
           "text": "Refresh samples",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#FFFFFF",
           "background_color": "#7C3AED",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "local-db://op/db.query",
             "payload": {
              "collection": "samples",
              "order_by": "id",
              "limit": 50,
              "output": {
               "_json": "user.samples_json"
              }
             }
            }
           ],
           "id": "data_refresh"
          }
         ],
         "item_spacing": 8,
         "background_color": "#111C2E",
         "paddings": {
          "left": 12,
          "top": 12,
          "right": 12,
          "bottom": 12
         },
         "border": {
          "corner_radius": 16,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         }
        }
       ],
       "item_spacing": 12,
       "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
       }
      }
     ],
     "item_spacing": 8,
     "paddings": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 16
     }
    }
   }
  ]
 }
}

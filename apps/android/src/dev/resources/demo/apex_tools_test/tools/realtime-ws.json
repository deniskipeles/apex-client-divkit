{
  "card": {
    "log_id": "apex_tool_realtime_ws",
    "variables": [
      {
        "name": "user.tools_status",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.tools_result",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.tools_error",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.realtime_connection_state",
        "type": "string",
        "value": ""
      },
      {
        "name": "user.realtime_channel",
        "type": "string",
        "value": ""
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "items": [
            {
              "type": "container",
              "orientation": "horizontal",
              "items": [
                {
                  "type": "button",
                  "text": "Back",
                  "font_size": 12,
                  "font_weight": "bold",
                  "text_color": "#F8FAFC",
                  "background_color": "#16233A",
                  "corner_radius": 12,
                  "height": {
                    "type": "fixed",
                    "value": 40
                  },
                  "width": {
                    "type": "fixed",
                    "value": 80
                  },
                  "actions": [
                    {
                      "url": "nav://pop"
                    }
                  ],
                  "border": {
                    "corner_radius": 12,
                    "stroke": {
                      "color": "#1E293B",
                      "width": 1
                    }
                  },
                  "id": "btn_back"
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "items": [
                    {
                      "type": "text",
                      "text": "realtime-ws",
                      "font_size": 18,
                      "font_weight": "bold",
                      "text_color": "#F8FAFC"
                    },
                    {
                      "type": "text",
                      "text": "Open a websocket channel, subscribe, send a frame and disconnect. Without a reachable server the socket reports a failure rather than pretending to be connected.",
                      "font_size": 12,
                      "font_weight": "regular",
                      "text_color": "#94A3B8"
                    }
                  ],
                  "weight": 1
                }
              ],
              "item_spacing": 8,
              "paddings": {
                "left": 16,
                "top": 32,
                "right": 16,
                "bottom": 8
              }
            },
            {
              "type": "container",
              "orientation": "vertical",
              "items": [
                {
                  "type": "container",
                  "orientation": "vertical",
                  "item_spacing": 4,
                  "paddings": {
                    "left": 12,
                    "top": 8,
                    "right": 12,
                    "bottom": 8
                  },
                  "background_color": "#16233A",
                  "border": {
                    "corner_radius": 12,
                    "stroke": {
                      "color": "#1E293B",
                      "width": 1
                    }
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "Status",
                      "font_size": 11,
                      "font_weight": "bold",
                      "text_color": "#94A3B8"
                    },
                    {
                      "type": "text",
                      "text": "@{user.tools_status}",
                      "font_size": 18,
                      "font_weight": "bold",
                      "text_color": "#34D399"
                    }
                  ],
                  "id": "metric_status"
                },
                {
                  "type": "inline_banner",
                  "custom_props": {
                    "text": "@{user.tools_error == '' ? 'No errors' : user.tools_error}",
                    "tone": "warn"
                  }
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "items": [
                    {
                      "type": "button",
                      "text": "Connect (no transport)",
                      "font_size": 12,
                      "font_weight": "bold",
                      "text_color": "#FFFFFF",
                      "background_color": "#7C3AED",
                      "corner_radius": 12,
                      "height": {
                        "type": "fixed",
                        "value": 40
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "actions": [
                        {
                          "url": "tools://network.realtime/connect",
                          "payload": {
                            "options": {
                              "channel": "kitchen_stream",
                              "url": "ws://127.0.0.1:1/stream"
                            },
                            "output": {
                              "connection_state": "user.tools_result"
                            }
                          }
                        }
                      ],
                      "subtitle": "tools://network.realtime/connect",
                      "id": "tool_realtime-ws_connect_without_transport_fails",
                      "content_description": "realtime-ws connect"
                    },
                    {
                      "type": "button",
                      "text": "Connect (transport)",
                      "font_size": 12,
                      "font_weight": "bold",
                      "text_color": "#F8FAFC",
                      "background_color": "#16233A",
                      "corner_radius": 12,
                      "height": {
                        "type": "fixed",
                        "value": 40
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "actions": [
                        {
                          "url": "tools://network.realtime/connect",
                          "payload": {
                            "options": {
                              "channel": "kitchen_stream",
                              "url": "ws://127.0.0.1:1/stream"
                            },
                            "output": {
                              "connection_state": "user.tools_result"
                            }
                          }
                        }
                      ],
                      "border": {
                        "corner_radius": 12,
                        "stroke": {
                          "color": "#1E293B",
                          "width": 1
                        }
                      },
                      "subtitle": "tools://network.realtime/connect",
                      "id": "tool_realtime-ws_connect_with_transport_succeeds",
                      "content_description": "realtime-ws connect"
                    },
                    {
                      "type": "button",
                      "text": "Subscribe (no endpoint)",
                      "font_size": 12,
                      "font_weight": "bold",
                      "text_color": "#FFFFFF",
                      "background_color": "#7C3AED",
                      "corner_radius": 12,
                      "height": {
                        "type": "fixed",
                        "value": 40
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "actions": [
                        {
                          "url": "tools://network.realtime/subscribe",
                          "payload": {
                            "options": {
                              "channel": "kitchen_stream"
                            },
                            "output": {
                              "connection_state": "user.tools_result"
                            }
                          }
                        }
                      ],
                      "subtitle": "tools://network.realtime/subscribe",
                      "id": "tool_realtime-ws_subscribe_without_endpoint_fails",
                      "content_description": "realtime-ws subscribe"
                    },
                    {
                      "type": "button",
                      "text": "Send (no endpoint)",
                      "font_size": 12,
                      "font_weight": "bold",
                      "text_color": "#F8FAFC",
                      "background_color": "#16233A",
                      "corner_radius": 12,
                      "height": {
                        "type": "fixed",
                        "value": 40
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "actions": [
                        {
                          "url": "tools://network.realtime/send",
                          "payload": {
                            "options": {
                              "channel": "kitchen_stream",
                              "message": "ping"
                            },
                            "output": {
                              "connection_state": "user.tools_result"
                            }
                          }
                        }
                      ],
                      "border": {
                        "corner_radius": 12,
                        "stroke": {
                          "color": "#1E293B",
                          "width": 1
                        }
                      },
                      "subtitle": "tools://network.realtime/send",
                      "id": "tool_realtime-ws_send_without_endpoint_fails",
                      "content_description": "realtime-ws send"
                    },
                    {
                      "type": "button",
                      "text": "Disconnect",
                      "font_size": 12,
                      "font_weight": "bold",
                      "text_color": "#FFFFFF",
                      "background_color": "#7C3AED",
                      "corner_radius": 12,
                      "height": {
                        "type": "fixed",
                        "value": 40
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "actions": [
                        {
                          "url": "tools://network.realtime/disconnect",
                          "payload": {
                            "options": {
                              "channel": "kitchen_stream"
                            },
                            "output": {
                              "connection_state": "user.tools_result"
                            }
                          }
                        }
                      ],
                      "subtitle": "tools://network.realtime/disconnect",
                      "id": "tool_realtime-ws_disconnect_is_safe",
                      "content_description": "realtime-ws disconnect"
                    }
                  ],
                  "item_spacing": 8,
                  "background_color": "#111C2E",
                  "paddings": {
                    "left": 12,
                    "top": 12,
                    "right": 12,
                    "bottom": 12
                  },
                  "border": {
                    "corner_radius": 16,
                    "stroke": {
                      "color": "#1E293B",
                      "width": 1
                    }
                  }
                },
                {
                  "type": "button",
                  "text": "Back to tools",
                  "font_size": 12,
                  "font_weight": "bold",
                  "text_color": "#F8FAFC",
                  "background_color": "transparent",
                  "corner_radius": 12,
                  "height": {
                    "type": "fixed",
                    "value": 40
                  },
                  "width": {
                    "type": "match_parent"
                  },
                  "actions": [
                    {
                      "url": "nav://pop"
                    }
                  ],
                  "border": {
                    "corner_radius": 12,
                    "stroke": {
                      "color": "#1E293B",
                      "width": 1
                    }
                  },
                  "id": "btn_back_footer"
                }
              ],
              "item_spacing": 12,
              "paddings": {
                "left": 16,
                "top": 0,
                "right": 16,
                "bottom": 0
              }
            }
          ],
          "item_spacing": 8,
          "paddings": {
            "left": 0,
            "top": 0,
            "right": 0,
            "bottom": 16
          }
        }
      }
    ]
  }
}

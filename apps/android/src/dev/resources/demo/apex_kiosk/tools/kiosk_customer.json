{
 "type": "container",
 "item_spacing": 16,
 "items": [
  {
   "type": "container",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "container",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "font_size": 24,
         "font_weight": "bold",
         "text": "New order",
         "text_color": "#F8FAFC",
         "visibility": "@{if(user.kiosk_order_id == '', 'visible', 'gone')}"
        },
        {
         "type": "text",
         "font_size": 24,
         "font_weight": "bold",
         "text": "Order @{user.kiosk_order_label}",
         "text_color": "#F8FAFC",
         "visibility": "@{if(user.kiosk_order_id == '', 'gone', 'visible')}"
        },
        {
         "type": "text",
         "font_size": 12,
         "text": "Apex Kiosk · customer ordering",
         "text_color": "#94A3B8"
        }
       ],
       "orientation": "vertical"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "text": "Order",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "@{user.kiosk_order_label}",
       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "·",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 12,
       "text": "@{toInteger(user.kiosk_item_count)} in cart",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "·",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 12,
       "font_weight": "bold",
       "text": "$@{user.kiosk_total}",
       "text_color": "#C4B5FD"
      },
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "paddings": {
        "left": 10,
        "right": 10,
        "top": 5,
        "bottom": 5
       },
       "text": "@{if(user.kiosk_status == 'draft', 'Draft', if(user.kiosk_status == 'submitted', 'Submitted', user.kiosk_status))}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal",
     "visibility": "@{if(user.kiosk_order_id == '', 'gone', 'visible')}"
    }
   ],
   "orientation": "vertical"
  },
  {
   "type": "container",
   "id": "kiosk_customer_error",
   "item_spacing": 8,
   "items": [
    {
     "type": "text",
     "font_size": 12,
     "max_lines": 3,
     "text": "@{user.engine_error}",
     "text_color": "#FCA5A5"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "visibility": "@{if(user.engine_error != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_customer_submitted",
   "item_spacing": 8,
   "items": [
    {
     "type": "text",
     "font_size": 12,
     "max_lines": 3,
     "text": "Submitted — this order is locked. Start a new order or review it in Owner receipt.",
     "text_color": "#34D399"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "visibility": "@{if(user.kiosk_status == 'submitted', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_customer_notice",
   "item_spacing": 8,
   "items": [
    {
     "type": "text",
     "font_size": 12,
     "max_lines": 3,
     "text": "@{user.kiosk_notice}",
     "text_color": "#F8FAFC"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "visibility": "@{if(user.kiosk_notice != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "item_spacing": 8,
   "items": [
    {
     "type": "button",
     "text": "New order",
     "font_size": 14,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Started a new customer order"
       }
      },
      {
       "url": "local-db://op/db.upsert",
       "payload": {
        "collection": "kiosk_orders",
        "data": {
         "direction": "CUSTOMER_REQUEST",
         "status": "draft",
         "terminal_id": "${terminalCode}",
         "created_at": "@{format_date(now(), 'yyyy-MM-dd HH:mm:ss')}"
        },
        "output": {
         "id": "user.kiosk_order_id",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_new_order"
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_order_label",
       "value": {
        "type": "string",
        "value": "@{user.kiosk_order_id}"
       }
      }
     ],
     "background_color": "#1B2740",
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     },
     "weight": 1,
     "icon": "add",
     "id": "kiosk_new_order"
    },
    {
     "type": "button",
     "text": "Undo remove",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Restored @{user.kiosk_undo_label}"
       }
      },
      {
       "url": "local-db://op/db.append_child",
       "payload": {
        "collection": "kiosk_order_lines",
        "parent_id": "@{user.kiosk_order_id}",
        "data": {
         "sku": "@{user.kiosk_undo_sku}",
         "item_name": "@{user.kiosk_undo_label}",
         "unit_price": "@{user.kiosk_undo_price}",
         "quantity": "@{user.kiosk_undo_qty}"
        },
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_undo"
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_undo_sku",
       "value": {
        "type": "string",
        "value": ""
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_undo_label",
       "value": {
        "type": "string",
        "value": ""
       }
      }
     ],
     "weight": 1,
     "icon": "undo",
     "id": "kiosk_undo_remove",
     "background_color": "#E2E8F0",
     "visibility": "@{if(user.kiosk_undo_sku == '', 'gone', 'visible')}"
    }
   ],
   "orientation": "horizontal"
  },
  {
   "type": "text",
   "font_size": 11,
   "text": "Starting a new order keeps the current one saved as a draft.",
   "text_color": "#94A3B8"
  },
  {
   "type": "container",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Catalog",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{user.catalog_count} available",
       "text_color": "#94A3B8"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "text",
     "font_size": 12,
     "text": "Start a new order to add items.",
     "text_color": "#94A3B8",
     "visibility": "@{if(user.kiosk_order_id == '', 'visible', 'gone')}"
    },
    {
     "type": "json_list",
     "data_var": "user.catalog_json",
     "empty_text": "No products available yet.",
     "row_card": {
      "type": "container",
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      },
      "item_spacing": 0,
      "items": [
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "text",
          "font_size": 15,
          "font_weight": "bold",
          "max_lines": 2,
          "text": "@{item.item_name}",
          "text_color": "#F8FAFC"
         },
         {
          "type": "button",
          "text": "Add",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#34D399",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Added @{item.item_name}"
            }
           },
           {
            "url": "local-db://op/db.append_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "parent_id": "@{user.kiosk_order_id}",
             "data": {
              "sku": "@{item.sku}",
              "item_name": "@{item.item_name}",
              "unit_price": "@{item.price}",
              "quantity": 1
             },
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
             }
            },
            "log_id": "kiosk_add_line"
           }
          ],
          "background_color": "#1E2A44",
          "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}",
          "border": {
           "corner_radius": 12,
           "stroke": {
            "color": "#34D399",
            "width": 1
           }
          },
          "width": {
           "type": "fixed",
           "value": 78
          },
          "height": {
           "type": "fixed",
           "value": 38
          }
         }
        ],
        "orientation": "horizontal"
       },
       {
        "type": "container",
        "item_spacing": 6,
        "items": [
         {
          "type": "text",
          "font_family": "monospace",
          "font_size": 11,
          "max_lines": 1,
          "text": "@{item.sku}",
          "text_color": "#94A3B8"
         },
         {
          "type": "text",
          "font_size": 11,
          "max_lines": 1,
          "text": "·",
          "text_color": "#94A3B8"
         },
         {
          "type": "text",
          "font_family": "monospace",
          "font_size": 12,
          "font_weight": "bold",
          "max_lines": 1,
          "text": "$@{if(item.price_display == '', item.price, item.price_display)}",
          "text_color": "#34D399"
         },
         {
          "type": "text",
          "font_size": 11,
          "max_lines": 1,
          "text": "·",
          "text_color": "#94A3B8"
         },
         {
          "type": "text",
          "font_size": 11,
          "max_lines": 1,
          "text": "@{item.stock} in stock",
          "text_color": "#94A3B8"
         }
        ],
        "orientation": "horizontal"
       }
      ],
      "orientation": "vertical",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      }
     }
    }
   ],
   "orientation": "vertical"
  },
  {
   "type": "container",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "In this order",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{user.kiosk_line_count} @{if(toInteger(user.kiosk_line_count) == 1, 'line', 'lines')}",
       "text_color": "#94A3B8"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "json_list",
     "data_var": "user.kiosk_lines_json",
     "empty_text": "No items yet — tap Add on a product above.",
     "row_card": {
      "type": "container",
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      },
      "item_spacing": 10,
      "items": [
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 3,
          "items": [
           {
            "type": "text",
            "font_size": 15,
            "font_weight": "bold",
            "max_lines": 2,
            "text": "@{item.item_name}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "text",
            "font_family": "monospace",
            "font_size": 11,
            "text": "@{item.sku} · $@{item.unit_price_display} each",
            "text_color": "#94A3B8"
           }
          ],
          "orientation": "vertical"
         },
         {
          "type": "text",
          "font_family": "monospace",
          "font_size": 16,
          "font_weight": "bold",
          "text": "$@{item.line_total}",
          "text_color": "#F8FAFC"
         }
        ],
        "orientation": "horizontal"
       },
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 6,
          "items": [
           {
            "type": "button",
            "text": "−",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 10,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) - 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_down"
             }
            ],
            "background_color": "#263449",
            "border": {
             "corner_radius": 10,
             "stroke": {
              "color": "#3B4A63",
              "width": 1
             }
            },
            "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
           },
           {
            "type": "text",
            "font_family": "monospace",
            "font_size": 15,
            "font_weight": "bold",
            "text": "@{item.quantity}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "button",
            "text": "+",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 10,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) + 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_up"
             }
            ],
            "background_color": "#263449",
            "border": {
             "corner_radius": 10,
             "stroke": {
              "color": "#3B4A63",
              "width": 1
             }
            },
            "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
           }
          ],
          "orientation": "horizontal",
          "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
         },
         {
          "type": "button",
          "text": "Remove",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#FCA5A5",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Removed @{item.item_name} — tap Undo to restore"
            }
           },
           {
            "url": "local-db://op/db.remove_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "id": "@{item.id}",
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum",
              "sku": "user.kiosk_undo_sku",
              "item_name": "user.kiosk_undo_label",
              "quantity": "user.kiosk_undo_qty",
              "unit_price": "user.kiosk_undo_price"
             }
            },
            "log_id": "kiosk_remove_line"
           }
          ],
          "background_color": "#3F1D24",
          "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
         }
        ],
        "orientation": "horizontal"
       }
      ],
      "orientation": "vertical",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      }
     }
    }
   ],
   "orientation": "vertical"
  },
  {
   "type": "container",
   "border": {
    "corner_radius": 14,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   },
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 12,
       "text": "Items",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "@{user.kiosk_item_count}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 12,
       "text": "Subtotal",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "$@{user.kiosk_subtotal}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "separator"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 15,
       "font_weight": "bold",
       "text": "Total",
       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 28,
       "font_weight": "bold",
       "text": "$@{user.kiosk_total}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    }
   ],
   "orientation": "vertical",
   "paddings": {
    "left": 16,
    "right": 16,
    "top": 16,
    "bottom": 16
   }
  },
  {
   "type": "text",
   "font_size": 11,
   "id": "kiosk_customer_empty_hint",
   "text": "Add at least one item before submitting.",
   "text_color": "#FBBF24",
   "visibility": "@{if(toInteger(user.kiosk_item_count) == 0, 'visible', 'gone')}"
  },
  {
   "type": "text",
   "font_size": 11,
   "id": "kiosk_submit_warn",
   "text": "Submitting locks the order. Add nothing after this.",
   "text_color": "#FBBF24",
   "visibility": "@{if(user.kiosk_confirm == 'submit', 'visible', 'gone')}"
  },
  {
   "type": "button",
   "text": "Submit order",
   "font_size": 15,
   "font_weight": "bold",
   "text_color": "#FFFFFF",
   "corner_radius": 12,
   "actions": [
    {
     "type": "set_variable",
     "variable_name": "user.kiosk_confirm",
     "value": {
      "type": "string",
      "value": "submit"
     }
    }
   ],
   "background_color": "#8B5CF6",
   "id": "kiosk_submit_ask",
   "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft' && user.kiosk_confirm == '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "item_spacing": 10,
   "items": [
    {
     "type": "button",
     "text": "Confirm submit",
     "font_size": 15,
     "font_weight": "bold",
     "text_color": "#FFFFFF",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Order submitted — locked for editing"
       }
      },
      {
       "url": "local-db://op/db.commit",
       "payload": {
        "collection": "kiosk_orders",
        "id": "@{user.kiosk_order_id}",
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_submit"
      }
     ],
     "background_color": "#DC2626",
     "id": "kiosk_submit",
     "visibility": "@{if(user.kiosk_confirm == 'submit' && user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}",
     "log_id": "kiosk_submit",
     "weight": 1
    },
    {
     "type": "button",
     "text": "Cancel",
     "font_size": 14,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "background_color": "#E2E8F0",
     "id": "kiosk_submit_cancel",
     "weight": 1,
     "visibility": "@{if(user.kiosk_confirm == 'submit', 'visible', 'gone')}",
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_confirm",
       "value": {
        "type": "string",
        "value": ""
       }
      }
     ]
    }
   ],
   "orientation": "horizontal",
   "visibility": "@{if(user.kiosk_confirm == 'submit' && user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
  }
 ],
 "orientation": "vertical"
}

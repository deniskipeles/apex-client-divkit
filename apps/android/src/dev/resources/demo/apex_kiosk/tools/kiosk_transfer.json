{
  "type": "container",
  "orientation": "vertical",
  "item_spacing": 12,
  "items": [
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 3,
      "items": [
        {
          "type": "text",
          "text": "QR transfer",
          "font_size": 22,
          "text_color": "#F8FAFC",
          "font_weight": "bold"
        },
        {
          "type": "text",
          "text": "Move the live order to another terminal as a set of QR chunks",
          "font_size": 12,
          "text_color": "#94A3B8"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "text",
          "text": "@{user.qr_status}",
          "font_size": 11,
          "text_color": "#F8FAFC",
          "font_weight": "bold",
          "background_color": "#0F172A",
          "corner_radius": 20,
          "paddings": {
            "left": 10,
            "right": 10,
            "top": 5,
            "bottom": 5
          }
        },
        {
          "type": "text",
          "text": "@{if(user.qr_count == 0, 'no chunk set yet', 'chunk ' + (toInteger(user.qr_index) + 1) + ' of ' + user.qr_count)}",
          "font_size": 12,
          "text_color": "#94A3B8",
          "font_family": "monospace",
          "weight": 1
        }
      ]
    },
    {
      "type": "image",
      "image_url": "@{user.qr_img_current}",
      "height": {
        "type": "fixed",
        "value": 300
      },
      "corner_radius": 12,
      "visibility": "@{if(user.qr_img_current == '', 'gone', 'visible')}",
      "content_description": "Current QR chunk"
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 8,
      "items": [
        {
          "type": "button",
          "text": "Build QR set",
          "background_color": "#7C3AED",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "font_size": 15,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.qr_index",
              "value": {
                "type": "integer",
                "value": 0
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.scanned_chunks",
              "value": {
                "type": "array",
                "value": []
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.qr_status",
              "value": {
                "type": "string",
                "value": "BUILDING"
              }
            },
            {
              "url": "local-db://op/db.query",
              "payload": {
                "collection": "kiosk_orders",
                "where": {
                  "direction": "CUSTOMER_REQUEST"
                },
                "limit": 1,
                "output": {
                  "id": "user.kiosk_order_label",
                  "status": "user.kiosk_status",
                  "direction": "user.kiosk_direction",
                  "total_display": "user.kiosk_total",
                  "subtotal_display": "user.kiosk_subtotal",
                  "item_count": "user.kiosk_item_count",
                  "line_count": "user.kiosk_line_count",
                  "lines_json": "user.kiosk_lines_json",
                  "payload_json": "user.kiosk_payload_json",
                  "checksum": "user.kiosk_checksum"
                }
              },
              "log_id": "kiosk_transfer_load"
            },
            {
              "url": "local-db://op/doc.pack",
              "payload": {
                "collection": "kiosk_orders",
                "id": "@{user.kiosk_order_id}",
                "output": {
                  "id": "user.kiosk_order_label",
                  "status": "user.kiosk_status",
                  "direction": "user.kiosk_direction",
                  "total_display": "user.kiosk_total",
                  "subtotal_display": "user.kiosk_subtotal",
                  "item_count": "user.kiosk_item_count",
                  "line_count": "user.kiosk_line_count",
                  "lines_json": "user.kiosk_lines_json",
                  "payload_json": "user.kiosk_payload_json",
                  "checksum": "user.kiosk_checksum"
                }
              },
              "log_id": "kiosk_transfer_export"
            },
            {
              "url": "tools://codec/json/chunk",
              "payload": {
                "json": "@{user.kiosk_payload_json}",
                "max_bytes": 700,
                "encoding": "base45",
                "output": {
                  "chunks": "user.qr_chunks",
                  "count": "user.qr_count",
                  "transfer_id": "user.qr_transfer_id",
                  "checksum": "user.qr_checksum"
                }
              },
              "log_id": "kiosk_transfer_chunk"
            },
            {
              "url": "tools://code-generate/generate",
              "payload": {
                "content": "@{getArrayOptString(user.qr_chunks, 0, '')}",
                "format": "QR_CODE",
                "width": 640,
                "height": 640,
                "margin": 4,
                "output": {
                  "uri": "user.qr_img_current",
                  "status": "user.qr_status"
                }
              },
              "log_id": "kiosk_transfer_qr"
            }
          ],
          "icon": "qr_code",
          "weight": 2,
          "id": "kiosk_build_qr_set"
        },
        {
          "type": "button",
          "text": "Prev",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.qr_index",
              "value": {
                "type": "integer",
                "value": "@{max(0, toInteger(user.qr_index) - 1)}"
              }
            },
            {
              "url": "tools://code-generate/generate",
              "payload": {
                "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
                "format": "QR_CODE",
                "width": 640,
                "height": 640,
                "margin": 4,
                "output": {
                  "uri": "user.qr_img_current",
                  "status": "user.qr_status"
                }
              },
              "log_id": "kiosk_transfer_prev"
            }
          ],
          "weight": 1,
          "id": "kiosk_qr_prev"
        },
        {
          "type": "button",
          "text": "Next",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.qr_index",
              "value": {
                "type": "integer",
                "value": "@{min(toInteger(user.qr_count) - 1, toInteger(user.qr_index) + 1)}"
              }
            },
            {
              "url": "tools://code-generate/generate",
              "payload": {
                "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
                "format": "QR_CODE",
                "width": 640,
                "height": 640,
                "margin": 4,
                "output": {
                  "uri": "user.qr_img_current",
                  "status": "user.qr_status"
                }
              },
              "log_id": "kiosk_transfer_next"
            }
          ],
          "weight": 1,
          "id": "kiosk_qr_next"
        }
      ]
    },
    {
      "type": "text",
      "text": "Checksum @{if(user.qr_checksum == '', '—', user.qr_checksum)} · @{if(user.qr_transfer_id == '', 'no transfer yet', 'transfer ' + user.qr_transfer_id)}",
      "font_size": 11,
      "text_color": "#64748B",
      "font_family": "monospace"
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 2,
      "items": [
        {
          "type": "text",
          "text": "RECEIVE",
          "font_size": 11,
          "text_color": "#94A3B8",
          "font_weight": "bold"
        },
        {
          "type": "text",
          "text": "Take each chunk in order, then assemble and verify the checksum",
          "font_size": 11,
          "text_color": "#64748B"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "Add chunk",
          "background_color": "#047857",
          "text_color": "#D1FAE5",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.kiosk_notice",
              "value": {
                "type": "string",
                "value": "Chunk @{toInteger(user.qr_index) + 1} added to the scanned set"
              }
            },
            {
              "type": "array_insert_value",
              "variable_name": "user.scanned_chunks",
              "value": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}"
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_status",
              "value": {
                "type": "string",
                "value": "SCANNED"
              }
            }
          ],
          "icon": "qr_code_scanner",
          "weight": 1,
          "id": "kiosk_scan_current"
        },
        {
          "type": "button",
          "text": "Clear scanned",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.scanned_chunks",
              "value": {
                "type": "array",
                "value": []
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_status",
              "value": {
                "type": "string",
                "value": "IDLE"
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_json",
              "value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_checksum_ok",
              "value": {
                "type": "boolean",
                "value": false
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_missing",
              "value": {
                "type": "array",
                "value": []
              }
            }
          ],
          "icon": "delete",
          "weight": 1,
          "id": "kiosk_clear_scanned"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "Assemble",
          "background_color": "#38BDF8",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.receipt_checksum_ok",
              "value": {
                "type": "boolean",
                "value": false
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_json",
              "value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_missing",
              "value": {
                "type": "array",
                "value": []
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_error",
              "value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "url": "tools://codec/json/assemble",
              "payload": {
                "chunks": "@{user.scanned_chunks}",
                "encoding": "base45",
                "output": {
                  "status": "user.receipt_status",
                  "json": "user.receipt_json",
                  "checksum_ok": "user.receipt_checksum_ok",
                  "missing": "user.receipt_missing",
                  "error": "user.receipt_error"
                }
              },
              "log_id": "kiosk_transfer_assemble"
            }
          ],
          "icon": "check",
          "weight": 1,
          "id": "kiosk_assemble_scanned"
        },
        {
          "type": "button",
          "text": "Corrupt chunk",
          "background_color": "#3F1D24",
          "text_color": "#FCA5A5",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "array_insert_value",
              "variable_name": "user.scanned_chunks",
              "value": "C1|corrupt|00|01|deadbeef|!!!"
            },
            {
              "type": "set_variable",
              "variable_name": "user.receipt_status",
              "value": {
                "type": "string",
                "value": "INJECTED_CORRUPT"
              }
            }
          ],
          "icon": "warning",
          "weight": 1,
          "id": "kiosk_corrupt_chunk"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 8,
          "items": [
            {
              "type": "text",
              "text": "Result",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{user.receipt_status}",
              "font_size": 14,
              "text_color": "#F8FAFC",
              "font_weight": "bold"
            }
          ]
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 8,
          "items": [
            {
              "type": "text",
              "text": "Checksum",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{if(user.receipt_checksum_ok, 'MATCH', 'NOT VERIFIED')}",
              "font_size": 13,
              "text_color": "@{if(user.receipt_checksum_ok, '#34D399', '#F87171')}",
              "font_weight": "bold"
            }
          ]
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 8,
          "items": [
            {
              "type": "text",
              "text": "Missing",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{if(len(user.receipt_missing) == 0, 'none', 'chunks ' + user.receipt_missing)}",
              "font_size": 13,
              "text_color": "#FBBF24"
            }
          ]
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 8,
          "items": [
            {
              "type": "text",
              "text": "Reason",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{if(user.receipt_error == '', 'none', user.receipt_error)}",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            }
          ]
        }
      ],
      "background_color": "#0F172A",
      "corner_radius": 14,
      "paddings": {
        "left": 14,
        "right": 14,
        "top": 12,
        "bottom": 12
      }
    },
    {
      "type": "text",
      "text": "Reconstructed payload",
      "font_size": 11,
      "text_color": "#94A3B8",
      "font_weight": "bold"
    },
    {
      "type": "text",
      "text": "@{if(user.receipt_json == '', 'Nothing assembled yet.', user.receipt_json)}",
      "font_size": 10,
      "text_color": "#94A3B8",
      "font_family": "monospace",
      "max_lines": 6
    },
    {
      "type": "text",
      "text": "@{if(user.engine_error == '', user.kiosk_notice, 'Error: ' + user.engine_error)}",
      "font_size": 12,
      "text_color": "@{if(user.engine_error == '', '#64748B', '#F87171')}"
    }
  ],
  "background_color": "#1E293B",
  "paddings": {
    "left": 14,
    "right": 14,
    "top": 16,
    "bottom": 20
  }
}

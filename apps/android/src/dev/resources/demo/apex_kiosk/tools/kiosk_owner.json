{
 "type": "container",
 "item_spacing": 16,
 "items": [
  {
   "type": "container",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "container",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "font_size": 24,
         "font_weight": "bold",
         "text": "Owner receipt",
         "text_color": "#F8FAFC"
        },
        {
         "type": "text",
         "font_size": 12,
         "text": "Apex Kiosk · build and hand over a receipt",
         "text_color": "#94A3B8"
        }
       ],
       "orientation": "vertical"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "text": "Order",
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "@{user.kiosk_order_label}",
       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "·",
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "font_size": 12,
       "text": "@{toInteger(user.kiosk_item_count)} in cart",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "·",
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 12,
       "font_weight": "bold",
       "text": "$@{user.kiosk_total}",
       "text_color": "#C4B5FD"
      },
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "paddings": {
        "left": 10,
        "right": 10,
        "top": 5,
        "bottom": 5
       },
       "text": "@{if(user.kiosk_status == 'draft', 'Draft', if(user.kiosk_status == 'submitted', 'Submitted', user.kiosk_status))}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal",
     "visibility": "@{if(user.kiosk_order_id != '', 'visible', 'gone')}"
    }
   ],
   "orientation": "vertical"
  },
  {
   "type": "text",
   "font_size": 13,
   "id": "kiosk_owner_empty",
   "text": "No receipt open — tap New receipt.",
   "text_color": "#475569",
   "visibility": "@{if(user.kiosk_order_id == '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_owner_error",
   "item_spacing": 8,
   "items": [
    {
     "type": "text",
     "font_size": 12,
     "max_lines": 3,
     "text": "@{user.engine_error}",
     "text_color": "#FCA5A5"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "visibility": "@{if(user.engine_error != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_owner_notice",
   "item_spacing": 8,
   "items": [
    {
     "type": "text",
     "font_size": 12,
     "max_lines": 3,
     "text": "@{user.kiosk_notice}",
     "text_color": "#F8FAFC"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "visibility": "@{if(user.kiosk_notice != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "item_spacing": 8,
   "items": [
    {
     "type": "button",
     "text": "New receipt",
     "font_size": 14,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Started a new owner receipt"
       },
       "payload": {}
      },
      {
       "url": "local-db://op/db.upsert",
       "payload": {
        "collection": "kiosk_orders",
        "data": {
         "direction": "OWNER_RECEIPT",
         "status": "draft",
         "terminal_id": "${terminalCode}",
         "created_at": "@{format_date(now(), 'yyyy-MM-dd HH:mm:ss')}"
        },
        "output": {
         "id": "user.kiosk_order_id",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_new_receipt"
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_order_label",
       "value": {
        "type": "string",
        "value": "@{user.kiosk_order_id}"
       },
       "payload": {}
      },
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "where": {
         "status": "submitted"
        },
        "limit": 20,
        "output": {
         "_json": "user.kiosk_orders_json",
         "_count": "user.kiosk_order_count"
        },
        "sort": "-created_at"
       },
       "log_id": "kiosk_list_orders"
      }
     ],
     "background_color": "#1B2740",
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     },
     "weight": 1,
     "icon": "add",
     "id": "kiosk_new_receipt"
    },
    {
     "type": "button",
     "text": "Reopen",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "actions": [
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "limit": 1,
        "output": {
         "id": "user.kiosk_order_id",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        },
        "single": true,
        "sort": "-created_at"
       },
       "log_id": "kiosk_reload_receipt"
      },
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "where": {
         "status": "submitted"
        },
        "limit": 20,
        "output": {
         "_json": "user.kiosk_orders_json",
         "_count": "user.kiosk_order_count"
        },
        "sort": "-created_at"
       },
       "log_id": "kiosk_list_orders"
      }
     ],
     "weight": 1,
     "icon": "refresh",
     "id": "kiosk_reload_receipt",
     "background_color": "#E2E8F0"
    }
   ],
   "orientation": "horizontal"
  },
  {
   "type": "container",
   "id": "kiosk_owner_add_section",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Add items",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{user.catalog_count} available",
       "text_color": "#64748B"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "json_list",
     "data_var": "user.catalog_json",
     "empty_text": "No products available yet.",
     "row_card": {
      "type": "container",
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      },
      "item_spacing": 0,
      "items": [
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 4,
          "items": [
           {
            "type": "text",
            "font_size": 15,
            "font_weight": "bold",
            "max_lines": 2,
            "text": "@{item.item_name}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "container",
            "item_spacing": 6,
            "items": [
             {
              "type": "text",
              "font_family": "monospace",
              "font_size": 11,
              "text": "@{item.sku}",
              "text_color": "#64748B"
             },
             {
              "type": "text",
              "font_size": 11,
              "text": "·",
              "text_color": "#64748B"
             },
             {
              "type": "text",
              "font_family": "monospace",
              "font_size": 13,
              "font_weight": "bold",
              "text": "$@{if(item.price_display == '', item.price, item.price_display)}",
              "text_color": "#34D399"
             },
             {
              "type": "text",
              "font_size": 11,
              "text": "·",
              "text_color": "#64748B"
             },
             {
              "type": "text",
              "font_size": 11,
              "text": "@{item.stock} in stock",
              "text_color": "#64748B"
             }
            ],
            "orientation": "horizontal"
           }
          ],
          "orientation": "vertical"
         },
         {
          "type": "button",
          "text": "Add",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "actions": [
           {
            "url": "local-db://op/db.append_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "parent_id": "@{user.kiosk_order_id}",
             "data": {
              "sku": "@{item.sku}",
              "item_name": "@{item.item_name}",
              "unit_price": "@{item.price}",
              "quantity": 1
             },
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
             }
            },
            "log_id": "kiosk_receipt_add"
           }
          ],
          "background_color": "#6D28D9",
          "visibility": "@{if(user.kiosk_order_id == '', 'gone', 'visible')}"
         }
        ],
        "orientation": "horizontal"
       }
      ],
      "orientation": "vertical",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      }
     }
    },
    {
     "type": "text",
     "font_size": 12,
     "id": "kiosk_owner_locked_hint",
     "text": "Locked — start a new receipt to edit.",
     "text_color": "#94A3B8",
     "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status != 'draft', 'visible', 'gone')}"
    }
   ],
   "orientation": "vertical",
   "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_owner_lines_section",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Receipt lines",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{user.kiosk_line_count} @{if(toInteger(user.kiosk_line_count) == 1, 'line', 'lines')}",
       "text_color": "#64748B"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "json_list",
     "data_var": "user.kiosk_lines_json",
     "empty_text": "No lines yet — add an item to start the receipt.",
     "row_card": {
      "type": "container",
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      },
      "item_spacing": 10,
      "items": [
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 3,
          "items": [
           {
            "type": "text",
            "font_size": 15,
            "font_weight": "bold",
            "max_lines": 2,
            "text": "@{item.item_name}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "text",
            "font_family": "monospace",
            "font_size": 11,
            "text": "@{item.sku} · $@{item.unit_price_display} each",
            "text_color": "#64748B"
           }
          ],
          "orientation": "vertical"
         },
         {
          "type": "text",
          "font_family": "monospace",
          "font_size": 16,
          "font_weight": "bold",
          "text": "$@{item.line_total}",
          "text_color": "#C4B5FD"
         }
        ],
        "orientation": "horizontal"
       },
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 6,
          "items": [
           {
            "type": "button",
            "text": "−",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 12,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) - 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_down"
             }
            ],
            "background_color": "#1B2740",
            "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
           },
           {
            "type": "text",
            "font_family": "monospace",
            "font_size": 15,
            "font_weight": "bold",
            "text": "@{item.quantity}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "button",
            "text": "+",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 12,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) + 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_up"
             }
            ],
            "background_color": "#1B2740",
            "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
           }
          ],
          "orientation": "horizontal"
         },
         {
          "type": "button",
          "text": "Remove",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#FCA5A5",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Removed @{item.item_name} — tap Undo last remove to restore"
            },
            "payload": {}
           },
           {
            "url": "local-db://op/db.remove_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "id": "@{item.id}",
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum",
              "sku": "user.kiosk_undo_sku",
              "item_name": "user.kiosk_undo_label",
              "quantity": "user.kiosk_undo_qty",
              "unit_price": "user.kiosk_undo_price"
             }
            },
            "log_id": "kiosk_receipt_remove"
           }
          ],
          "background_color": "#3F1D24",
          "visibility": "@{if(user.kiosk_status == 'draft', 'visible', 'gone')}"
         }
        ],
        "orientation": "horizontal"
       }
      ],
      "orientation": "vertical",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      }
     }
    },
    {
     "type": "button",
     "text": "Undo remove",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Restored @{user.kiosk_undo_label}"
       },
       "payload": {}
      },
      {
       "url": "local-db://op/db.append_child",
       "payload": {
        "collection": "kiosk_order_lines",
        "parent_id": "@{user.kiosk_order_id}",
        "data": {
         "sku": "@{user.kiosk_undo_sku}",
         "item_name": "@{user.kiosk_undo_label}",
         "unit_price": "@{user.kiosk_undo_price}",
         "quantity": "@{user.kiosk_undo_qty}"
        },
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_receipt_undo"
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_undo_sku",
       "value": {
        "type": "string",
        "value": ""
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_undo_label",
       "value": {
        "type": "string",
        "value": ""
       }
      }
     ],
     "icon": "undo",
     "background_color": "#E2E8F0",
     "visibility": "@{if(user.kiosk_undo_sku != '' && user.kiosk_status == 'draft', 'visible', 'gone')}",
     "id": "kiosk_undo_remove"
    }
   ],
   "orientation": "vertical",
   "visibility": "@{if(user.kiosk_order_id != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "border": {
    "corner_radius": 14,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   },
   "id": "kiosk_owner_totals_section",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 12,
       "text": "Items",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "@{user.kiosk_item_count}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 12,
       "text": "Subtotal",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 13,
       "font_weight": "bold",
       "text": "$@{user.kiosk_subtotal}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "separator"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 15,
       "font_weight": "bold",
       "text": "Total",
       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_family": "monospace",
       "font_size": 28,
       "font_weight": "bold",
       "text": "$@{user.kiosk_total}",
       "text_color": "#F8FAFC"
      }
     ],
     "orientation": "horizontal"
    }
   ],
   "orientation": "vertical",
   "paddings": {
    "left": 16,
    "right": 16,
    "top": 16,
    "bottom": 16
   },
   "visibility": "@{if(user.kiosk_order_id != '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_owner_orders_section",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Submitted customer orders",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{user.kiosk_order_count} @{if(toInteger(user.kiosk_order_count) == 1, 'order', 'orders')}",
       "text_color": "#64748B"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "json_list",
     "data_var": "user.kiosk_orders_json",
     "empty_text": "No submitted orders yet — tap Reopen to load them.",
     "row_card": {
      "type": "container",
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      },
      "item_spacing": 8,
      "items": [
       {
        "type": "container",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "item_spacing": 3,
          "items": [
           {
            "type": "text",
            "font_family": "monospace",
            "font_size": 14,
            "font_weight": "bold",
            "text": "Order @{item.id}",
            "text_color": "#F8FAFC"
           },
           {
            "type": "text",
            "font_size": 11,
            "text": "@{toInteger(item.item_count)} @{if(toInteger(item.item_count) == 1, 'item', 'items')} · @{if(item.status == 'draft', 'Draft', if(item.status == 'submitted', 'Submitted', item.status))}",
            "text_color": "#64748B"
           }
          ],
          "orientation": "vertical"
         },
         {
          "type": "text",
          "font_family": "monospace",
          "font_size": 15,
          "font_weight": "bold",
          "text": "$@{item.total_display}",
          "text_color": "#C4B5FD"
         },
         {
          "type": "button",
          "text": "Review",
          "font_size": 13,
          "font_weight": "normal",
          "text_color": "#334155",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Reviewing customer order @{item.order_label}"
            },
            "payload": {}
           },
           {
            "url": "local-db://op/db.query",
            "payload": {
             "collection": "kiosk_orders",
             "where": {
              "direction": "CUSTOMER_REQUEST"
             },
             "limit": 1,
             "output": {
              "id": "user.kiosk_order_id",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
             },
             "single": true,
             "sort": "-created_at"
            },
            "log_id": "kiosk_review_order"
           }
          ],
          "background_color": "#E2E8F0"
         }
        ],
        "orientation": "horizontal"
       }
      ],
      "orientation": "vertical",
      "paddings": {
       "left": 12,
       "right": 12,
       "top": 12,
       "bottom": 12
      }
     }
    }
   ],
   "orientation": "vertical",
   "visibility": "@{if(toInteger(user.kiosk_order_count) > 0, 'visible', 'gone')}"
  },
  {
   "type": "text",
   "font_size": 11,
   "id": "kiosk_owner_close_section",
   "text": "Closing saves the receipt and locks it.",
   "text_color": "#FBBF24",
   "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
  },
  {
   "type": "button",
   "text": "Close receipt",
   "font_size": 14,
   "font_weight": "bold",
   "text_color": "#F8FAFC",
   "corner_radius": 12,
   "actions": [
    {
     "type": "set_variable",
     "variable_name": "user.kiosk_confirm",
     "value": {
      "type": "string",
      "value": "close"
     }
    }
   ],
   "background_color": "#1B2740",
   "border": {
    "corner_radius": 12,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   },
   "id": "kiosk_close_receipt_ask",
   "visibility": "@{if(user.kiosk_order_id != '' && user.kiosk_status == 'draft' && user.kiosk_confirm == '', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "item_spacing": 10,
   "items": [
    {
     "type": "button",
     "text": "Confirm close",
     "font_size": 14,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Receipt closed and saved"
       },
       "payload": {}
      },
      {
       "url": "local-db://op/db.commit",
       "payload": {
        "collection": "kiosk_orders",
        "id": "@{user.kiosk_order_id}",
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_close_receipt"
      }
     ],
     "background_color": "#B91C1C",
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     },
     "id": "kiosk_close_receipt",
     "weight": 1,
     "visibility": "@{if(user.kiosk_confirm == 'close' && user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
    },
    {
     "type": "button",
     "text": "Cancel",
     "font_size": 14,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "background_color": "#E2E8F0",
     "id": "kiosk_close_cancel",
     "weight": 1,
     "visibility": "@{if(user.kiosk_confirm == 'close', 'visible', 'gone')}",
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_confirm",
       "value": {
        "type": "string",
        "value": ""
       }
      }
     ]
    }
   ],
   "orientation": "horizontal",
   "visibility": "@{if(user.kiosk_confirm == 'close' && user.kiosk_order_id != '' && user.kiosk_status == 'draft', 'visible', 'gone')}"
  },
  {
   "type": "container",
   "id": "kiosk_owner_qr_section",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Receipt QR",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 11,
       "text": "@{if(user.qr_count == 0, 'not generated', 'chunk ' + (toInteger(user.qr_index) + 1) + ' of ' + user.qr_count)}",
       "text_color": "#64748B"
      }
     ],
     "orientation": "horizontal"
    },
    {
     "type": "container",
     "item_spacing": 12,
     "items": [
      {
       "type": "image",
       "height": {
        "type": "fixed",
        "value": 240
       },
       "image_url": "@{user.qr_img_current}"
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 12,
      "right": 12,
      "top": 12,
      "bottom": 12
     },
     "visibility": "@{if(user.qr_img_current == '', 'gone', 'visible')}"
    },
    {
     "type": "text",
     "font_size": 12,
     "id": "kiosk_receipt_qr_empty",
     "text": "No QR yet — tap Generate QR.",
     "text_color": "#64748B",
     "visibility": "@{if(user.qr_img_current == '', 'visible', 'gone')}"
    },
    {
     "type": "container",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Generate QR",
       "font_size": 14,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": 0
         },
         "payload": {}
        },
        {
         "url": "local-db://op/doc.pack",
         "payload": {
          "collection": "kiosk_orders",
          "id": "@{user.kiosk_order_id}",
          "output": {
           "id": "user.kiosk_order_label",
           "status": "user.kiosk_status",
           "direction": "user.kiosk_direction",
           "total_display": "user.kiosk_total",
           "subtotal_display": "user.kiosk_subtotal",
           "item_count": "user.kiosk_item_count",
           "line_count": "user.kiosk_line_count",
           "lines_json": "user.kiosk_lines_json",
           "payload_json": "user.kiosk_payload_json",
           "checksum": "user.kiosk_checksum"
          }
         },
         "log_id": "kiosk_export_receipt"
        },
        {
         "url": "tools://codec/json/chunk",
         "payload": {
          "json": "@{user.kiosk_payload_json}",
          "max_bytes": 700,
          "encoding": "base45",
          "output": {
           "chunks": "user.qr_chunks",
           "count": "user.qr_count",
           "transfer_id": "user.qr_transfer_id",
           "checksum": "user.qr_checksum"
          }
         },
         "log_id": "kiosk_receipt_chunk"
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, 0, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_receipt_qr"
        }
       ],
       "background_color": "#1B2740",
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#24304A",
         "width": 1
        }
       },
       "weight": 1,
       "id": "kiosk_generate_receipt_qr"
      },
      {
       "type": "button",
       "text": "Next chunk",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": "@{min(toInteger(user.qr_count) - 1, toInteger(user.qr_index) + 1)}"
         },
         "payload": {}
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_receipt_qr_next"
        }
       ],
       "weight": 1,
       "id": "kiosk_receipt_next_chunk",
       "background_color": "#E2E8F0"
      }
     ],
     "orientation": "horizontal"
    }
   ],
   "orientation": "vertical",
   "visibility": "@{if(user.kiosk_order_id != '', 'visible', 'gone')}"
  }
 ],
 "orientation": "vertical"
}

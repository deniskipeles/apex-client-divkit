{
 "type": "container",
 "orientation": "vertical",
 "item_spacing": 16,
 "items": [
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "container",
       "orientation": "vertical",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "text": "Owner receipt",
         "font_size": 24,
         "text_color": "#F8FAFC",
         "font_weight": "bold"
        },
        {
         "type": "text",
         "text": "Apex Kiosk · build and hand over a receipt",
         "font_size": 12,
         "text_color": "#94A3B8"
        }
       ],
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{user.kiosk_status}",
       "font_size": 11,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "background_color": "#1B2740",
       "corner_radius": 20,
       "paddings": {
        "left": 10,
        "right": 10,
        "top": 5,
        "bottom": 5
       }
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Order",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "@{user.kiosk_order_label}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      },
      {
       "type": "text",
       "text": "·",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "@{user.kiosk_item_count} items",
       "font_size": 12,
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "text": "·",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "$@{user.kiosk_total}",
       "font_size": 12,
       "text_color": "#C4B5FD",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#3F1D24",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.engine_error}",
     "font_size": 12,
     "text_color": "#FCA5A5",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.engine_error != '', 'visible', 'gone')}",
   "id": "kiosk_owner_error"
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#1B2740",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.kiosk_notice}",
     "font_size": 12,
     "text_color": "#F8FAFC",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.kiosk_notice != '', 'visible', 'gone')}",
   "id": "kiosk_owner_notice"
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "items": [
    {
     "type": "button",
     "text": "New receipt",
     "font_size": 14,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Started a new owner receipt"
       }
      },
      {
       "url": "local-db://op/db.upsert",
       "payload": {
        "collection": "kiosk_orders",
        "data": {
         "direction": "OWNER_RECEIPT",
         "status": "draft",
         "terminal_id": "${terminalCode}",
         "created_at": "@{format_date(now(), 'yyyy-MM-dd HH:mm:ss')}"
        },
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_new_receipt"
      },
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "where": {
         "status": "SUBMITTED"
        },
        "limit": 20,
        "output": {
         "orders_json": "user.kiosk_orders_json",
         "order_count": "user.kiosk_order_count"
        }
       },
       "log_id": "kiosk_list_orders"
      }
     ],
     "background_color": "#1B2740",
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     },
     "weight": 1,
     "icon": "add",
     "id": "kiosk_new_receipt"
    },
    {
     "type": "button",
     "text": "Reopen",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#94A3B8",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Reloaded the latest receipt from SQLite"
       }
      },
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "where": {
         "direction": "OWNER_RECEIPT"
        },
        "limit": 1,
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_reload_receipt"
      },
      {
       "url": "local-db://op/db.query",
       "payload": {
        "collection": "kiosk_orders",
        "where": {
         "status": "SUBMITTED"
        },
        "limit": 20,
        "output": {
         "orders_json": "user.kiosk_orders_json",
         "order_count": "user.kiosk_order_count"
        }
       },
       "log_id": "kiosk_list_orders"
      }
     ],
     "weight": 1,
     "icon": "refresh",
     "id": "kiosk_reload_receipt"
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Add items",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{user.catalog_count} available",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "json_list",
     "data_var": "user.catalog_json",
     "empty_text": "No products available yet.",
     "row_card": {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 0,
      "items": [
       {
        "type": "container",
        "orientation": "horizontal",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "orientation": "vertical",
          "item_spacing": 4,
          "items": [
           {
            "type": "text",
            "text": "@{item.item_name}",
            "font_size": 15,
            "text_color": "#F8FAFC",
            "font_weight": "bold",
            "max_lines": 2
           },
           {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 6,
            "items": [
             {
              "type": "text",
              "text": "@{item.sku}",
              "font_size": 11,
              "text_color": "#64748B",
              "font_family": "monospace"
             },
             {
              "type": "text",
              "text": "·",
              "font_size": 11,
              "text_color": "#64748B"
             },
             {
              "type": "text",
              "text": "$@{if(item.price_display == '', item.price, item.price_display)}",
              "font_size": 13,
              "text_color": "#34D399",
              "font_weight": "bold",
              "font_family": "monospace"
             },
             {
              "type": "text",
              "text": "·",
              "font_size": 11,
              "text_color": "#64748B"
             },
             {
              "type": "text",
              "text": "@{item.stock} in stock",
              "font_size": 11,
              "text_color": "#64748B"
             }
            ]
           }
          ],
          "weight": 1
         },
         {
          "type": "button",
          "text": "Add",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "actions": [
           {
            "url": "local-db://op/db.append_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "parent_id": "@{user.kiosk_order_id}",
             "data": {
              "sku": "@{item.sku}",
              "item_name": "@{item.item_name}",
              "unit_price": "@{item.price}",
              "quantity": 1
             },
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
             }
            },
            "log_id": "kiosk_receipt_add"
           }
          ],
          "background_color": "#6D28D9"
         }
        ]
       }
      ],
      "background_color": "#131C2E",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      },
      "corner_radius": 12,
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      }
     }
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Receipt lines",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{user.kiosk_line_count} lines",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "json_list",
     "data_var": "user.kiosk_lines_json",
     "empty_text": "No lines yet — add an item to start the receipt.",
     "row_card": {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 10,
      "items": [
       {
        "type": "container",
        "orientation": "horizontal",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "orientation": "vertical",
          "item_spacing": 3,
          "items": [
           {
            "type": "text",
            "text": "@{item.item_name}",
            "font_size": 15,
            "text_color": "#F8FAFC",
            "font_weight": "bold",
            "max_lines": 2
           },
           {
            "type": "text",
            "text": "@{item.sku} · $@{item.unit_price} each",
            "font_size": 11,
            "text_color": "#64748B",
            "font_family": "monospace"
           }
          ],
          "weight": 1
         },
         {
          "type": "text",
          "text": "$@{item.line_total}",
          "font_size": 16,
          "text_color": "#C4B5FD",
          "font_weight": "bold",
          "font_family": "monospace"
         }
        ]
       },
       {
        "type": "container",
        "orientation": "horizontal",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 6,
          "items": [
           {
            "type": "button",
            "text": "−",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 12,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) - 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_down"
             }
            ],
            "background_color": "#1B2740"
           },
           {
            "type": "text",
            "text": "@{item.quantity}",
            "font_size": 15,
            "text_color": "#F8FAFC",
            "font_weight": "bold",
            "font_family": "monospace"
           },
           {
            "type": "button",
            "text": "+",
            "font_size": 16,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "corner_radius": 12,
            "actions": [
             {
              "url": "local-db://op/db.set_child_qty",
              "payload": {
               "collection": "kiosk_order_lines",
               "id": "@{item.id}",
               "quantity": "@{toInteger(item.quantity) + 1}",
               "output": {
                "id": "user.kiosk_order_label",
                "status": "user.kiosk_status",
                "direction": "user.kiosk_direction",
                "total_display": "user.kiosk_total",
                "subtotal_display": "user.kiosk_subtotal",
                "item_count": "user.kiosk_item_count",
                "line_count": "user.kiosk_line_count",
                "lines_json": "user.kiosk_lines_json",
                "payload_json": "user.kiosk_payload_json",
                "checksum": "user.kiosk_checksum"
               }
              },
              "log_id": "kiosk_qty_up"
             }
            ],
            "background_color": "#1B2740"
           }
          ]
         },
         {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 0,
          "items": [],
          "weight": 1
         },
         {
          "type": "button",
          "text": "Remove",
          "font_size": 13,
          "font_weight": "bold",
          "text_color": "#FCA5A5",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Removed @{item.item_name} — tap Undo last remove to restore"
            }
           },
           {
            "url": "local-db://op/db.remove_child",
            "payload": {
             "collection": "kiosk_order_lines",
             "id": "@{item.id}",
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum",
              "sku": "user.kiosk_undo_sku",
              "item_name": "user.kiosk_undo_label",
              "quantity": "user.kiosk_undo_qty",
              "unit_price": "user.kiosk_undo_price"
             }
            },
            "log_id": "kiosk_receipt_remove"
           }
          ],
          "background_color": "#3F1D24"
         }
        ]
       }
      ],
      "background_color": "#131C2E",
      "paddings": {
       "left": 14,
       "right": 14,
       "top": 14,
       "bottom": 14
      },
      "corner_radius": 12,
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      }
     }
    },
    {
     "type": "button",
     "text": "Undo last remove",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#94A3B8",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.kiosk_notice",
       "value": {
        "type": "string",
        "value": "Restored @{user.kiosk_undo_label}"
       }
      },
      {
       "url": "local-db://op/db.append_child",
       "payload": {
        "collection": "kiosk_order_lines",
        "parent_id": "@{user.kiosk_order_id}",
        "data": {
         "sku": "@{user.kiosk_undo_sku}",
         "item_name": "@{user.kiosk_undo_label}",
         "unit_price": "@{user.kiosk_undo_price}",
         "quantity": "@{user.kiosk_undo_qty}"
        },
        "output": {
         "id": "user.kiosk_order_label",
         "status": "user.kiosk_status",
         "direction": "user.kiosk_direction",
         "total_display": "user.kiosk_total",
         "subtotal_display": "user.kiosk_subtotal",
         "item_count": "user.kiosk_item_count",
         "line_count": "user.kiosk_line_count",
         "lines_json": "user.kiosk_lines_json",
         "payload_json": "user.kiosk_payload_json",
         "checksum": "user.kiosk_checksum"
        }
       },
       "log_id": "kiosk_receipt_undo"
      }
     ],
     "icon": "undo"
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Items",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{user.kiosk_item_count}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Subtotal",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "$@{user.kiosk_subtotal}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "separator"
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Total",
       "font_size": 15,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "weight": 1
      },
      {
       "type": "text",
       "text": "$@{user.kiosk_total}",
       "font_size": 28,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    }
   ],
   "background_color": "#131C2E",
   "paddings": {
    "left": 16,
    "right": 16,
    "top": 16,
    "bottom": 16
   },
   "corner_radius": 14,
   "border": {
    "corner_radius": 14,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   }
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Submitted customer orders",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{user.kiosk_order_count} orders",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "json_list",
     "data_var": "user.kiosk_orders_json",
     "empty_text": "No submitted orders yet — tap Reopen to load them.",
     "row_card": {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 8,
      "items": [
       {
        "type": "container",
        "orientation": "horizontal",
        "item_spacing": 8,
        "items": [
         {
          "type": "container",
          "orientation": "vertical",
          "item_spacing": 3,
          "items": [
           {
            "type": "text",
            "text": "@{item.order_label}",
            "font_size": 14,
            "text_color": "#F8FAFC",
            "font_weight": "bold",
            "font_family": "monospace"
           },
           {
            "type": "text",
            "text": "@{item.item_count} items · @{item.status}",
            "font_size": 11,
            "text_color": "#64748B"
           }
          ],
          "weight": 1
         },
         {
          "type": "text",
          "text": "$@{item.total_display}",
          "font_size": 15,
          "text_color": "#C4B5FD",
          "font_weight": "bold",
          "font_family": "monospace"
         },
         {
          "type": "button",
          "text": "Review",
          "font_size": 13,
          "font_weight": "normal",
          "text_color": "#94A3B8",
          "corner_radius": 12,
          "actions": [
           {
            "type": "set_variable",
            "variable_name": "user.kiosk_notice",
            "value": {
             "type": "string",
             "value": "Reviewing customer order @{item.order_label}"
            }
           },
           {
            "url": "local-db://op/db.query",
            "payload": {
             "collection": "kiosk_orders",
             "where": {
              "direction": "CUSTOMER_REQUEST"
             },
             "limit": 1,
             "output": {
              "id": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
             }
            },
            "log_id": "kiosk_review_order"
           }
          ]
         }
        ]
       }
      ],
      "background_color": "#131C2E",
      "paddings": {
       "left": 12,
       "right": 12,
       "top": 12,
       "bottom": 12
      },
      "corner_radius": 12,
      "border": {
       "corner_radius": 12,
       "stroke": {
        "color": "#24304A",
        "width": 1
       }
      }
     }
    }
   ]
  },
  {
   "type": "button",
   "text": "Close receipt",
   "font_size": 14,
   "font_weight": "bold",
   "text_color": "#F8FAFC",
   "corner_radius": 12,
   "actions": [
    {
     "type": "set_variable",
     "variable_name": "user.kiosk_notice",
     "value": {
      "type": "string",
      "value": "Receipt closed and saved"
     }
    },
    {
     "url": "local-db://op/db.commit",
     "payload": {
      "collection": "kiosk_orders",
      "id": "@{user.kiosk_order_id}",
      "output": {
       "id": "user.kiosk_order_label",
       "status": "user.kiosk_status",
       "direction": "user.kiosk_direction",
       "total_display": "user.kiosk_total",
       "subtotal_display": "user.kiosk_subtotal",
       "item_count": "user.kiosk_item_count",
       "line_count": "user.kiosk_line_count",
       "lines_json": "user.kiosk_lines_json",
       "payload_json": "user.kiosk_payload_json",
       "checksum": "user.kiosk_checksum"
      }
     },
     "log_id": "kiosk_close_receipt"
    }
   ],
   "background_color": "#1B2740",
   "border": {
    "corner_radius": 12,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   },
   "id": "kiosk_close_receipt"
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Receipt QR",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{if(user.qr_count == 0, 'not generated', 'chunk ' + (toInteger(user.qr_index) + 1) + ' of ' + user.qr_count)}",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "container",
     "orientation": "vertical",
     "item_spacing": 12,
     "items": [
      {
       "type": "image",
       "image_url": "@{user.qr_img_current}",
       "height": {
        "type": "fixed",
        "value": 240
       },
       "content_description": "Receipt transfer QR chunk"
      }
     ],
     "background_color": "#FFFFFF",
     "paddings": {
      "left": 12,
      "right": 12,
      "top": 12,
      "bottom": 12
     },
     "corner_radius": 12
    },
    {
     "type": "text",
     "text": "No QR yet — tap Generate QR.",
     "font_size": 12,
     "text_color": "#64748B",
     "id": "kiosk_receipt_qr_empty",
     "visibility": "@{if(user.qr_img_current == '', 'visible', 'gone')}"
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Generate QR",
       "font_size": 14,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": 0
         }
        },
        {
         "url": "local-db://op/doc.pack",
         "payload": {
          "collection": "kiosk_orders",
          "id": "@{user.kiosk_order_id}",
          "output": {
           "id": "user.kiosk_order_label",
           "status": "user.kiosk_status",
           "direction": "user.kiosk_direction",
           "total_display": "user.kiosk_total",
           "subtotal_display": "user.kiosk_subtotal",
           "item_count": "user.kiosk_item_count",
           "line_count": "user.kiosk_line_count",
           "lines_json": "user.kiosk_lines_json",
           "payload_json": "user.kiosk_payload_json",
           "checksum": "user.kiosk_checksum"
          }
         },
         "log_id": "kiosk_export_receipt"
        },
        {
         "url": "tools://codec/json/chunk",
         "payload": {
          "json": "@{user.kiosk_payload_json}",
          "max_bytes": 700,
          "encoding": "base45",
          "output": {
           "chunks": "user.qr_chunks",
           "count": "user.qr_count",
           "transfer_id": "user.qr_transfer_id",
           "checksum": "user.qr_checksum"
          }
         },
         "log_id": "kiosk_receipt_chunk"
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, 0, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_receipt_qr"
        }
       ],
       "background_color": "#1B2740",
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#24304A",
         "width": 1
        }
       },
       "weight": 1,
       "id": "kiosk_generate_receipt_qr"
      },
      {
       "type": "button",
       "text": "Next chunk",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#94A3B8",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": "@{min(toInteger(user.qr_count) - 1, toInteger(user.qr_index) + 1)}"
         }
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_receipt_qr_next"
        }
       ],
       "weight": 1,
       "id": "kiosk_receipt_next_chunk"
      }
     ]
    }
   ]
  }
 ]
}

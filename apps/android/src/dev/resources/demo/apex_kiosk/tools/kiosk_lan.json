{
  "type": "container",
  "orientation": "vertical",
  "item_spacing": 12,
  "items": [
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 3,
      "items": [
        {
          "type": "text",
          "text": "LAN share",
          "font_size": 22,
          "text_color": "#F8FAFC",
          "font_weight": "bold"
        },
        {
          "type": "text",
          "text": "Serve the order payload to other devices on this network",
          "font_size": 12,
          "text_color": "#94A3B8"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "text",
          "text": "@{if(user.net_status == 'NOT_RUNNING' || user.net_status == 'IDLE', 'STOPPED', user.net_status)}",
          "font_size": 11,
          "text_color": "#F8FAFC",
          "font_weight": "bold",
          "background_color": "#0F172A",
          "corner_radius": 20,
          "paddings": {
            "left": 10,
            "right": 10,
            "top": 5,
            "bottom": 5
          }
        },
        {
          "type": "text",
          "text": "@{if(toInteger(user.net_hub_port) == 0, 'hub stopped', 'port ' + user.net_hub_port)}",
          "font_size": 12,
          "text_color": "#94A3B8",
          "font_family": "monospace",
          "weight": 1
        }
      ]
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 4,
      "items": [
        {
          "type": "text",
          "text": "Hub URL",
          "font_size": 12,
          "text_color": "#94A3B8"
        },
        {
          "type": "text",
          "text": "@{if(user.net_lan_url == '', 'Not running', user.net_lan_url)}",
          "font_size": 14,
          "text_color": "#38BDF8",
          "font_weight": "bold",
          "font_family": "monospace"
        },
        {
          "type": "text",
          "text": "Share id @{if(user.net_share_id == '', '—', user.net_share_id)}",
          "font_size": 11,
          "text_color": "#64748B",
          "font_family": "monospace"
        }
      ],
      "background_color": "#0F172A",
      "corner_radius": 14,
      "paddings": {
        "left": 14,
        "right": 14,
        "top": 12,
        "bottom": 12
      }
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "Start hub",
          "background_color": "#047857",
          "text_color": "#D1FAE5",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.net_status",
              "value": {
                "type": "string",
                "value": "STARTING"
              }
            },
            {
              "url": "tools://net/serve",
              "payload": {
                "port": 8089,
                "label": "Apex Kiosk",
                "output": {
                  "status": "user.net_status",
                  "lan_url": "user.net_lan_url",
                  "port": "user.net_hub_port",
                  "hub_id": "user.net_hub_id",
                  "share_count": "user.net_share_count"
                }
              },
              "log_id": "kiosk_lan_start"
            }
          ],
          "icon": "play_arrow",
          "weight": 1,
          "id": "kiosk_lan_start"
        },
        {
          "type": "button",
          "text": "Stop hub",
          "background_color": "#3F1D24",
          "text_color": "#FCA5A5",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "url": "tools://net/stop",
              "payload": {
                "output": {
                  "status": "user.net_status"
                }
              },
              "log_id": "kiosk_lan_stop"
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_lan_url",
              "value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_hub_port",
              "value": {
                "type": "integer",
                "value": 0
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_share_id",
              "value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_share_count",
              "value": {
                "type": "integer",
                "value": 0
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_response",
              "value": {
                "type": "string",
                "value": ""
              }
            }
          ],
          "icon": "stop",
          "weight": 1,
          "id": "kiosk_lan_stop"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "Share order",
          "background_color": "#7C3AED",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.kiosk_notice",
              "value": {
                "type": "string",
                "value": "Shared the live order payload"
              }
            },
            {
              "url": "local-db://op/doc.pack",
              "payload": {
                "collection": "kiosk_orders",
                "id": "@{user.kiosk_order_id}",
                "output": {
                  "id": "user.kiosk_order_label",
                  "status": "user.kiosk_status",
                  "direction": "user.kiosk_direction",
                  "total_display": "user.kiosk_total",
                  "subtotal_display": "user.kiosk_subtotal",
                  "item_count": "user.kiosk_item_count",
                  "line_count": "user.kiosk_line_count",
                  "lines_json": "user.kiosk_lines_json",
                  "payload_json": "user.kiosk_payload_json",
                  "checksum": "user.kiosk_checksum"
                }
              },
              "log_id": "kiosk_lan_export"
            },
            {
              "url": "tools://net/share",
              "payload": {
                "name": "order-@{user.kiosk_order_label}.json",
                "payload": "@{user.kiosk_payload_json}",
                "content_type": "application/json",
                "output": {
                  "status": "user.net_status",
                  "id": "user.net_share_id",
                  "path": "user.net_share_path",
                  "bytes": "user.net_share_bytes"
                }
              },
              "log_id": "kiosk_lan_share"
            }
          ],
          "icon": "share",
          "weight": 1,
          "id": "kiosk_lan_share"
        },
        {
          "type": "button",
          "text": "Unshare",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "url": "tools://net/unshare",
              "payload": {
                "id": "@{user.net_share_id}",
                "output": {
                  "status": "user.net_status",
                  "remaining": "user.net_share_count"
                }
              },
              "log_id": "kiosk_lan_unshare"
            },
            {
              "type": "set_variable",
              "variable_name": "user.net_share_id",
              "value": {
                "type": "string",
                "value": ""
              }
            }
          ],
          "icon": "delete",
          "weight": 1,
          "id": "kiosk_lan_unshare"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "Refresh list",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "url": "tools://net/list",
              "payload": {
                "output": {
                  "count": "user.net_share_count",
                  "status": "user.net_status"
                }
              },
              "log_id": "kiosk_lan_list"
            }
          ],
          "icon": "refresh",
          "weight": 1,
          "id": "kiosk_lan_list"
        },
        {
          "type": "button",
          "text": "Fetch /list",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "url": "tools://net/request",
              "payload": {
                "url": "@{user.net_lan_url}/list",
                "method": "GET",
                "timeout_ms": 4000,
                "output": {
                  "status": "user.net_status",
                  "body": "user.net_response"
                }
              },
              "log_id": "kiosk_lan_fetch"
            }
          ],
          "icon": "download",
          "weight": 1,
          "id": "kiosk_lan_fetch"
        }
      ]
    },
    {
      "type": "text",
      "text": "Shared items: @{user.net_share_count} · last share @{user.net_share_bytes} bytes",
      "font_size": 11,
      "text_color": "#94A3B8",
      "font_family": "monospace"
    },
    {
      "type": "text",
      "text": "Hub response @{if(user.net_response == '', '—', user.net_response)}",
      "font_size": 10,
      "text_color": "#94A3B8",
      "font_family": "monospace",
      "max_lines": 4
    },
    {
      "type": "text",
      "text": "@{if(user.engine_error == '', user.kiosk_notice, 'Error: ' + user.engine_error)}",
      "font_size": 12,
      "text_color": "@{if(user.engine_error == '', '#64748B', '#F87171')}"
    }
  ],
  "background_color": "#1E293B",
  "paddings": {
    "left": 14,
    "right": 14,
    "top": 16,
    "bottom": 20
  }
}

   {
    "name": "user.net_share_path",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.net_share_bytes",
    "type": "integer",
    "value": 0
   },
   {
    "name": "user.net_share_count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "user.net_response",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.kiosk_confirm",
    "type": "string",
    "value": ""
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "item_spacing": 14,
     "items": [
      {
       "type": "container",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "font_size": 26,
         "font_weight": "bold",
         "text": "APEX KIOSK",
         "text_color": "#F8FAFC"
        },
        {
         "type": "text",
         "font_size": 13,
         "text": "Customer orders, owner receipts, QR transfer and LAN share",
         "text_color": "#94A3B8"
        }
       ],
       "orientation": "vertical"
      },
      {
       "type": "container",
       "border": {
        "stroke": {
         "color": "#334155",
         "width": 1
        },
        "corner_radius": 14
       },
       "item_spacing": 10,
       "items": [
        {
         "type": "container",
         "item_spacing": 2,
         "items": [
          {
           "type": "text",
           "font_size": 10,
           "font_weight": "bold",
           "text": "ORDER",
           "text_color": "#94A3B8"
          },
          {
           "type": "text",
           "font_family": "monospace",
           "font_size": 18,
           "font_weight": "bold",
           "text": "@{user.kiosk_order_label}",
           "text_color": "#F8FAFC"
          }
         ],
         "orientation": "vertical"
        },
        {
         "type": "container",
         "item_spacing": 2,
         "items": [
          {
           "type": "text",
           "font_size": 10,
           "font_weight": "bold",
           "text": "ITEMS",
           "text_color": "#94A3B8"
          },
          {
           "type": "text",
           "font_size": 18,
           "font_weight": "bold",
           "text": "@{toInteger(user.kiosk_item_count)}",
           "text_color": "#F8FAFC"
          }
         ],
         "orientation": "vertical"
        },
        {
         "type": "container",
         "item_spacing": 2,
         "items": [
          {
           "type": "text",
           "font_size": 10,
           "font_weight": "bold",
           "text": "TOTAL",
           "text_color": "#94A3B8"
          },
          {
           "type": "text",
           "font_size": 18,
           "font_weight": "bold",
           "text": "$@{user.kiosk_total}",
           "text_color": "#F8FAFC"
          }
         ],
         "orientation": "vertical"
        }
       ],
       "orientation": "horizontal",
       "paddings": {
        "left": 14,
        "right": 14,
        "top": 12,
        "bottom": 12
       },
       "visibility": "@{if(user.kiosk_order_id == '', 'gone', 'visible')}"
      },
      {
       "type": "text",
       "font_size": 12,
       "text": "@{if(user.kiosk_status == 'submitted', 'Submitted — locked for editing', 'Draft — not submitted yet')}",
       "text_color": "#475569",
       "visibility": "@{if(user.kiosk_order_id == '', 'gone', 'visible')}"
      },
      {
       "type": "text",
       "font_size": 12,
       "text": "No orders yet — pick Customer order to begin.",
       "text_color": "#475569",
       "visibility": "@{if(user.kiosk_order_id == '', 'visible', 'gone')}"
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 16,
      "right": 16,
      "top": 18,
      "bottom": 20
     }
    }
   }
  ]
 }
}

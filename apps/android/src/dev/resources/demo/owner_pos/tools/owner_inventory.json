{
  "type": "container",
  "background": [
    {
      "type": "solid",
      "color": "#F7F8FB"
    }
  ],
  "height": {
    "type": "match_parent"
  },
  "items": [
    {
      "id": "global_toast",
      "type": "toast",
      "visibility": "@{owner.toast_visible ? 'visible' : 'gone'}",
      "custom_props": {
        "text": "@{owner.toast_msg}",
        "severity_var": "owner.toast_severity",
        "action_label_var": "owner.toast_action",
        "dwell_ms": 4000,
        "actions": [
          {
            "log_id": "inv_toast_dismiss_owner_toast_visible",
            "type": "set_variable",
            "variable_name": "owner.toast_visible",
            "value": {
              "type": "boolean",
              "value": false
            }
          }
        ]
      }
    },
    {
      "type": "container",
      "height": {
        "type": "match_parent",
        "weight": 1
      },
      "items": [
        {
          "type": "gallery",
          "height": {
            "type": "match_parent"
          },
          "items": [
            {
              "type": "text",
              "font_size": 32,
              "font_weight": "bold",
              "line_height": 40,
              "text": "Inventory",
              "text_color": "#111319"
            },
            {
              "type": "container",
              "items": [
                {
                  "type": "container",
                  "items": [
                    {
                      "type": "container",
                      "alignment_vertical": "center",
                      "background": [
                        {
                          "type": "solid",
                          "color": "#FFFFFF"
                        }
                      ],
                      "border": {
                        "corner_radius": 12,
                        "stroke": {
                          "color": "#E6E8EF",
                          "width": 1
                        }
                      },
                      "height": {
                        "type": "fixed",
                        "value": 52
                      },
                      "items": [
                        {
                          "type": "input",
                          "focus": {
                            "on_blur": [
                              {
                                "log_id": "search_inv",
                                "url": "local-db://op/db.query",
                                "payload": {
                                  "table": "inventory",
                                  "filter": {
                                    "$or": [
                                      {
                                        "name": {
                                          "$contains": "@{owner.inv_query}"
                                        }
                                      },
                                      {
                                        "sku": {
                                          "$contains": "@{owner.inv_query}"
                                        }
                                      },
                                      {
                                        "barcode": {
                                          "$contains": "@{owner.inv_query}"
                                        }
                                      },
                                      {
                                        "code": {
                                          "$contains": "@{owner.inv_query}"
                                        }
                                      }
                                    ]
                                  },
                                  "order_by": "name",
                                  "limit": 100,
                                  "json_list_var": "owner.inv_items",
                                  "output": {
                                    "_count": "owner.inv_count"
                                  }
                                }
                              }
                            ]
                          },
                          "font_size": 16,
                          "hint_color": "#5B6070",
                          "hint_text": "Search name, SKU, or code",
                          "id": "inv_search",
                          "keyboard_type": "single_line_text",
                          "max_visible_lines": 1,
                          "text_color": "#111319",
                          "text_variable": "owner.inv_query",
                          "width": {
                            "type": "match_parent",
                            "weight": 1
                          }
                        },
                        {
                          "type": "container",
                          "actions": [
                            {
                              "log_id": "search_inv",
                              "url": "local-db://op/db.query",
                              "payload": {
                                "table": "inventory",
                                "filter": {
                                  "$or": [
                                    {
                                      "name": {
                                        "$contains": "@{owner.inv_query}"
                                      }
                                    },
                                    {
                                      "sku": {
                                        "$contains": "@{owner.inv_query}"
                                      }
                                    },
                                    {
                                      "barcode": {
                                        "$contains": "@{owner.inv_query}"
                                      }
                                    },
                                    {
                                      "code": {
                                        "$contains": "@{owner.inv_query}"
                                      }
                                    }
                                  ]
                                },
                                "order_by": "name",
                                "limit": 100,
                                "json_list_var": "owner.inv_items",
                                "output": {
                                  "_count": "owner.inv_count"
                                }
                              }
                            }
                          ],
                          "content_alignment_horizontal": "center",
                          "content_alignment_vertical": "center",
                          "height": {
                            "type": "fixed",
                            "value": 48
                          },
                          "items": [
                            {
                              "type": "text",
                              "font_size": 14,
                              "font_weight": "medium",
                              "text": "Search",
                              "text_color": "#5A3BE0"
                            }
                          ],
                          "paddings": {
                            "left": 10,
                            "right": 10
                          }
                        }
                      ],
                      "margins": {
                        "top": 6
                      },
                      "orientation": "horizontal",
                      "paddings": {
                        "left": 14,
                        "right": 14,
                        "top": 8,
                        "bottom": 8
                      },
                      "width": {
                        "type": "match_parent"
                      }
                    }
                  ],
                  "margins": {
                    "bottom": 24
                  },
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  }
                }
              ],
              "margins": {
                "top": 16,
                "bottom": 12
              },
              "width": {
                "type": "match_parent"
              }
            },
            {
              "type": "container",
              "content_alignment_horizontal": "center",
              "items": [
                {
                  "type": "text",
                  "font_size": 22,
                  "font_weight": "bold",
                  "line_height": 28,
                  "text": "No products yet",
                  "text_color": "#111319"
                },
                {
                  "type": "text",
                  "font_size": 16,
                  "margins": {
                    "top": 8,
                    "bottom": 20
                  },
                  "text": "Add the first one to start scanning",
                  "text_alignment_horizontal": "center",
                  "text_color": "#5B6070"
                },
                {
                  "type": "container",
                  "actions": [
                    {
                      "log_id": "empty_add_prod_product_id",
                      "type": "set_variable",
                      "variable_name": "product.id",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_name",
                      "type": "set_variable",
                      "variable_name": "product.name",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_sku",
                      "type": "set_variable",
                      "variable_name": "product.sku",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_price",
                      "type": "set_variable",
                      "variable_name": "product.price",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_stock",
                      "type": "set_variable",
                      "variable_name": "product.stock",
                      "value": {
                        "type": "integer",
                        "value": "0"
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_code",
                      "type": "set_variable",
                      "variable_name": "product.code",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_photo_url",
                      "type": "set_variable",
                      "variable_name": "product.photo_url",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_description",
                      "type": "set_variable",
                      "variable_name": "product.description",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_product_is_edit",
                      "type": "set_variable",
                      "variable_name": "product.is_edit",
                      "value": {
                        "type": "boolean",
                        "value": false
                      }
                    },
                    {
                      "log_id": "empty_add_prod_reset_product_errors_json",
                      "type": "set_variable",
                      "variable_name": "product.errors_json",
                      "value": {
                        "type": "string",
                        "value": ""
                      }
                    },
                    {
                      "log_id": "empty_add_prod_reset_product_dirty",
                      "type": "set_variable",
                      "variable_name": "product.dirty",
                      "value": {
                        "type": "boolean",
                        "value": false
                      }
                    },
                    {
                      "log_id": "empty_add_prod_reset_product_valid",
                      "type": "set_variable",
                      "variable_name": "product.valid",
                      "value": {
                        "type": "boolean",
                        "value": true
                      }
                    },
                    {
                      "log_id": "open_product_modal",
                      "url": "nav://push?id=product_modal"
                    }
                  ],
                  "background": [
                    {
                      "type": "solid",
                      "color": "#F1EDFF"
                    }
                  ],
                  "border": {
                    "corner_radius": 12
                  },
                  "content_alignment_horizontal": "center",
                  "content_alignment_vertical": "center",
                  "height": {
                    "type": "fixed",
                    "value": 48
                  },
                  "items": [
                    {
                      "type": "text",
                      "font_size": 16,
                      "font_weight": "bold",
                      "text": "Add product",
                      "text_color": "#5A3BE0"
                    }
                  ],
                  "paddings": {
                    "left": 20,
                    "right": 20
                  }
                }
              ],
              "orientation": "vertical",
              "paddings": {
                "top": 48,
                "bottom": 48,
                "left": 20,
                "right": 20
              },
              "visibility": "@{owner.inv_count == 0 ? 'visible' : 'gone'}",
              "width": {
                "type": "match_parent"
              }
            },
            {
              "type": "json_list",
              "data_var": "owner.inv_items",
              "empty_text": "",
              "item_spacing": 12,
              "row_card": {
                "type": "container",
                "actions": [
                  {
                    "log_id": "edit_prod_product_id",
                    "type": "set_variable",
                    "variable_name": "product.id",
                    "value": {
                      "type": "string",
                      "value": "@{item.id}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_name",
                    "type": "set_variable",
                    "variable_name": "product.name",
                    "value": {
                      "type": "string",
                      "value": "@{item.name}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_sku",
                    "type": "set_variable",
                    "variable_name": "product.sku",
                    "value": {
                      "type": "string",
                      "value": "@{item.sku}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_price",
                    "type": "set_variable",
                    "variable_name": "product.price",
                    "value": {
                      "type": "string",
                      "value": "@{item.price}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_stock",
                    "type": "set_variable",
                    "variable_name": "product.stock",
                    "value": {
                      "type": "string",
                      "value": "@{item.stock}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_code",
                    "type": "set_variable",
                    "variable_name": "product.code",
                    "value": {
                      "type": "string",
                      "value": "@{item.barcode != '' ? item.barcode : item.code}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_photo_url",
                    "type": "set_variable",
                    "variable_name": "product.photo_url",
                    "value": {
                      "type": "string",
                      "value": "@{item.photo_url}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_description",
                    "type": "set_variable",
                    "variable_name": "product.description",
                    "value": {
                      "type": "string",
                      "value": "@{item.description}"
                    }
                  },
                  {
                    "log_id": "edit_prod_product_is_edit",
                    "type": "set_variable",
                    "variable_name": "product.is_edit",
                    "value": {
                      "type": "boolean",
                      "value": true
                    }
                  },
                  {
                    "log_id": "edit_prod_reset_product_errors_json",
                    "type": "set_variable",
                    "variable_name": "product.errors_json",
                    "value": {
                      "type": "string",
                      "value": ""
                    }
                  },
                  {
                    "log_id": "edit_prod_reset_product_dirty",
                    "type": "set_variable",
                    "variable_name": "product.dirty",
                    "value": {
                      "type": "boolean",
                      "value": false
                    }
                  },
                  {
                    "log_id": "edit_prod_reset_product_valid",
                    "type": "set_variable",
                    "variable_name": "product.valid",
                    "value": {
                      "type": "boolean",
                      "value": true
                    }
                  },
                  {
                    "log_id": "open_product_modal",
                    "url": "nav://push?id=product_modal"
                  }
                ],
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 16
                },
                "height": {
                  "type": "fixed",
                  "value": 76
                },
                "items": [
                  {
                    "type": "image",
                    "border": {
                      "corner_radius": 12
                    },
                    "height": {
                      "type": "fixed",
                      "value": 48
                    },
                    "image_url": "@{item.photo_url}",
                    "margins": {
                      "right": 14
                    },
                    "placeholder_color": "#E6E8EF",
                    "width": {
                      "type": "fixed",
                      "value": 48
                    }
                  },
                  {
                    "type": "container",
                    "items": [
                      {
                        "type": "text",
                        "font_size": 16,
                        "font_weight": "regular",
                        "line_height": 22,
                        "text": "@{item.name}",
                        "text_color": "#111319"
                      },
                      {
                        "type": "text",
                        "font_size": 13,
                        "font_weight": "medium",
                        "line_height": 18,
                        "text": "@{item.sku}",
                        "text_color": "#5B6070"
                      },
                      {
                        "type": "container",
                        "alignment_vertical": "center",
                        "items": [
                          {
                            "type": "text",
                            "font_size": 13,
                            "font_weight": "medium",
                            "line_height": 18,
                            "text": "@{item.barcode != '' ? item.barcode : item.code}",
                            "text_color": "#5B6070"
                          },
                          {
                            "type": "container",
                            "actions": [
                              {
                                "log_id": "row_map_code",
                                "url": "sheet://present?card_id=owner_scan_sheet"
                              }
                            ],
                            "items": [
                              {
                                "type": "text",
                                "font_size": 13,
                                "font_weight": "medium",
                                "line_height": 18,
                                "text": "Map",
                                "text_color": "#5A3BE0"
                              }
                            ],
                            "paddings": {
                              "left": 8
                            },
                            "visibility": "@{item.barcode == '' && item.code == '' ? 'visible' : 'gone'}"
                          }
                        ],
                        "orientation": "horizontal"
                      }
                    ],
                    "orientation": "vertical",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  },
                  {
                    "type": "container",
                    "alignment_horizontal": "end",
                    "items": [
                      {
                        "type": "text",
                        "font_feature_settings": "tnum",
                        "font_size": 22,
                        "font_weight": "bold",
                        "line_height": 28,
                        "text": "@{'$' + item.price + (item.price * 1 == round(item.price * 1) ? '.00' : item.price * 10 == round(item.price * 10) ? '0' : '')}",
                        "text_color": "#111319"
                      },
                      {
                        "type": "container",
                        "background": [
                          {
                            "type": "solid",
                            "color": "#FEF3C7"
                          }
                        ],
                        "border": {
                          "corner_radius": 999
                        },
                        "items": [
                          {
                            "type": "text",
                            "font_size": 11,
                            "font_weight": "bold",
                            "text": "@{item.stock == 0 ? 'Out of stock' : item.stock + ' in stock'}",
                            "text_color": "#92400E"
                          }
                        ],
                        "paddings": {
                          "left": 8,
                          "right": 8,
                          "top": 2,
                          "bottom": 2
                        }
                      }
                    ],
                    "orientation": "vertical"
                  }
                ],
                "orientation": "horizontal",
                "paddings": {
                  "left": 16,
                  "right": 16,
                  "top": 10,
                  "bottom": 10
                },
                "width": {
                  "type": "match_parent"
                }
              }
            }
          ],
          "orientation": "vertical",
          "paddings": {
            "left": 20,
            "right": 20,
            "top": 16,
            "bottom": 88
          },
          "width": {
            "type": "match_parent"
          }
        },
        {
          "type": "fab",
          "custom_props": {
            "label": "Add product",
            "icon": "add",
            "actions": [
              {
                "log_id": "fab_add_prod_product_id",
                "type": "set_variable",
                "variable_name": "product.id",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_name",
                "type": "set_variable",
                "variable_name": "product.name",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_sku",
                "type": "set_variable",
                "variable_name": "product.sku",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_price",
                "type": "set_variable",
                "variable_name": "product.price",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_stock",
                "type": "set_variable",
                "variable_name": "product.stock",
                "value": {
                  "type": "integer",
                  "value": "0"
                }
              },
              {
                "log_id": "fab_add_prod_product_code",
                "type": "set_variable",
                "variable_name": "product.code",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_photo_url",
                "type": "set_variable",
                "variable_name": "product.photo_url",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_description",
                "type": "set_variable",
                "variable_name": "product.description",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_product_is_edit",
                "type": "set_variable",
                "variable_name": "product.is_edit",
                "value": {
                  "type": "boolean",
                  "value": false
                }
              },
              {
                "log_id": "fab_add_prod_reset_product_errors_json",
                "type": "set_variable",
                "variable_name": "product.errors_json",
                "value": {
                  "type": "string",
                  "value": ""
                }
              },
              {
                "log_id": "fab_add_prod_reset_product_dirty",
                "type": "set_variable",
                "variable_name": "product.dirty",
                "value": {
                  "type": "boolean",
                  "value": false
                }
              },
              {
                "log_id": "fab_add_prod_reset_product_valid",
                "type": "set_variable",
                "variable_name": "product.valid",
                "value": {
                  "type": "boolean",
                  "value": true
                }
              },
              {
                "log_id": "open_product_modal",
                "url": "nav://push?id=product_modal"
              }
            ]
          }
        }
      ],
      "orientation": "vertical",
      "width": {
        "type": "match_parent"
      }
    },
    {
      "type": "bottom_tabs",
      "custom_props": {
        "active_value": "@{owner.tab}",
        "items": [
          {
            "value": "pos",
            "label": "POS",
            "icon": "pos",
            "actions": [
              {
                "log_id": "tab_pos",
                "url": "nav://push?id=owner_pos"
              }
            ]
          },
          {
            "value": "inventory",
            "label": "Inventory",
            "icon": "inventory",
            "actions": [
              {
                "log_id": "tab_inventory",
                "url": "nav://push?id=owner_inventory"
              },
              {
                "log_id": "load_inventory",
                "url": "local-db://op/db.query",
                "payload": {
                  "table": "inventory",
                  "filter": {
                    "$or": [
                      {
                        "name": {
                          "$contains": "@{owner.inv_query}"
                        }
                      },
                      {
                        "sku": {
                          "$contains": "@{owner.inv_query}"
                        }
                      },
                      {
                        "barcode": {
                          "$contains": "@{owner.inv_query}"
                        }
                      },
                      {
                        "code": {
                          "$contains": "@{owner.inv_query}"
                        }
                      }
                    ]
                  },
                  "order_by": "name",
                  "limit": 100,
                  "json_list_var": "owner.inv_items",
                  "output": {
                    "_count": "owner.inv_count"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "orientation": "vertical",
  "width": {
    "type": "match_parent"
  }
}

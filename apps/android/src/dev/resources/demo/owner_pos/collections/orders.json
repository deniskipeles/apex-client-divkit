{
  "name": "orders",
  "schema": {
    "fields": {
      "status": {
        "type": "string",
        "options": [
          "draft",
          "submitted",
          "paid",
          "void"
        ],
        "uid": "orders_status"
      },
      "total": {
        "type": "number",
        "min": 0,
        "uid": "orders_total"
      },
      "item_count": {
        "type": "number",
        "min": 0,
        "uid": "orders_item_count"
      },
      "shop_name": {
        "type": "string",
        "uid": "orders_shop_name"
      },
      "shop_terminal": {
        "type": "string",
        "uid": "orders_shop_terminal"
      },
      "checksum": {
        "type": "string",
        "uid": "orders_checksum"
      },
      "payload_json": {
        "type": "string",
        "uid": "orders_payload_json"
      }
    },
    "aggregates": [
      {
        "target": "order_lines",
        "foreign_field": "order_id",
        "outputs": {
          "item_count": "count()",
          "total": "round2(sum(unit_price * quantity))"
        },
        "editable_status": [
          "draft"
        ]
      }
    ],
    "canonical": {
      "child": "order_lines",
      "child_foreign_field": "order_id",
      "child_fields": [
        "sku",
        "item_name",
        "unit_price",
        "quantity"
      ],
      "child_computed": {
        "line_total_display": "round2(unit_price * quantity)",
        "unit_price_display": "unit_price",
        "name_and_qty": "item_name"
      },
      "child_json_key": "lines_json",
      "child_count_key": "item_count",
      "fields": [
        "status",
        "total",
        "item_count",
        "shop_name",
        "shop_terminal",
        "checksum",
        "payload_json"
      ]
    }
  },
  "seed": [],
  "id": 2
}

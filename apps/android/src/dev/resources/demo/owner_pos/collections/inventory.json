        "unique": true,
        "uid": "inventory_sku"
      },
      "name": {
        "type": "string",
        "required": true,
        "max_length": 60,
        "uid": "inventory_name"
      },
      "price": {
        "type": "string",
        "required": true,
        "uid": "inventory_price"
      },
      "photo_url": {

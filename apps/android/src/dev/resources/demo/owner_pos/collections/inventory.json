      },
      "code": {
        "type": "string",
        "uid": "inventory_code"
      },
      "barcode": {
        "type": "string",
        "sql_indexed": true,
        "uid": "inventory_barcode"
      },
      "description": {
        "type": "string",
        "max_length": 240,
        "uid": "inventory_description"
      },
      "stock": {
        "type": "number",
        "min": 0,
        "uid": "inventory_stock"
      }
    }
  },

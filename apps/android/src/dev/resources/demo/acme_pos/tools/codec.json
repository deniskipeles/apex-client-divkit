{
  "type": "container",
  "orientation": "vertical",
  "background_color": "#071221",
  "corner_radius": 14,
  "paddings": {"left": 14, "right": 14, "top": 14, "bottom": 14},
  "item_spacing": 10,
  "items": [
    {
      "type": "text",
      "text": "🔐 GENERIC CODEC  —  tools://codec",
      "font_size": 15,
      "font_weight": "bold",
      "text_color": "#38BDF8"
    },
    {
      "type": "text",
      "text": "Base64, Base45, JSON validate/extract/stringify/chunk/assemble. Chunk envelopes are caller-sized and capped by max_chunks.",
      "font_size": 11,
      "text_color": "#94A3B8"
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 8,
      "items": [
        {
          "type": "button",
          "text": "Validate JSON",
          "background_color": "#0284C7",
          "text_color": "#F0F9FF",
          "corner_radius": 8,
          "actions": [
            {
              "log_id": "codec_validate",
              "url": "tools://codec/json/validate",
              "payload": {"json": "{\"order_id\":\"42\",\"lines\":[]}"}
            }
          ]
        },
        {
          "type": "button",
          "text": "Chunk JSON",
          "background_color": "#059669",
          "text_color": "#ECFDF5",
          "corner_radius": 8,
          "actions": [
            {
              "log_id": "codec_chunk",
              "url": "tools://codec/json/chunk",
              "payload": {"json": "{\"order_id\":\"42\",\"note\":\"hello\"}", "encoding": "base45", "max_bytes": 500, "max_chunks": 32}
            }
          ]
        }
      ]
    }
  ]
}

{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#1F2937",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#F59E0B",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "📳 HAPTIC TACTILE ENGINE (device.haptics@1 • tools://haptics)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#FCD34D"
        },
        {
            "type": "text",
            "text": "Each button drives the device vibrator with the pattern named on it and reports the pattern and duration that were actually applied.",
            "font_size": 11,
            "text_color": "#FDE68A"
        },
        {
            "type": "text",
            "text": "State: @{user.haptic_state} • Pattern: @{user.haptic_pattern} • Duration: @{user.haptic_duration} ms",
            "font_size": 12,
            "text_color": "#FEF3C7",
            "font_family": "monospace"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_click",
                    "text": "Click",
                    "icon": "haptics",
                    "background_color": "#374151",
                    "text_color": "#F9FAFB",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_click",
                        "url": "tools://haptics/click",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                },
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_heavy",
                    "text": "Heavy",
                    "icon": "haptics",
                    "background_color": "#D97706",
                    "text_color": "#FFFFFF",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_heavy",
                        "url": "tools://haptics/heavy",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                },
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_success",
                    "text": "Success",
                    "icon": "check",
                    "background_color": "#059669",
                    "text_color": "#FFFFFF",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_success",
                        "url": "tools://haptics/success",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_warning",
                    "text": "Warning",
                    "icon": "notification",
                    "background_color": "#B45309",
                    "text_color": "#FFFFFF",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_warning",
                        "url": "tools://haptics/warning",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                },
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_error",
                    "text": "Error Buzz",
                    "icon": "clear",
                    "background_color": "#DC2626",
                    "text_color": "#FFFFFF",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_error",
                        "url": "tools://haptics/error",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                },
                {
                    "type": "button",
                    "weight": 1.0,
                    "id": "haptic_tick",
                    "text": "Tick",
                    "icon": "haptics",
                    "background_color": "#4B5563",
                    "text_color": "#F9FAFB",
                    "corner_radius": 8,
                    "action": {
                        "log_id": "haptic_tick",
                        "url": "tools://haptics/tick",
                        "payload": {
                            "output": {
                                "status": "user.haptic_state",
                                "pattern": "user.haptic_pattern",
                                "duration_ms": "user.haptic_duration"
                            }
                        }
                    }
                }
            ]
        },
        {
            "type": "button",
            "id": "haptic_stop",
            "text": "Stop vibration",
            "subtitle": "tools://haptics/stop",
            "icon": "clear",
            "background_color": "#334155",
            "text_color": "#FFFFFF",
            "corner_radius": 8,
            "action": {
                "log_id": "haptic_stop",
                "url": "tools://haptics/stop",
                "payload": {
                    "output": {
                        "status": "user.haptic_state"
                    }
                }
            }
        }
    ]
}

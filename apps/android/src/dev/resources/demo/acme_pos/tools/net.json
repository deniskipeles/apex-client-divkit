{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#111C2E",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#60A5FA",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "🌐 NETWORK TRANSFER (Ktor) & LAN HUB (tools://net)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#93C5FD"
        },
        {
            "type": "text",
            "text": "Start the hub, share a file into it, then fetch the hub's own /health endpoint over loopback. Nothing here is simulated: a real Ktor CIO server is listening while you press these buttons.",
            "font_size": 11,
            "text_color": "#BFDBFE"
        },
        {
            "type": "text",
            "text": "Status: @{user.net_status} • Port: @{user.net_hub_port} • Shares: @{user.net_share_count}",
            "font_size": 12,
            "text_color": "#DBEAFE",
            "font_family": "monospace"
        },
        {
            "type": "text",
            "text": "HTTP: @{user.net_http_status} • Bytes: @{user.net_bytes}",
            "font_size": 12,
            "text_color": "#DBEAFE",
            "font_family": "monospace"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_net_serve",
                            "text": "1. Start LAN hub",
                            "subtitle": "tools://net/serve • port 8899",
                            "icon": "cloud",
                            "background_color": "#1D4ED8",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_net_serve",
                                "url": "tools://net/serve",
                                "payload": {
                                    "port": "8899",
                                    "label": "ApexClient Transfer Hub",
                                    "output": {
                                        "status": "user.net_status",
                                        "port": "user.net_hub_port"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_net_share",
                            "text": "2. Share a file",
                            "subtitle": "tools://net/share",
                            "icon": "receipt",
                            "background_color": "#1E40AF",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_net_share",
                                "url": "tools://net/share",
                                "payload": {
                                    "name": "receipt-1042.txt",
                                    "content_type": "text/plain",
                                    "content_base64": "T3JkZXIgIzEwNDIgLSB0b3RhbCAxOC41MA==",
                                    "output": {
                                        "status": "user.net_status",
                                        "bytes": "user.net_bytes"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_net_get",
                            "text": "3. HTTP GET /health",
                            "subtitle": "tools://net/get • loopback",
                            "icon": "sync",
                            "background_color": "#2563EB",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_net_get",
                                "url": "tools://net/get",
                                "payload": {
                                    "url": "http://127.0.0.1:8899/health",
                                    "timeout_ms": "10000",
                                    "output": {
                                        "status": "user.net_status",
                                        "http_status": "user.net_http_status",
                                        "bytes": "user.net_bytes"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_net_list",
                            "text": "4. List shares",
                            "subtitle": "tools://net/list",
                            "icon": "search",
                            "background_color": "#1E3A8A",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_net_list",
                                "url": "tools://net/list",
                                "payload": {
                                    "output": {
                                        "status": "user.net_status",
                                        "count": "user.net_share_count"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "button",
            "id": "tool_net_stop",
            "text": "5. Stop LAN hub",
            "subtitle": "tools://net/stop",
            "icon": "clear",
            "background_color": "#334155",
            "text_color": "#FFFFFF",
            "corner_radius": 10,
            "action": {
                "log_id": "exec_tool_net_stop",
                "url": "tools://net/stop",
                "payload": {
                    "output": {
                        "status": "user.net_status"
                    }
                }
            }
        }
    ]
}

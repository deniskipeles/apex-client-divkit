{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#1A1200",
    "corner_radius": 14,
    "paddings": {
        "left": 14,
        "right": 14,
        "top": 12,
        "bottom": 12
    },
    "border": {
        "corner_radius": 14,
        "stroke": {
            "color": "#F59E0B",
            "width": 2
        }
    },
    "items": [
        {
            "type": "text",
            "text": "🔳 CODE GENERATOR — ZXing QR & 1D Barcodes (tools://code-generate)",
            "font_size": 12,
            "font_weight": "bold",
            "text_color": "#FCD34D",
            "margins": {
                "bottom": 4
            }
        },
        {
            "type": "text",
            "text": "Generates scannable PNGs saved to the tenant media sandbox. Generated codes can be scanned immediately with the Scanner card.",
            "font_size": 11,
            "text_color": "#FEF3C7",
            "margins": {
                "bottom": 10
            }
        },
        {
            "type": "container",
            "orientation": "vertical",
            "background_color": "#0D0900",
            "corner_radius": 8,
            "paddings": {
                "left": 10,
                "right": 10,
                "top": 8,
                "bottom": 8
            },
            "margins": {
                "bottom": 10
            },
            "items": [
                {
                    "type": "text",
                    "text": "Format: @{user.code_format}",
                    "font_size": 11,
                    "text_color": "#FDE68A",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "Kind:   @{user.code_kind}",
                    "font_size": 11,
                    "text_color": "#FDE68A",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "Content: @{user.code_content}",
                    "font_size": 11,
                    "text_color": "#FDE68A",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "Code id: @{user.code_id}",
                    "font_size": 11,
                    "text_color": "#FDE68A",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "Image: @{if(user.code_image_uri == '', 'not generated yet — tap Generate', user.code_image_uri)}",
                    "font_size": 10,
                    "text_color": "#FDE68A",
                    "font_family": "monospace"
                }
            ]
        },
        {
            "type": "container",
            "orientation": "vertical",
            "background_color": "#FAFAFA",
            "corner_radius": 10,
            "paddings": {
                "left": 6,
                "right": 6,
                "top": 6,
                "bottom": 6
            },
            "margins": {
                "bottom": 10
            },
            "items": [
                {
                    "type": "image",
                    "image_url": "@{user.code_image_uri}",
                    "preview_height": 240,
                    "corner_radius": 10,
                    "content_description": "Generated code image"
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "margins": {
                "bottom": 8
            },
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_code-generate_generate",
                            "text": "Generate Order QR",
                            "subtitle": "tools://code-generate/generate (QR_CODE)",
                            "icon": "qr_code",
                            "background_color": "#D97706",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_code-generate_generate",
                                "url": "tools://code-generate/generate",
                                "payload": {
                                    "operation": "generate",
                                    "options": {
                                        "content": "apexpos://order/pickup?terminal=${terminalCode}",
                                        "format": "qr",
                                        "width": "512",
                                        "ec_level": "M",
                                        "encoding": "uri"
                                    },
                                    "output": {
                                        "uri": "user.code_image_uri",
                                        "format": "user.code_format",
                                        "kind": "user.code_kind",
                                        "content": "user.code_content",
                                        "code_id": "user.code_id"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_code-generate_barcode",
                            "text": "Generate SKU Barcode",
                            "subtitle": "tools://code-generate/barcode (EAN_13)",
                            "icon": "barcode",
                            "background_color": "#B45309",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_code-generate_barcode",
                                "url": "tools://code-generate/barcode",
                                "payload": {
                                    "operation": "barcode",
                                    "options": {
                                        "content": "9780201633610",
                                        "format": "EAN_13",
                                        "width": "400",
                                        "height": "160"
                                    },
                                    "output": {
                                        "uri": "user.code_image_uri",
                                        "format": "user.code_format",
                                        "kind": "user.code_kind",
                                        "content": "user.code_content",
                                        "code_id": "user.code_id"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "margins": {
                "bottom": 12
            },
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_code-generate_table_qr",
                            "text": "Generate Table QR",
                            "subtitle": "APEX://table/T12 • ec_level H",
                            "icon": "qr_code",
                            "background_color": "#92400E",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_code-generate_table_qr",
                                "url": "tools://code-generate/generate",
                                "payload": {
                                    "operation": "generate",
                                    "options": {
                                        "content": "APEX://table/T12?guests=4&server=Maria",
                                        "format": "qr",
                                        "width": "512",
                                        "ec_level": "H"
                                    },
                                    "output": {
                                        "uri": "user.code_image_uri",
                                        "format": "user.code_format",
                                        "kind": "user.code_kind",
                                        "content": "user.code_content",
                                        "code_id": "user.code_id"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_code-generate_receipt_barcode",
                            "text": "Receipt Barcode",
                            "subtitle": "CODE_128 • 600×180",
                            "icon": "barcode",
                            "background_color": "#78350F",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_code-generate_receipt_barcode",
                                "url": "tools://code-generate/barcode",
                                "payload": {
                                    "operation": "barcode",
                                    "options": {
                                        "content": "REC-20261122-${terminalCode}",
                                        "format": "CODE_128",
                                        "width": "600",
                                        "height": "180"
                                    },
                                    "output": {
                                        "uri": "user.code_image_uri",
                                        "format": "user.code_format",
                                        "kind": "user.code_kind",
                                        "content": "user.code_content",
                                        "code_id": "user.code_id"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "orientation": "vertical",
            "background_color": "#002020",
            "corner_radius": 8,
            "paddings": {
                "left": 10,
                "right": 10,
                "top": 8,
                "bottom": 8
            },
            "items": [
                {
                    "type": "text",
                    "text": "▶  SCAN YOUR GENERATED CODE",
                    "font_size": 11,
                    "font_weight": "bold",
                    "text_color": "#22D3EE"
                },
                {
                    "type": "text",
                    "text": "Switch to Scanner card and point the camera at the code above",
                    "font_size": 11,
                    "text_color": "#67E8F9"
                }
            ]
        }
    ]
}

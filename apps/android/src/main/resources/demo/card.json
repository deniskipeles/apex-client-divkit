                  "left": 12,
                  "right": 12,
                  "top": 10,
                  "bottom": 10
                },
                "border": {
                  "corner_radius": 10,
                  "stroke": {
                    "color": "#334155",
                    "width": 1
                  }
                },
                "items": [
                  {
                    "type": "container",
                    "orientation": "vertical",
                    "weight": 1.0,
                    "item_spacing": 2,
                    "items": [
                      {
                        "type": "text",
                        "text": "#@{item.id} • @{item.item_name}",
                        "font_size": 14,
                        "font_weight": "bold",
                        "text_color": "#F8FAFC"
                      },
                      {
                        "type": "text",
                        "text": "SKU: @{item.sku} • $@{item.price} x @{item.qty} • @{item.status}",
                        "font_size": 12,
                        "text_color": "#94A3B8",
                        "font_family": "monospace"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "weight": 0.42,
                    "text": "Void #@{item.id}",
                    "icon": "delete",
                    "background_color": "#3F1D24",
                    "text_color": "#FCA5A5",
                    "corner_radius": 8,
                    "actions": [
                      {
                        "log_id": "delete_order_row",
                        "url": "local-db://op/db.delete",
                        "payload": {
                          "table": "orders",
                          "where": [
                            {
                              "column": "id",
                              "op": "=",
                              "value": "@{item.id}"
                            }
                          ],
                          "output": {
                            "count": "user.last_deleted_count"
                          }
                        }
                      },
                      {
                        "log_id": "refresh_orders_list",
                        "url": "local-db://op/db.query",
                        "payload": {
                          "table": "orders",
                          "order_by": "id",
                          "limit": 50,
                          "json_list_var": "user.orders_json",
                          "output": {
                            "_json": "user.orders_json"
                          }
                        }
                      },
                      {
                        "log_id": "count_orders",
                        "url": "local-db://op/db.count",
                        "payload": {
                          "table": "orders",
                          "output": {
                            "count": "user.order_count"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}

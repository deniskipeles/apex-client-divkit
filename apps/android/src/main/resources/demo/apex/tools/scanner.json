{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#0C1F14",
    "corner_radius": 12,
    "item_spacing": 10,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#10B981",
            "width": 2
        }
    },
    "items": [
        {
            "type": "container",
            "background_color": "#0C1F14",
            "corner_radius": 10,
            "paddings": {"left": 12, "right": 12, "top": 10, "bottom": 10},
            "border": {
                "corner_radius": 10,
                "stroke": {"color": "#10B981", "width": 1}
            },
            "items": [
                {
                    "type": "text",
                    "text": "📷 SCANNER — ML Kit + ZXing Live Camera (tools://scan)",
                    "font_size": 13,
                    "font_weight": "bold",
                    "text_color": "#10B981"
                },
                {
                    "type": "text",
                    "text": "Point the camera at a barcode or QR code, or decode an image file. Results appear below.",
                    "font_size": 11,
                    "text_color": "#6EE7B7",
                    "margins": {"top": 4}
                }
            ]
        },
        {
            "type": "container",
            "background_color": "#0A1A0F",
            "corner_radius": 10,
            "paddings": {"left": 12, "right": 12, "top": 10, "bottom": 10},
            "border": {
                "corner_radius": 10,
                "stroke": {"color": "#064E3B", "width": 1}
            },
            "item_spacing": 4,
            "items": [
                {
                    "type": "text",
                    "text": "CODE  @{user.scanned_code}",
                    "font_size": 14,
                    "font_weight": "bold",
                    "text_color": "#34D399",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "FORMAT  @{user.scanned_format}  •  TYPE  @{user.scanned_type}",
                    "font_size": 12,
                    "text_color": "#6EE7B7",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "STATUS  @{user.scan_status}",
                    "font_size": 11,
                    "text_color": "#A7F3D0",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "OCR  @{user.ocr_text}",
                    "font_size": 11,
                    "text_color": "#A7F3D0",
                    "font_family": "monospace"
                },
                {
                    "type": "text",
                    "text": "CONF  @{user.ocr_confidence}  •  BLOCKS  @{user.ocr_block_count}",
                    "font_size": 11,
                    "text_color": "#6EE7B7",
                    "font_family": "monospace"
                }
            ]
        },
        {
            "type": "image",
            "image_url": "@{user.scan_image_uri}",
            "preview_height": 180,
            "corner_radius": 10,
            "content_description": "Last scanned image"
        },
        {
            "type": "text",
            "text": "LIVE — opens viewfinder and decodes what you point at",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#A7F3D0"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_scan_live_barcode",
                            "text": "Barcode",
                        "font_size": 12,
                            "subtitle": "Camera",
                            "icon": "scanner",
                            "background_color": "#047857",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_scan_live_barcode",
                                "url": "tools://scan/scan",
                                "payload": {
                                    "operation": "scan",
                                    "options": {
                                        "target_format": "barcode",
                                        "camera": "true"
                                    },
                                    "output": {
                                        "raw_value": "user.scanned_code",
                                        "format": "user.scanned_format",
                                        "type": "user.scanned_type",
                                        "status": "user.scan_status"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_scan_live_qr",
                            "text": "QR code",
                        "font_size": 12,
                            "subtitle": "Camera",
                            "icon": "qr_code",
                            "background_color": "#0D9488",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_scan_live_qr",
                                "url": "tools://scan/scan",
                                "payload": {
                                    "operation": "scan",
                                    "options": {
                                        "target_format": "qr",
                                        "camera": "true"
                                    },
                                    "output": {
                                        "raw_value": "user.scanned_code",
                                        "format": "user.scanned_format",
                                        "type": "user.scanned_type",
                                        "status": "user.scan_status"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_scan_live_both",
                            "text": "Both",
                        "font_size": 12,
                            "subtitle": "Auto",
                            "icon": "scanner",
                            "background_color": "#065F46",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_scan_live_both",
                                "url": "tools://scan/scan",
                                "payload": {
                                    "operation": "scan",
                                    "options": {
                                        "target_format": "any",
                                        "camera": "true"
                                    },
                                    "output": {
                                        "raw_value": "user.scanned_code",
                                        "format": "user.scanned_format",
                                        "type": "user.scanned_type",
                                        "status": "user.scan_status"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "text": "OCR — ML Kit text recognition",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#A7F3D0"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_scan_ocr_camera",
                            "text": "Camera OCR",
                            "subtitle": "Live ML Kit text scan",
                            "icon": "search",
                            "background_color": "#0369A1",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_scan_ocr_camera",
                                "url": "tools://scan/ocr",
                                "payload": {
                                    "operation": "ocr",
                                    "options": {
                                        "camera": "true"
                                    },
                                    "output": {
                                        "text": "user.ocr_text",
                                        "confidence": "user.ocr_confidence",
                                        "block_count": "user.ocr_block_count",
                                        "source_image": "user.scan_image_uri"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_scan_ocr_photo",
                            "text": "Photo OCR",
                            "subtitle": "Pick from gallery",
                            "icon": "search",
                            "background_color": "#1D4ED8",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_scan_ocr_photo",
                                "url": "tools://scan/ocr",
                                "payload": {
                                    "operation": "ocr",
                                    "options": {
                                        "camera": "false"
                                    },
                                    "output": {
                                        "text": "user.ocr_text",
                                        "confidence": "user.ocr_confidence",
                                        "block_count": "user.ocr_block_count",
                                        "source_image": "user.scan_image_uri"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "background_color": "#071B10",
            "corner_radius": 10,
            "paddings": {"left": 12, "right": 12, "top": 10, "bottom": 10},
            "item_spacing": 8,
            "border": {
                "corner_radius": 10,
                "stroke": {"color": "#064E3B", "width": 1}
            },
            "items": [
                {
                    "type": "text",
                    "text": "DECODE FROM FILE (no camera needed)",
                    "font_size": 11,
                    "font_weight": "bold",
                    "text_color": "#6EE7B7"
                },
                {
                    "type": "container",
                    "orientation": "horizontal",
                    "item_spacing": 8,
                    "items": [
                        {
                            "type": "container",
                            "weight": 1.0,
                            "items": [
                                {
                                    "type": "button",
                                    "id": "tool_scan_scan",
                                    "text": "Sample barcode",
                        "font_size": 12,
                                    "subtitle": "EAN-13 file",
                                    "icon": "barcode",
                                    "background_color": "#064E3B",
                                    "text_color": "#FFFFFF",
                                    "corner_radius": 10,
                                    "action": {
                                        "log_id": "exec_tool_scan_scan",
                                        "url": "tools://scan/scan",
                                        "payload": {
                                            "operation": "scan",
                                            "options": {
                                                "target_format": "barcode",
                                                "uri": "${demoBarcodeUri}"
                                            },
                                            "output": {
                                                "raw_value": "user.scanned_code",
                                                "format": "user.scanned_format",
                                                "type": "user.scanned_type",
                                                "status": "user.scan_status"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "container",
                            "weight": 1.0,
                            "items": [
                                {
                                    "type": "button",
                                    "id": "tool_scan_scan_qr",
                                    "text": "Sample QR",
                        "font_size": 12,
                                    "subtitle": "QR file",
                                    "icon": "qr_code",
                                    "background_color": "#065F46",
                                    "text_color": "#FFFFFF",
                                    "corner_radius": 10,
                                    "action": {
                                        "log_id": "exec_tool_scan_scan_qr",
                                        "url": "tools://scan/scan",
                                        "payload": {
                                            "operation": "scan",
                                            "options": {
                                                "target_format": "qr",
                                                "uri": "${demoQrUri}"
                                            },
                                            "output": {
                                                "raw_value": "user.scanned_code",
                                                "format": "user.scanned_format",
                                                "type": "user.scanned_type",
                                                "status": "user.scan_status"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}

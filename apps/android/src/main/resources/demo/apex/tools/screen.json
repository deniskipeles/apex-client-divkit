{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#0F172A",
    "corner_radius": 12,
    "paddings": { "left": 12, "right": 12, "top": 10, "bottom": 10 },
    "border": { "corner_radius": 12, "stroke": { "color": "#22D3EE", "width": 1 } },
    "items": [
        {
            "type": "text",
            "text": "🖥 SCREEN / KEEP-AWAKE • SCREENSHOT • RECORDING (tools://screen)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#67E8F9"
        },
        {
            "type": "text",
            "text": "Status: @{user.screen_status} • Awake: @{user.screen_keep_awake} • Recording: @{user.screen_recording}\n@{user.screen_error}",
            "font_size": 12,
            "text_color": "#E0F2FE",
            "font_family": "monospace"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_screen_keep_awake",
                            "text": "Hold Screen Awake",
                            "subtitle": "tools://screen/keep-awake • 5 min",
                            "icon": "bell",
                            "background_color": "#0284C7",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_screen_keep_awake",
                                "url": "tools://screen/keep-awake",
                                "payload": { "options": { "action": "enable", "level": "screen", "timeout_ms": "300000" } }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_screen_release_awake",
                            "text": "Release Wake-Lock",
                            "subtitle": "tools://screen/keep-awake • disable",
                            "icon": "volume_off",
                            "background_color": "#075985",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_screen_release_awake",
                                "url": "tools://screen/keep-awake",
                                "payload": { "options": { "action": "disable" } }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_screen_screenshot",
                            "text": "Capture Screenshot",
                            "subtitle": "tools://screen/screenshot • PNG",
                            "icon": "camera",
                            "background_color": "#0E7490",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_screen_screenshot",
                                "url": "tools://screen/screenshot",
                                "payload": { "options": { "format": "png", "quality": "95" } }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_screen_record_start",
                            "text": "Start Recording",
                            "subtitle": "tools://screen/recording • start",
                            "icon": "scan",
                            "background_color": "#BE123C",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_screen_record_start",
                                "url": "tools://screen/recording",
                                "payload": { "options": { "action": "start" } }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_screen_record_stop",
                            "text": "Stop Recording",
                            "subtitle": "tools://screen/recording • stop",
                            "icon": "close",
                            "background_color": "#7F1D1D",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_screen_record_stop",
                                "url": "tools://screen/recording",
                                "payload": { "options": { "action": "stop" } }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "text",
                            "text": "Last file: @{user.screen_media_uri}",
                            "font_size": 10,
                            "text_color": "#A5F3FC",
                            "font_family": "monospace",
                            "max_lines": 2
                        }
                    ]
                }
            ]
        }
    ]
}

{
    "type": "custom",
    "custom_type": "sdui_chart",
    "id": "onfly_chart_bar_orders",
    "custom_props": {
        "chart_type": "bar",
        "title": "LIVE REVENUE BY SKU (${terminalCode})",
        "subtitle": "Live revenue per SKU from today's orders",

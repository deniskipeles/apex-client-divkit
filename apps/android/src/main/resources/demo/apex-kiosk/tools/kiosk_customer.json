{
  "type": "container",
  "orientation": "vertical",
  "item_spacing": 12,
  "items": [
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 10,
      "items": [
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 10,
          "items": [
            {
              "type": "container",
              "orientation": "vertical",
              "item_spacing": 3,
              "items": [
                {
                  "type": "text",
                  "text": "Customer order",
                  "font_size": 22,
                  "text_color": "#F8FAFC",
                  "font_weight": "bold"
                },
                {
                  "type": "text",
                  "text": "Tap a product to add it to the order",
                  "font_size": 12,
                  "text_color": "#94A3B8"
                }
              ],
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{user.kiosk_status}",
              "font_size": 11,
              "text_color": "#F8FAFC",
              "font_weight": "bold",
              "background_color": "#0F172A",
              "corner_radius": 20,
              "paddings": {
                "left": 10,
                "right": 10,
                "top": 5,
                "bottom": 5
              }
            }
          ]
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 6,
          "items": [
            {
              "type": "text",
              "text": "Order",
              "font_size": 12,
              "text_color": "#64748B"
            },
            {
              "type": "text",
              "text": "@{user.kiosk_order_label}",
              "font_size": 15,
              "text_color": "#F8FAFC",
              "font_weight": "bold",
              "font_family": "monospace"
            },
            {
              "type": "text",
              "text": "·",
              "font_size": 12,
              "text_color": "#64748B"
            },
            {
              "type": "text",
              "text": "@{user.kiosk_item_count} items",
              "font_size": 12,
              "text_color": "#94A3B8"
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 10,
      "items": [
        {
          "type": "button",
          "text": "New order",
          "background_color": "#7C3AED",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.kiosk_notice",
              "value": {
                "type": "string",
                "value": "Started a new customer order"
              }
            },
            {
              "url": "local-db://op/kiosk.create",
              "payload": {
                "direction": "CUSTOMER_REQUEST",
                "terminal_id": "${terminalCode}",
                "output": {
                  "order_id": "user.kiosk_order_id",
                  "order_label": "user.kiosk_order_label",
                  "status": "user.kiosk_status",
                  "direction": "user.kiosk_direction",
                  "total_display": "user.kiosk_total",
                  "subtotal_display": "user.kiosk_subtotal",
                  "item_count": "user.kiosk_item_count",
                  "line_count": "user.kiosk_line_count",
                  "lines_json": "user.kiosk_lines_json",
                  "payload_json": "user.kiosk_payload_json",
                  "checksum": "user.kiosk_checksum"
                }
              },
              "log_id": "kiosk_new_order"
            }
          ],
          "icon": "add",
          "weight": 1,
          "id": "kiosk_new_order"
        },
        {
          "type": "button",
          "text": "Undo remove",
          "background_color": "#334155",
          "text_color": "#F8FAFC",
          "corner_radius": 12,
          "font_size": 14,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.kiosk_notice",
              "value": {
                "type": "string",
                "value": "Restored @{user.kiosk_undo_label}"
              }
            },
            {
              "url": "local-db://op/kiosk.add_line",
              "payload": {
                "order_id": "@{user.kiosk_order_id}",
                "sku": "@{user.kiosk_undo_sku}",
                "item_name": "@{user.kiosk_undo_label}",
                "unit_price": "@{user.kiosk_undo_price}",
                "quantity": "@{user.kiosk_undo_qty}",
                "output": {
                  "order_id": "user.kiosk_order_id",
                  "order_label": "user.kiosk_order_label",
                  "status": "user.kiosk_status",
                  "direction": "user.kiosk_direction",
                  "total_display": "user.kiosk_total",
                  "subtotal_display": "user.kiosk_subtotal",
                  "item_count": "user.kiosk_item_count",
                  "line_count": "user.kiosk_line_count",
                  "lines_json": "user.kiosk_lines_json",
                  "payload_json": "user.kiosk_payload_json",
                  "checksum": "user.kiosk_checksum"
                }
              },
              "log_id": "kiosk_undo"
            }
          ],
          "icon": "undo",
          "weight": 1,
          "id": "kiosk_undo_remove"
        }
      ]
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 2,
      "items": [
        {
          "type": "text",
          "text": "CATALOG",
          "font_size": 11,
          "text_color": "#94A3B8",
          "font_weight": "bold"
        },
        {
          "type": "text",
          "text": "@{user.catalog_count} products in the inventory collection",
          "font_size": 11,
          "text_color": "#64748B"
        }
      ]
    },
    {
      "type": "json_list",
      "data_var": "user.catalog_json",
      "empty_text": "Catalog is empty — no inventory rows found.",
      "row_card": {
        "type": "container",
        "orientation": "vertical",
        "item_spacing": 4,
        "items": [
          {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 10,
            "items": [
              {
                "type": "container",
                "orientation": "vertical",
                "item_spacing": 2,
                "items": [
                  {
                    "type": "text",
                    "text": "@{item.item_name}",
                    "font_size": 15,
                    "text_color": "#F8FAFC",
                    "font_weight": "bold"
                  },
                  {
                    "type": "text",
                    "text": "@{item.sku} · $@{if(item.price_display == '', item.price, item.price_display)} · @{item.stock} in stock",
                    "font_size": 10,
                    "text_color": "#94A3B8",
                    "font_family": "monospace",
                    "max_lines": 1
                  }
                ],
                "weight": 1
              },
              {
                "type": "button",
                "text": "Add",
                "background_color": "#047857",
                "text_color": "#D1FAE5",
                "corner_radius": 12,
                "font_size": 13,
                "font_weight": "bold",
                "actions": [
                  {
                    "type": "set_variable",
                    "variable_name": "user.kiosk_notice",
                    "value": {
                      "type": "string",
                      "value": "Added @{item.item_name}"
                    }
                  },
                  {
                    "url": "local-db://op/kiosk.add_line",
                    "payload": {
                      "order_id": "@{user.kiosk_order_id}",
                      "sku": "@{item.sku}",
                      "item_name": "@{item.item_name}",
                      "unit_price": "@{item.price}",
                      "quantity": 1,
                      "output": {
                        "order_id": "user.kiosk_order_id",
                        "order_label": "user.kiosk_order_label",
                        "status": "user.kiosk_status",
                        "direction": "user.kiosk_direction",
                        "total_display": "user.kiosk_total",
                        "subtotal_display": "user.kiosk_subtotal",
                        "item_count": "user.kiosk_item_count",
                        "line_count": "user.kiosk_line_count",
                        "lines_json": "user.kiosk_lines_json",
                        "payload_json": "user.kiosk_payload_json",
                        "checksum": "user.kiosk_checksum"
                      }
                    },
                    "log_id": "kiosk_add_line"
                  }
                ],
                "icon": "add"
              }
            ]
          }
        ],
        "background_color": "#0F172A",
        "corner_radius": 12,
        "paddings": {
          "left": 14,
          "right": 12,
          "top": 12,
          "bottom": 12
        }
      }
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 2,
      "items": [
        {
          "type": "text",
          "text": "ORDER",
          "font_size": 11,
          "text_color": "#94A3B8",
          "font_weight": "bold"
        },
        {
          "type": "text",
          "text": "Quantity, unit price and line total come from SQLite",
          "font_size": 11,
          "text_color": "#64748B"
        }
      ]
    },
    {
      "type": "json_list",
      "data_var": "user.kiosk_lines_json",
      "empty_text": "No items yet — tap Add on a product above.",
      "row_card": {
        "type": "container",
        "orientation": "vertical",
        "item_spacing": 6,
        "items": [
          {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
              {
                "type": "text",
                "text": "@{item.item_name}",
                "font_size": 14,
                "text_color": "#F8FAFC",
                "font_weight": "bold",
                "weight": 1
              },
              {
                "type": "button",
                "text": "Remove",
                "background_color": "#3F1D24",
                "text_color": "#FCA5A5",
                "corner_radius": 12,
                "font_size": 12,
                "font_weight": "bold",
                "actions": [
                  {
                    "type": "set_variable",
                    "variable_name": "user.kiosk_notice",
                    "value": {
                      "type": "string",
                      "value": "Removed @{item.item_name} — tap Undo to restore"
                    }
                  },
                  {
                    "url": "local-db://op/kiosk.remove_line",
                    "payload": {
                      "order_id": "@{user.kiosk_order_id}",
                      "line_id": "@{item.id}",
                      "output": {
                        "order_id": "user.kiosk_order_id",
                        "order_label": "user.kiosk_order_label",
                        "status": "user.kiosk_status",
                        "direction": "user.kiosk_direction",
                        "total_display": "user.kiosk_total",
                        "subtotal_display": "user.kiosk_subtotal",
                        "item_count": "user.kiosk_item_count",
                        "line_count": "user.kiosk_line_count",
                        "lines_json": "user.kiosk_lines_json",
                        "payload_json": "user.kiosk_payload_json",
                        "checksum": "user.kiosk_checksum",
                        "removed_sku": "user.kiosk_undo_sku",
                        "removed_name": "user.kiosk_undo_label",
                        "removed_quantity": "user.kiosk_undo_qty",
                        "removed_unit_price_display": "user.kiosk_undo_price"
                      }
                    },
                    "log_id": "kiosk_remove_line"
                  }
                ],
                "visibility": "@{if(user.kiosk_status == 'SUBMITTED', 'gone', 'visible')}"
              }
            ]
          },
          {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
              {
                "type": "text",
                "text": "@{item.quantity} × $@{item.unit_price}",
                "font_size": 12,
                "text_color": "#94A3B8",
                "font_family": "monospace",
                "weight": 1
              },
              {
                "type": "text",
                "text": "Line $@{item.line_total}",
                "font_size": 13,
                "text_color": "#38BDF8",
                "font_weight": "bold",
                "font_family": "monospace"
              }
            ]
          },
          {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
              {
                "type": "button",
                "text": "−",
                "background_color": "#334155",
                "text_color": "#F8FAFC",
                "corner_radius": 12,
                "font_size": 16,
                "font_weight": "bold",
                "actions": [
                  {
                    "url": "local-db://op/kiosk.set_qty",
                    "payload": {
                      "order_id": "@{user.kiosk_order_id}",
                      "line_id": "@{item.id}",
                      "quantity": "@{toInteger(item.quantity) - 1}",
                      "output": {
                        "order_id": "user.kiosk_order_id",
                        "order_label": "user.kiosk_order_label",
                        "status": "user.kiosk_status",
                        "direction": "user.kiosk_direction",
                        "total_display": "user.kiosk_total",
                        "subtotal_display": "user.kiosk_subtotal",
                        "item_count": "user.kiosk_item_count",
                        "line_count": "user.kiosk_line_count",
                        "lines_json": "user.kiosk_lines_json",
                        "payload_json": "user.kiosk_payload_json",
                        "checksum": "user.kiosk_checksum"
                      }
                    },
                    "log_id": "kiosk_qty_down"
                  }
                ]
              },
              {
                "type": "button",
                "text": "+",
                "background_color": "#334155",
                "text_color": "#F8FAFC",
                "corner_radius": 12,
                "font_size": 16,
                "font_weight": "bold",
                "actions": [
                  {
                    "url": "local-db://op/kiosk.set_qty",
                    "payload": {
                      "order_id": "@{user.kiosk_order_id}",
                      "line_id": "@{item.id}",
                      "quantity": "@{toInteger(item.quantity) + 1}",
                      "output": {
                        "order_id": "user.kiosk_order_id",
                        "order_label": "user.kiosk_order_label",
                        "status": "user.kiosk_status",
                        "direction": "user.kiosk_direction",
                        "total_display": "user.kiosk_total",
                        "subtotal_display": "user.kiosk_subtotal",
                        "item_count": "user.kiosk_item_count",
                        "line_count": "user.kiosk_line_count",
                        "lines_json": "user.kiosk_lines_json",
                        "payload_json": "user.kiosk_payload_json",
                        "checksum": "user.kiosk_checksum"
                      }
                    },
                    "log_id": "kiosk_qty_up"
                  }
                ]
              },
              {
                "type": "text",
                "text": "qty @{item.quantity}",
                "font_size": 11,
                "text_color": "#64748B",
                "font_family": "monospace"
              }
            ],
            "visibility": "@{if(user.kiosk_status == 'SUBMITTED', 'gone', 'visible')}"
          }
        ],
        "background_color": "#0F172A",
        "corner_radius": 12,
        "paddings": {
          "left": 14,
          "right": 12,
          "top": 12,
          "bottom": 12
        }
      }
    },
    {
      "type": "container",
      "orientation": "vertical",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 6,
          "items": [
            {
              "type": "text",
              "text": "Items",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "@{user.kiosk_item_count}",
              "font_size": 13,
              "text_color": "#F8FAFC",
              "font_weight": "bold"
            }
          ]
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 6,
          "items": [
            {
              "type": "text",
              "text": "Subtotal",
              "font_size": 13,
              "text_color": "#94A3B8",
              "weight": 1
            },
            {
              "type": "text",
              "text": "$@{user.kiosk_subtotal}",
              "font_size": 13,
              "text_color": "#F8FAFC",
              "font_weight": "bold"
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "container",
          "orientation": "horizontal",
          "item_spacing": 8,
          "items": [
            {
              "type": "text",
              "text": "Total",
              "font_size": 17,
              "text_color": "#F8FAFC",
              "font_weight": "bold",
              "weight": 1
            },
            {
              "type": "text",
              "text": "$@{user.kiosk_total}",
              "font_size": 26,
              "text_color": "#F8FAFC",
              "font_weight": "bold"
            }
          ]
        }
      ],
      "background_color": "#0F172A",
      "corner_radius": 14,
      "paddings": {
        "left": 14,
        "right": 14,
        "top": 12,
        "bottom": 12
      }
    },
    {
      "type": "button",
      "text": "Submit order",
      "background_color": "#38BDF8",
      "text_color": "#FFFFFF",
      "corner_radius": 12,
      "font_size": 16,
      "font_weight": "bold",
      "actions": [
        {
          "url": "local-db://op/kiosk.submit",
          "payload": {
            "order_id": "@{user.kiosk_order_id}",
            "output": {
              "order_id": "user.kiosk_order_id",
              "order_label": "user.kiosk_order_label",
              "status": "user.kiosk_status",
              "direction": "user.kiosk_direction",
              "total_display": "user.kiosk_total",
              "subtotal_display": "user.kiosk_subtotal",
              "item_count": "user.kiosk_item_count",
              "line_count": "user.kiosk_line_count",
              "lines_json": "user.kiosk_lines_json",
              "payload_json": "user.kiosk_payload_json",
              "checksum": "user.kiosk_checksum"
            }
          },
          "log_id": "kiosk_submit"
        }
      ],
      "icon": "check",
      "visibility": "@{if(user.kiosk_status == 'SUBMITTED', 'gone', 'visible')}",
      "id": "kiosk_submit"
    },
    {
      "type": "text",
      "text": "@{if(user.kiosk_status == 'SUBMITTED', 'Submitted — this order is now read-only.', '')}",
      "font_size": 12,
      "text_color": "#34D399",
      "font_weight": "bold"
    },
    {
      "type": "text",
      "text": "@{if(user.engine_error == '', user.kiosk_notice, 'Error: ' + user.engine_error)}",
      "font_size": 12,
      "text_color": "@{if(user.engine_error == '', '#64748B', '#F87171')}"
    }
  ],
  "background_color": "#1E293B",
  "paddings": {
    "left": 14,
    "right": 14,
    "top": 16,
    "bottom": 20
  }
}

          "font_size": 12,
          "font_weight": "bold",
          "actions": [
            {
              "log_id": "assemble_chunks",
              "url": "tools://codec/json/assemble",
              "payload": {
                "chunks": "@{user.scanned_chunks}",
                "encoding": "base45",
                "output": {
                  "json": "user.receipt_json",
                  "status": "user.receipt_status",
                  "missing": "user.receipt_missing",
                  "checksum_ok": "user.receipt_checksum_ok"
                }
              }
            },
            {
              "log_id": "validate_receipt",
              "url": "tools://codec/json/validate",
              "payload": {
                "json": "@{user.receipt_json}",
                "output": {
                  "valid": "user.receipt_valid",
                  "error": "user.receipt_error"
                }
              }
            },
            {
              "log_id": "extract_receipt",
              "url": "tools://codec/json/extract",
              "payload": {
                "json": "@{user.receipt_json}",
                "paths": [
                  "order_id",
                  "direction",
                  "status",
                  "total"
                ],
                "subtree_path": "lines",
                "output": {
                  "values": "user.receipt_values",
                  "subtree_json": "user.receipt_lines_json"
                }
              }
            }
          ],
          "icon": "refresh",
          "weight": 1
        },
        {
          "type": "button",
          "text": "LAN host share",
          "background_color": "#F59E0B",

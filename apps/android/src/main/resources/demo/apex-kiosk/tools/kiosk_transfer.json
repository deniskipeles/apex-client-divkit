{
  "type": "container",
  "orientation": "vertical",
  "item_spacing": 10,
  "paddings": {
    "left": 12,
    "right": 12,
    "top": 12,
    "bottom": 12
  },
  "items": [
    {
      "type": "text",
      "text": "QR TRANSFER",
      "font_size": 18,
      "text_color": "#6EE7B7",
      "font_weight": "bold"
    },
    {
      "type": "text",
      "text": "Full JSON • base45 • ≤500 bytes/QR • max 32 • DivKit 400 ms animation",
      "font_size": 11,
      "text_color": "#94A3B8",
      "font_family": "monospace"
    },
    {
      "type": "text",
      "text": "Order @{user.kiosk_order_id} • @{user.kiosk_direction} • @{user.kiosk_status} • $@{user.kiosk_total}",
      "font_size": 11,
      "text_color": "#A7F3D0",
      "font_family": "monospace"
    },
    {
      "type": "container",
      "orientation": "horizontal",
      "item_spacing": 8,
      "items": [
        {
          "type": "button",
          "text": "Create QR set",
          "background_color": "#059669",
          "text_color": "#ECFDF5",
          "corner_radius": 10,
          "font_size": 12,
          "font_weight": "bold",
          "actions": [
            {
              "type": "set_variable",
              "variable_name": "user.qr_json",
              "value": {
                "type": "string",
                "value": "{\"direction\":\"@{user.kiosk_direction}\",\"order_id\":\"@{user.kiosk_order_id}\",\"status\":\"@{user.kiosk_status}\",\"total\":@{user.kiosk_total},\"item_count\":@{user.kiosk_item_count},\"lines\":@{user.kiosk_lines_json}}"
              }
            },
            {
              "log_id": "chunk_json",
              "url": "tools://codec/json/chunk",
              "payload": {
                "json": "@{user.qr_json}",
                "encoding": "base45",
                "max_bytes": 500,
                "max_chunks": 32,
                "output": {
                  "chunks": "user.qr_chunks",
                  "count": "user.qr_count",
                  "transfer_id": "user.qr_transfer_id",
                  "checksum": "user.qr_checksum"
                }
              }
            },
            {
              "log_id": "qr_gen_0",
              "url": "tools://code-generate/generate",
              "payload": {
                "content": "@{user.qr_count > 0 ? getArrayString(user.qr_chunks, 0) : 'EMPTY'}",
                "format": "qr",
                "width": 512,
                "height": 512,
                "ec_level": "M",
                "margin": 4,
                "output": {
                  "uri": "user.qr_img_0",
                  "code_id": "user.qr_code_id_0"
                }
              }
            },
            {
              "log_id": "qr_move_0",
              "url": "tools://files/move",
              "payload": {
                "from": "media/@{user.qr_code_id_0}.png",
                "to": "cache/qr/${tenantId}/@{user.qr_code_id_0}.png",
                "overwrite": true
              }
            },
            {
              "log_id": "qr_gen_1",
              "url": "tools://code-generate/generate",
              "payload": {
                "content": "@{user.qr_count > 1 ? getArrayString(user.qr_chunks, 1) : 'EMPTY'}",
                "format": "qr",
                "width": 512,

          "font_size": 12,
          "font_weight": "bold",
          "actions": [
            {
              "log_id": "start_hub",
              "url": "tools://net/serve",
              "payload": {
                "port": 8089,
                "label": "APEX Kiosk LAN",
                "output": {
                  "local_ip": "user.net_local_ip",
                  "lan_url": "user.net_lan_url",
                  "port": "user.net_hub_port",
                  "status": "user.net_status"
                }
              }
            },
            {
              "log_id": "share_transfer",
              "url": "tools://net/share",
              "payload": {
                "content": "@{user.qr_json}",
                "name": "transfer.json",
                "content_type": "application/json",
                "output": {
                  "id": "user.net_share_id",
                  "path": "user.net_share_path",
                  "status": "user.net_status"
                }
              }
            },
            {
              "type": "set_variable",
              "variable_name": "user.lan_download_url",
              "value": {
                "type": "string",
                "value": "@{user.net_lan_url}@{user.net_share_path}"
              }
            }
          ],
          "icon": "globe",
          "weight": 1
        }
      ]
    },
    {
      "type": "button",
      "text": "Complete + clean cache",
      "background_color": "#B91C1C",
      "text_color": "#FEF2F2",
      "corner_radius": 10,
      "font_size": 12,
      "font_weight": "bold",
      "actions": [

    }
  ],
  "background_color": "#071221",
  "_timers": [
    {
      "id": "qr_cycle",
      "tick_interval": 400,
      "tick_actions": [
        {
          "type": "set_variable",
          "variable_name": "user.qr_index",
          "value": {
            "type": "integer",
            "value": "@{mod(user.qr_index + 1, user.qr_count > 0 ? user.qr_count : 1)}"
          }
        }
      ]
    }
  ]

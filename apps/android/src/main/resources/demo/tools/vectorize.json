{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#111827",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#38BDF8",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "🔢 TEXT & IMAGE VECTOR EMBEDDINGS (tools://vectorize)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#7DD3FC"
        },
        {
            "type": "text",
            "text": "Source: @{user.vector_source} • Dim: @{user.vector_dim} • Similarity: @{user.vector_similarity}",
            "font_size": 12,
            "text_color": "#E0F2FE",
            "font_family": "monospace"
        },
        {
            "type": "text",
            "text": "Vector: @{user.vector_b64}",
            "font_size": 10,
            "text_color": "#BAE6FD",
            "font_family": "monospace",
            "max_lines": 2
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_vectorize_text",
                            "text": "Embed Item Name",
                            "subtitle": "tools://vectorize/text • USE-Lite 512-d",
                            "icon": "search",
                            "background_color": "#0284C7",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_vectorize_text",
                                "url": "tools://vectorize/text",
                                "payload": {
                                    "operation": "text",
                                    "options": {
                                        "normalize": "true",
                                        "text": "Wagyu Smash Burger • ACM-101 • $16.50"
                                    },
                                    "output": {
                                        "vector_b64": "user.vector_b64",
                                        "dim": "user.vector_dim",
                                        "source_type": "user.vector_source"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_vectorize_image_text",
                            "text": "Embed Image + OCR",
                            "subtitle": "tools://vectorize/image_text • ML Kit + USE-Lite",
                            "icon": "ocr",
                            "background_color": "#0369A1",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_vectorize_image_text",
                                "url": "tools://vectorize/image_text",
                                "payload": {
                                    "operation": "image_text",
                                    "options": {
                                        "normalize": "true",
                                        "include_ocr_text": "true",
                                        "uri": "${demoImageUri}"
                                    },
                                    "output": {
                                        "vector_b64": "user.vector_b64",
                                        "dim": "user.vector_dim",
                                        "source_type": "user.vector_source",
                                        "ocr_text": "user.ocr_text"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}

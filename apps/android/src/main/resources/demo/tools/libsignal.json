{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#2E1065",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#8B5CF6",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "🔒 LIBSIGNAL E2EE SESSION (tools://libsignal)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#C4B5FD"
        },
        {
            "type": "text",
            "text": "Session: @{user.signal_session_id} • Fingerprint: @{user.signal_fingerprint} • Status: @{user.signal_status}",
            "font_size": 12,
            "text_color": "#EDE9FE",
            "font_family": "monospace"
        },
        {
            "type": "button",
            "id": "tool_libsignal_create_session",
            "text": "Establish E2EE Signal Ratchet Session",
            "subtitle": "tools://libsignal/create_session • Curve25519 Double Ratchet",
            "icon": "lock",
            "background_color": "#7C3AED",
            "text_color": "#FFFFFF",
            "corner_radius": 10,
            "action": {
                "log_id": "exec_tool_libsignal_create_session",
                "url": "tools://libsignal/create_session",
                "payload": {
                    "operation": "create_session",
                    "options": {
                        "cipher": "AES-256-GCM"
                    },
                    "output": {
                        "status": "user.signal_status",
                        "session_id": "user.signal_session_id",
                        "fingerprint": "user.signal_fingerprint",
                        "ciphertext": "user.signal_ciphertext"
                    }
                }
            }
        }
    ]
}

{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#1E1B2E",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#A78BFA",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "🎛️ IMAGE MANIPULATION & BG REMOVAL (tools://image-manipulation)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#C4B5FD"
        },
        {
            "type": "text",
            "text": "Output: @{user.processed_image_uri} • Status: @{user.image_processing_status}",
            "font_size": 12,
            "text_color": "#EDE9FE",
            "font_family": "monospace"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_image-manipulation_remove_background",
                            "text": "Remove Background",
                            "subtitle": "tools://image-manipulation/remove_background",
                            "icon": "crop",
                            "background_color": "#7C3AED",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_image-manipulation_remove_background",
                                "url": "tools://image-manipulation/remove_background",
                                "payload": {
                                    "operation": "remove_background",
                                    "options": {
                                        "op": "remove_background",
                                        "encoding": "uri",
                                        "uri": "${demoImageUri}"
                                    },
                                    "output": {
                                        "uri": "user.processed_image_uri",
                                        "status": "user.image_processing_status"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_image-manipulation_smooth",
                            "text": "Edge-Preserving Smooth",
                            "subtitle": "tools://image-manipulation/smooth",
                            "icon": "refresh",
                            "background_color": "#6D28D9",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_image-manipulation_smooth",
                                "url": "tools://image-manipulation/smooth",
                                "payload": {
                                    "operation": "smooth",
                                    "options": {
                                        "op": "smooth",
                                        "strength": "0.6",
                                        "uri": "${demoImageUri}"
                                    },
                                    "output": {
                                        "uri": "user.processed_image_uri",
                                        "status": "user.image_processing_status"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}

{
    "type": "container",
    "orientation": "vertical",
    "background_color": "#0C2B3A",
    "corner_radius": 12,
    "paddings": {
        "left": 12,
        "right": 12,
        "top": 10,
        "bottom": 10
    },
    "border": {
        "corner_radius": 12,
        "stroke": {
            "color": "#22D3EE",
            "width": 1
        }
    },
    "items": [
        {
            "type": "text",
            "text": "📸 HARDWARE CAMERA CAPTURE & TORCH (tools://camera)",
            "font_size": 11,
            "font_weight": "bold",
            "text_color": "#67E8F9"
        },
        {
            "type": "text",
            "text": "Capture: @{user.camera_capture_uri} • Torch: @{user.camera_torch_state}",
            "font_size": 12,
            "text_color": "#CFFAFE",
            "font_family": "monospace"
        },
        {
            "type": "container",
            "orientation": "horizontal",
            "item_spacing": 8,
            "items": [
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_camera_capture",
                            "text": "Capture Frame",
                            "subtitle": "tools://camera/capture • 1080p back camera",
                            "icon": "camera",
                            "background_color": "#0891B2",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_camera_capture",
                                "url": "tools://camera/capture",
                                "payload": {
                                    "operation": "capture",
                                    "options": {
                                        "facing": "back",
                                        "resolution": "1080p"
                                    },
                                    "output": {
                                        "uri": "user.camera_capture_uri"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "weight": 1.0,
                    "items": [
                        {
                            "type": "button",
                            "id": "tool_camera_torch_toggle",
                            "text": "Toggle Torch",
                            "subtitle": "tools://camera/torch_toggle",
                            "icon": "search",
                            "background_color": "#0E7490",
                            "text_color": "#FFFFFF",
                            "corner_radius": 10,
                            "action": {
                                "log_id": "exec_tool_camera_torch_toggle",
                                "url": "tools://camera/torch_toggle",
                                "payload": {
                                    "operation": "torch_toggle",
                                    "options": {
                                        "state": "on"
                                    },
                                    "output": {
                                        "torch_state": "user.camera_torch_state"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
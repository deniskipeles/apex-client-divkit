{
 "card": {
  "log_id": "motorbike_handover",
  "variables": [
   {
    "name": "user.workspace_title",
    "type": "string",
    "value": "BODA BODA"
   },
   {
    "name": "user.rider_name",
    "type": "string",
    "value": "Rider"
   },
   {
    "name": "user.earnings_today",
    "type": "string",
    "value": "0"
   },
   {
    "name": "user.trip_count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "user.net_profit",
    "type": "string",
    "value": "0"
   },
   {
    "name": "user.fare_input",
    "type": "string",
    "value": "150"
   },
   {
    "name": "user.payment_method",
    "type": "string",
    "value": "M-Pesa"
   },
   {
    "name": "user.route_input",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.weekly_json",
    "type": "string",
    "value": "[{\"day\":\"Mon\",\"fare\":1240},{\"day\":\"Tue\",\"fare\":980},{\"day\":\"Wed\",\"fare\":1610},{\"day\":\"Thu\",\"fare\":1050},{\"day\":\"Fri\",\"fare\":1870},{\"day\":\"Sat\",\"fare\":2240},{\"day\":\"Sun\",\"fare\":0}]"
   },
   {
    "name": "user.trips_json",
    "type": "string",
    "value": "[{\"id\":\"t1\",\"day\":\"Sat\",\"fare\":350,\"payment\":\"M-Pesa\",\"route\":\"Kawangware → CBD\"},{\"id\":\"t2\",\"day\":\"Sat\",\"fare\":220,\"payment\":\"Cash\",\"route\":\"Westlands → Parklands\"},{\"id\":\"t3\",\"day\":\"Fri\",\"fare\":480,\"payment\":\"M-Pesa\",\"route\":\"CBD → Karen\"}]"
   },
   {
    "name": "user.expenses_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.handover_status",
    "type": "string",
    "value": "NOT_STARTED"
   },
   {
    "name": "user.trip_modal",
    "type": "boolean",
    "value": false
   },
   {
    "name": "user.last_action",
    "type": "string",
    "value": "Ready"
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "orientation": "vertical",
     "items": [
      {
       "type": "container",
       "orientation": "horizontal",
       "items": [
        {
         "type": "button",
         "text": "Back",
         "font_size": 12,
         "font_weight": "bold",
         "text_color": "#F8FAFC",
         "background_color": "#16233A",
         "corner_radius": 12,
         "height": {
          "type": "fixed",
          "value": 40
         },
         "width": {
          "type": "fixed",
          "value": 80
         },
         "actions": [
          {
           "url": "nav://pop"
          }
         ],
         "border": {
          "corner_radius": 12,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         },
         "id": "btn_back"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Handover",
           "font_size": 26,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "max_lines": 2
          },
          {
           "type": "text",
           "text": "Close the day with the owner",
           "font_size": 12,
           "font_weight": "regular",
           "text_color": "#94A3B8",
           "max_lines": 2
          }
         ],
         "weight": 1
        }
       ],
       "item_spacing": 8,
       "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
       }
      },
      {
       "type": "container",
       "orientation": "vertical",
       "items": [
        {
         "type": "progress_ring",
         "custom_props": {
          "value": 0.72,
          "label": "Cash target",
          "caption": "KES 3,600 of 5,000"
         },
         "id": "handover_ring"
        },
        {
         "type": "text",
         "text": "Rider signature",
         "font_size": 11,
         "font_weight": "bold",
         "text_color": "#94A3B8"
        },
        {
         "type": "custom",
         "custom_type": "sdui_signature",
         "custom_props": {
          "variable": "user.handover_signature",
          "label": "Sign to confirm"
         },
         "id": "handover_signature"
        },
        {
         "type": "inline_banner",
         "custom_props": {
          "text": "@{'Status: ' + user.handover_status}",
          "tone": "success"
         },
         "id": "handover_status"
        },
        {
         "type": "toast",
         "custom_props": {
          "text": "@{'Handover ' + user.handover_status}"
         },
         "id": "handover_toast"
        }
       ],
       "item_spacing": 12,
       "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
       }
      },
      {
       "type": "sticky_footer",
       "custom_props": {
        "body": [],
        "footer": [
         {
          "type": "container",
          "orientation": "vertical",
          "items": [
           {
            "type": "button",
            "text": "Confirm handover",
            "font_size": 14,
            "font_weight": "bold",
            "text_color": "#FFFFFF",
            "background_color": "#7C3AED",
            "corner_radius": 12,
            "height": {
             "type": "fixed",
             "value": 44
            },
            "width": {
             "type": "match_parent"
            },
            "actions": [
             {
              "url": "local-db://op/db.insert",
              "payload": {
               "collection": "handovers",
               "data": {
                "status": "CONFIRMED",
                "signature": "@{user.handover_signature}"
               }
              }
             },
             {
              "url": "div-action://set_variable?name=user.handover_status&value=CONFIRMED"
             }
            ],
            "id": "handover_confirm"
           },
           {
            "type": "button",
            "text": "Back to hub",
            "font_size": 14,
            "font_weight": "bold",
            "text_color": "#F8FAFC",
            "background_color": "transparent",
            "corner_radius": 12,
            "height": {
             "type": "fixed",
             "value": 44
            },
            "width": {
             "type": "match_parent"
            },
            "actions": [
             {
              "url": "nav://pop"
             }
            ],
            "border": {
             "corner_radius": 12,
             "stroke": {
              "color": "#1E293B",
              "width": 1
             }
            },
            "id": "handover_back"
           }
          ],
          "item_spacing": 8,
          "paddings": {
           "left": 16,
           "top": 0,
           "right": 16,
           "bottom": 0
          }
         }
        ]
       },
       "id": "handover_footer"
      }
     ],
     "item_spacing": 8,
     "paddings": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 16
     }
    }
   }
  ]
 }
}

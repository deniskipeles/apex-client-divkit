            "type": "button",
            "weight": 0.38,
            "text": "Void",
            "icon": "delete",
            "font_size": 12,
            "font_weight": "bold",
            "text_color": "#FCA5A5",
            "background_color": "#450A0A",
            "corner_radius": 8,
            "paddings": {
              "left": 10,
              "right": 10,
              "top": 8,
              "bottom": 8
            },
            "actions": [

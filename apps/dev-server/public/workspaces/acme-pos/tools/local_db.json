                "type": "action",
                "url": "local-db://op/db.delete",
                "payload": {
                  "table": "orders",
                  "where": [
                    {
                      "field": "id",
                      "op": "eq",
                      "value": "@{item.id}"
                    }
                  ],
                  "output": {
                    "count": "user.last_deleted_count"

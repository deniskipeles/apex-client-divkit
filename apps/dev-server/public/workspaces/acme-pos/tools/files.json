{
  "type": "container",
  "border": {
    "corner_radius": 12,
    "stroke": {
      "color": "#38BDF8",
      "width": 1
    }
  },
  "items": [
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "🗂️ WORKSPACE FILES (tools://files) — storage.files@1",
      "text_color": "#7DD3FC"
    },
    {
      "type": "text",
      "font_size": 11,
      "text": "Bytes in, bytes out, scoped to this tenant's sandbox. Paths are relative to the workspace root and cannot escape it.",
      "text_color": "#94A3B8"
    },
    {
      "type": "text",
      "font_family": "monospace",
      "font_size": 11,
      "text": "Status: @{user.files_status}",
      "text_color": "#E0F2FE"
    },
    {
      "type": "text",
      "font_family": "monospace",
      "font_size": 11,
      "text": "Path: @{user.files_path}",
      "text_color": "#E0F2FE"
    },
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "Workspace root",
      "text_color": "#BAE6FD"
    },
    {
      "type": "container",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_list",
              "text": "List Root",
              "subtitle": "Enumerate entries",
              "icon": "folder",
              "background_color": "#0369A1",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_list",
                "url": "tools://files/list",
                "payload": {
                  "operation": "list",
                  "options": {
                    "op": "list"
                  },
                  "output": {
                    "status": "user.files_status",
                    "listing": "user.files_listing",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_mkdir",
              "text": "Create Folder",
              "subtitle": "mkdir notes",
              "icon": "folder",
              "background_color": "#075985",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_mkdir",
                "url": "tools://files/mkdir",
                "payload": {
                  "operation": "mkdir",
                  "options": {
                    "op": "mkdir",
                    "path": "notes"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        }
      ],
      "orientation": "horizontal"
    },
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "Write & read",
      "text_color": "#BAE6FD"
    },
    {
      "type": "container",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_write",
              "text": "Write Text File",
              "subtitle": "Base64-encoded payload",
              "icon": "edit",
              "background_color": "#0F766E",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_write",
                "url": "tools://files/write",
                "payload": {
                  "operation": "write",
                  "options": {
                    "op": "write",
                    "path": "notes/hello.txt",
                    "content": "SGVsbG8gZnJvbSB0aGUgd29ya3NwYWNlIGZpbGUgc3RvcmUu"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_read",
              "text": "Read It Back",
              "subtitle": "Return decoded text",
              "icon": "scanner",
              "background_color": "#115E59",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_read",
                "url": "tools://files/read",
                "payload": {
                  "operation": "read",
                  "options": {
                    "op": "read",
                    "path": "notes/hello.txt"
                  },
                  "output": {
                    "status": "user.files_status",
                    "content": "user.files_content",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        }
      ],
      "orientation": "horizontal"
    },
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "Copy, move, delete",
      "text_color": "#BAE6FD"
    },
    {
      "type": "container",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_copy",
              "text": "Copy",
              "subtitle": "notes/hello.txt → notes/copy.txt",
              "icon": "clipboard",
              "background_color": "#7C3AED",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_copy",
                "url": "tools://files/copy",
                "payload": {
                  "operation": "copy",
                  "options": {
                    "op": "copy",
                    "from": "notes/hello.txt",
                    "to": "notes/copy.txt"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_move",
              "text": "Move",
              "subtitle": "notes/copy.txt → notes/moved.txt",
              "icon": "refresh",
              "background_color": "#6D28D9",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_move",
                "url": "tools://files/move",
                "payload": {
                  "operation": "move",
                  "options": {
                    "op": "move",
                    "from": "notes/copy.txt",
                    "to": "notes/moved.txt"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        }
      ],
      "orientation": "horizontal"
    },
    {
      "type": "container",
      "item_spacing": 8,
      "items": [
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_stat",
              "text": "Stat",
              "subtitle": "Size and mtime",
              "icon": "database",
              "background_color": "#B45309",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_stat",
                "url": "tools://files/stat",
                "payload": {
                  "operation": "stat",
                  "options": {
                    "op": "stat",
                    "path": "notes/moved.txt"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "items": [
            {
              "type": "button",
              "id": "tool_files_delete",
              "text": "Delete",
              "subtitle": "Remove notes/moved.txt",
              "icon": "close",
              "background_color": "#991B1B",
              "text_color": "#F8FAFC",
              "corner_radius": 10,
              "action": {
                "log_id": "exec_tool_files_delete",
                "url": "tools://files/delete",
                "payload": {
                  "operation": "delete",
                  "options": {
                    "op": "delete",
                    "path": "notes/moved.txt"
                  },
                  "output": {
                    "status": "user.files_status",
                    "path": "user.files_path"
                  }
                }
              }
            }
          ]
        }
      ],
      "orientation": "horizontal"
    },
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "Listing",
      "text_color": "#BAE6FD"
    },
    {
      "type": "text",
      "font_family": "monospace",
      "font_size": 11,
      "text": "@{user.files_listing}",
      "text_color": "#E0F2FE"
    },
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "Content",
      "text_color": "#BAE6FD"
    },
    {
      "type": "text",
      "font_family": "monospace",
      "font_size": 11,
      "text": "@{user.files_content}",
      "text_color": "#E0F2FE"
    }
  ],
  "orientation": "vertical",
  "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
  }
}

            {
              "type": "text",
              "font_size": 12,
              "font_weight": "regular",
              "text": "Synthesize a sine, square or triangle tone, or a short melodic sequence, through the audio actuator.",
              "text_color": "#94A3B8"
            }
          ],
          "orientation": "vertical"
        }
      ],
      "orientation": "horizontal",
      "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
      }
    },

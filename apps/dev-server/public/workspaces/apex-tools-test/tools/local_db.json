       "text_color": "#F8FAFC"
      },
      {
       "type": "text",
       "font_size": 12,
       "font_weight": "regular",
       "text": "SQLite data plane: insert, query, count, delete",
       "text_color": "#94A3B8"
      }
     ],
     "orientation": "vertical"
    }
   ],
   "orientation": "horizontal",
   "paddings": {
    "left": 16,
    "top": 32,
    "right": 16,
    "bottom": 8
   }
  },
  {
   "type": "container",
   "item_spacing": 12,
   "items": [
    {
     "type": "container",
     "border": {
      "corner_radius": 16,
      "stroke": {
       "color": "#1E293B",
       "width": 1
      }
     },
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "font_size": 11,
       "font_weight": "bold",
       "text": "Last result",
       "text_color": "#94A3B8"
      },
      {
       "type": "text",
       "font_size": 14,
       "font_weight": "bold",
       "text": "@{user.db_result}",
       "text_color": "#34D399"
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 12,
      "top": 12,
      "right": 12,
      "bottom": 12
     }
    },
    {
     "type": "container",
     "border": {
      "corner_radius": 16,
      "stroke": {
       "color": "#1E293B",
       "width": 1
      }
     },
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Insert sample",
       "font_size": 12,
       "font_weight": "bold",
       "text_color": "#FFFFFF",
       "background_color": "#7C3AED",
       "corner_radius": 12,
       "height": {
        "type": "fixed",
        "value": 44
       },
       "width": {
        "type": "match_parent"
       },
       "actions": [
        {
         "url": "local-db://op/db.insert",
         "payload": {
          "collection": "samples",
          "data": {
           "name": "Probe item",
           "note": "inserted from card"
          },
          "output": {
           "id": "user.db_result"
          }
         }
        }
       ],
       "id": "db_insert"
      },
      {
       "type": "button",
       "text": "Query samples",
       "font_size": 12,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "background_color": "#16233A",
       "corner_radius": 12,
       "height": {
        "type": "fixed",
        "value": 44
       },
       "width": {
        "type": "match_parent"
       },
       "actions": [
        {
         "url": "local-db://op/db.query",
         "payload": {
          "collection": "samples",
          "order_by": "id",
          "limit": 50,
          "output": {
           "_json": "user.samples_json"
          }
         }
        }
       ],
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#1E293B",
         "width": 1
        }
       },
       "id": "db_query"
      },
      {
       "type": "button",
       "text": "Count samples",
       "font_size": 12,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "background_color": "#16233A",
       "corner_radius": 12,
       "height": {
        "type": "fixed",
        "value": 44
       },
       "width": {
        "type": "match_parent"
       },
       "actions": [
        {
         "url": "local-db://op/db.count",
         "payload": {
          "collection": "samples",
          "output": {
           "count": "user.samples_count"
          }
         }
        }
       ],
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#1E293B",
         "width": 1
        }
       },
       "id": "db_count"
      },
      {
       "type": "button",
       "text": "Delete inserted",
       "font_size": 12,
       "font_weight": "bold",
       "text_color": "#FFFFFF",
       "background_color": "#EF4444",
       "corner_radius": 12,
       "height": {
        "type": "fixed",
        "value": 44
       },
       "width": {
        "type": "match_parent"
       },
       "actions": [
        {
         "url": "local-db://op/db.delete",
         "payload": {
          "collection": "samples",
          "where": {
           "note": "inserted from card"
          },
          "output": {
           "deleted": "user.db_result"
          }
         }
        }
       ],
       "id": "db_delete"
      }
     ],
     "orientation": "vertical",
     "paddings": {
      "left": 12,
      "top": 12,
      "right": 12,
      "bottom": 12
     }
    }
   ],
   "orientation": "vertical",
   "paddings": {

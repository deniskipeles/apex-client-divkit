{
 "card": {
  "log_id": "apex_tools_test_net",
  "variables": [
   {
    "name": "user.workspace_title",
    "type": "string",
    "value": "APEX TOOLS"
   },
   {
    "name": "user.tools_status",
    "type": "string",
    "value": "Idle"
   },
   {
    "name": "user.tools_result",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.tools_error",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.haptic_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.beep_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.clipboard_content",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.code_image_uri",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.code_format",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.file_preview",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.files_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.net_status",
    "type": "string",
    "value": "stopped"
   },
   {
    "name": "user.net_url",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.net_shares_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.print_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.screen_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.samples_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.samples_count",
    "type": "integer",
    "value": 0
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "orientation": "vertical",
     "items": [
      {
       "type": "container",
       "orientation": "horizontal",
       "items": [
        {
         "type": "button",
         "text": "Back",
         "font_size": 12,
         "font_weight": "bold",
         "text_color": "#F8FAFC",
         "background_color": "#16233A",
         "corner_radius": 12,
         "height": {
          "type": "fixed",
          "value": 40
         },
         "width": {
          "type": "fixed",
          "value": 80
         },
         "actions": [
          {
           "url": "nav://pop"
          }
         ],
         "border": {
          "corner_radius": 12,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         },
         "id": "btn_back"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Network",
           "font_size": 18,
           "font_weight": "bold",
           "text_color": "#F8FAFC"
          },
          {
           "type": "text",
           "text": "HTTP fetch plus the LAN share hub",
           "font_size": 12,
           "font_weight": "regular",
           "text_color": "#94A3B8"
          }
         ],
         "weight": 1
        }
       ],
       "item_spacing": 8,
       "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
       }
      },
      {
       "type": "container",
       "orientation": "vertical",
       "items": [
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Hub state",
           "font_size": 11,
           "font_weight": "bold",
           "text_color": "#94A3B8"
          },
          {
           "type": "text",
           "text": "@{user.net_status + (user.net_url == '' ? '' : ' - ' + user.net_url)}",
           "font_size": 14,
           "font_weight": "bold",
           "text_color": "#34D399"
          },
          {
           "type": "inline_banner",
           "custom_props": {
            "text": "@{user.tools_error == '' ? 'No errors' : user.tools_error}",
            "tone": "warn"
           }
          }
         ],
         "item_spacing": 8,
         "background_color": "#111C2E",
         "paddings": {
          "left": 12,
          "top": 12,
          "right": 12,
          "bottom": 12
         },
         "border": {
          "corner_radius": 16,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         }
        },
        {
         "type": "json_list",
         "data_var": "user.net_shares_json",
         "empty_text": "No shares on the hub",
         "row_card": {
          "type": "container",
          "orientation": "horizontal",
          "items": [
           {
            "type": "text",
            "text": "@{item.title}",
            "font_size": 12,
            "font_weight": "regular",
            "text_color": "#F8FAFC",
            "width": {
             "type": "match_parent"
            }
           },
           {
            "type": "text",
            "text": "@{item.id}",
            "font_size": 11,
            "font_weight": "regular",
            "text_color": "#94A3B8"
           }
          ],
          "background_color": "#16233A",
          "paddings": {
           "left": 8,
           "top": 8,
           "right": 8,
           "bottom": 8
          },
          "border": {
           "corner_radius": 12
          }
         },
         "id": "net_shares_list"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "button",
           "text": "GET example.com",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/get",
             "payload": {
              "options": {
               "url": "https://example.com"
              },
              "output": {
               "status": "user.tools_status",
               "body": "user.tools_result"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_get"
          },
          {
           "type": "button",
           "text": "Start hub",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/serve",
             "payload": {
              "options": {
               "port": "8089"
              },
              "output": {
               "status": "user.net_status",
               "url": "user.net_url",
               "id": "user.net_share_id"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_serve"
          },
          {
           "type": "button",
           "text": "Hub status",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/status",
             "payload": {
              "output": {
               "status": "user.net_status",
               "url": "user.net_url"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_status"
          },
          {
           "type": "button",
           "text": "Share sample",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/share",
             "payload": {
              "options": {
               "title": "Probe item",
               "payload": "{\"sku\":\"P1001\",\"price\":1.5}"
              },
              "output": {
               "id": "user.net_share_id",
               "count": "user.net_share_count"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_share"
          },
          {
           "type": "button",
           "text": "List shares",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/list",
             "payload": {
              "output": {
               "_json": "user.net_shares_json"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_list"
          },
          {
           "type": "button",
           "text": "Stop hub",
           "font_size": 12,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "tools://net/stop",
             "payload": {
              "output": {
               "status": "user.net_status"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "net_stop"
          }
         ],
         "item_spacing": 8,
         "background_color": "#111C2E",
         "paddings": {
          "left": 12,
          "top": 12,
          "right": 12,
          "bottom": 12
         },
         "border": {
          "corner_radius": 16,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         }
        }
       ],
       "item_spacing": 12,
       "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
       }
      }
     ],
     "item_spacing": 8,
     "paddings": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 16
     }
    }
   }
  ]
 }
}

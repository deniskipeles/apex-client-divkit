          "height": {
            "type": "fixed",
            "value": 40
          },
          "width": {
            "type": "fixed",
            "value": 80
          },
          "actions": [
            {
              "url": "nav://pop"
            }
          ],
          "border": {
            "corner_radius": 12,
            "stroke": {
              "color": "#1E293B",
              "width": 1
            }
          },
          "id": "btn_back"
        },
        {
          "type": "container",
          "items": [
            {
              "type": "text",
              "font_size": 18,
              "font_weight": "bold",
              "text": "embedding",
              "text_color": "#F8FAFC"
            },
            {
              "type": "text",
              "font_size": 12,
              "font_weight": "regular",
              "text": "Embed text (512-d hashed fallback when the MediaPipe text JNI is absent) or an image descriptor, and score two texts for similarity.",
              "text_color": "#94A3B8"
            }
          ],
          "orientation": "vertical"
        }
      ],
      "orientation": "horizontal",
      "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
      }
    },
    {
      "type": "container",
      "item_spacing": 12,

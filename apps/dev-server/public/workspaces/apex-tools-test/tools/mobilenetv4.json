{
  "type": "container",
  "item_spacing": 8,
  "items": [
    {
      "type": "container",
      "item_spacing": 8,
      "items": [
        {
          "type": "button",
          "text": "Back",
          "font_size": 12,
          "font_weight": "bold",
          "text_color": "#F8FAFC",
          "background_color": "#16233A",
          "corner_radius": 12,
          "height": {
            "type": "fixed",
            "value": 40
          },
          "width": {
            "type": "fixed",
            "value": 80
          },
          "actions": [
            {
              "url": "nav://pop"
            }
          ],
          "border": {
            "corner_radius": 12,
            "stroke": {
              "color": "#1E293B",
              "width": 1
            }
          },
          "id": "btn_back"
        },
        {
          "type": "container",
          "items": [
            {
              "type": "text",
              "font_size": 18,
              "font_weight": "bold",
              "text": "MobileNetV4-small",
              "text_color": "#F8FAFC"
            },
            {
              "type": "text",
              "font_size": 12,
              "font_weight": "regular",
              "text": "Run the bundled MobileNetV4 ImageNet-1k classifier over a real image. It reports ImageNet labels, never a POS SKU, and refuses when it has no frame.",
              "text_color": "#94A3B8"
            }
          ],
          "orientation": "vertical"
        }
      ],
      "orientation": "horizontal",
      "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
      }
    },
    {
      "type": "container",
      "item_spacing": 12,
      "items": [
        {
          "type": "container",
          "orientation": "vertical",
          "item_spacing": 4,
          "paddings": {
            "left": 12,
            "top": 8,
            "right": 12,
            "bottom": 8
          },
          "background_color": "#16233A",
          "border": {
            "corner_radius": 12,
            "stroke": {
              "color": "#1E293B",
              "width": 1
            }
          },
          "items": [
            {
              "type": "text",
              "text": "Status",
              "font_size": 11,
              "font_weight": "bold",
              "text_color": "#94A3B8"
            },
            {
              "type": "text",
              "text": "@{user.tools_status}",
              "font_size": 18,
              "font_weight": "bold",
              "text_color": "#34D399"
            }
          ],
          "id": "metric_status"
        },
        {
          "type": "inline_banner",
          "custom_props": {
            "text": "@{user.tools_error == '' ? 'No errors' : user.tools_error}",
            "tone": "warn"
          }
        },
        {
          "type": "container",
          "border": {
            "corner_radius": 16,
            "stroke": {
              "color": "#1E293B",
              "width": 1
            }
          },
          "item_spacing": 8,
          "items": [
            {
              "type": "button",
              "text": "Classify (no image)",
              "font_size": 12,
              "font_weight": "bold",
              "text_color": "#FFFFFF",
              "background_color": "#7C3AED",
              "corner_radius": 12,
              "height": {
                "type": "fixed",
                "value": 40
              },
              "width": {
                "type": "match_parent"
              },
              "actions": [
                {
                  "url": "tools://MobileNetV4-small/classify",
                  "payload": {
                    "options": {},
                    "output": {
                      "status": "user.tools_status"
                    }
                  }
                }
              ],
              "subtitle": "tools://MobileNetV4-small/classify",
              "id": "tool_mobilenetv4_classify_without_image_fails_closed",
              "content_description": "MobileNetV4-small classify"
            },
            {
              "type": "button",
              "text": "Detect (no image)",
              "font_size": 12,
              "font_weight": "bold",
              "text_color": "#F8FAFC",
              "background_color": "#16233A",
              "corner_radius": 12,
              "height": {
                "type": "fixed",
                "value": 40
              },
              "width": {
                "type": "match_parent"
              },
              "actions": [
                {
                  "url": "tools://MobileNetV4-small/detect",
                  "payload": {
                    "options": {},
                    "output": {
                      "status": "user.tools_status"
                    }
                  }
                }
              ],
              "border": {
                "corner_radius": 12,
                "stroke": {
                  "color": "#1E293B",
                  "width": 1
                }
              },
              "subtitle": "tools://MobileNetV4-small/detect",
              "id": "tool_mobilenetv4_detect_alias_fails_closed",
              "content_description": "MobileNetV4-small detect"
            },
            {
              "type": "button",
              "text": "Predict (no image)",
              "font_size": 12,
              "font_weight": "bold",
              "text_color": "#FFFFFF",
              "background_color": "#7C3AED",
              "corner_radius": 12,
              "height": {
                "type": "fixed",
                "value": 40
              },
              "width": {
                "type": "match_parent"
              },
              "actions": [
                {
                  "url": "tools://MobileNetV4-small/predict",
                  "payload": {
                    "options": {},
                    "output": {
                      "status": "user.tools_status"
                    }
                  }
                }
              ],
              "subtitle": "tools://MobileNetV4-small/predict",
              "id": "tool_mobilenetv4_predict_alias_fails_closed",
              "content_description": "MobileNetV4-small predict"
            }
          ],
          "orientation": "vertical",
          "paddings": {
            "left": 12,
            "top": 12,
            "right": 12,
            "bottom": 12
          }
        },
        {
          "type": "button",
          "text": "Back to tools",
          "font_size": 12,
          "font_weight": "bold",
          "text_color": "#F8FAFC",
          "background_color": "transparent",
          "corner_radius": 12,
          "height": {
            "type": "fixed",
            "value": 40
          },
          "width": {
            "type": "match_parent"
          },
          "actions": [
            {
              "url": "nav://pop"
            }
          ],
          "border": {
            "corner_radius": 12,
            "stroke": {
              "color": "#1E293B",
              "width": 1
            }
          },
          "id": "btn_back_footer"
        }
      ],
      "orientation": "vertical",
      "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
      }
    }
  ],
  "orientation": "vertical",
  "paddings": {
    "left": 0,
    "top": 0,
    "right": 0,
    "bottom": 16
  }
}

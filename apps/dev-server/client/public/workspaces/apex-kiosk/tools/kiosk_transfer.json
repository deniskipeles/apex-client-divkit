{
 "type": "container",
 "orientation": "vertical",
 "item_spacing": 16,
 "items": [
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "container",
       "orientation": "vertical",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "text": "QR transfer",
         "font_size": 24,
         "text_color": "#F8FAFC",
         "font_weight": "bold"
        },
        {
         "type": "text",
         "text": "Move the live order between terminals as QR chunks",
         "font_size": 12,
         "text_color": "#94A3B8"
        }
       ],
       "weight": 1
      }
     ]
    },
    {
     "type": "text",
     "text": "@{if(user.qr_status == 'IDLE', 'Ready', if(user.qr_status == 'BUILDING', 'Building QR set…', if(user.qr_status == 'SUCCESS', 'QR set ready', user.qr_status)))}",
     "font_size": 11,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "background_color": "#1B2740",
     "corner_radius": 20,
     "paddings": {
      "left": 10,
      "right": 10,
      "top": 5,
      "bottom": 5
     },
     "margins": {
      "top": 6
     }
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Chunk",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "@{if(user.qr_count == 0, 'none yet', (toInteger(user.qr_index) + 1) + ' of ' + user.qr_count)}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      },
      {
       "type": "text",
       "text": "·",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "checksum @{if(user.qr_checksum == '', '—', user.qr_checksum)}",
       "font_size": 12,
       "text_color": "#94A3B8",
       "font_family": "monospace"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#3F1D24",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.engine_error}",
     "font_size": 12,
     "text_color": "#FCA5A5",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.engine_error != '', 'visible', 'gone')}",
   "id": "kiosk_transfer_error"
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#1B2740",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.kiosk_notice}",
     "font_size": 12,
     "text_color": "#F8FAFC",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.kiosk_notice != '', 'visible', 'gone')}",
   "id": "kiosk_transfer_notice"
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Send",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "chunk @{if(user.qr_count == 0, '—', (toInteger(user.qr_index) + 1))} of @{user.qr_count}",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "container",
     "orientation": "vertical",
     "item_spacing": 12,
     "items": [
      {
       "type": "image",
       "image_url": "@{user.qr_img_current}",
       "height": {
        "type": "fixed",
        "value": 260
       },
       "content_description": "Transfer QR chunk"
      }
     ],
     "background_color": "#FFFFFF",
     "paddings": {
      "left": 12,
      "right": 12,
      "top": 12,
      "bottom": 12
     },
     "corner_radius": 12,
     "visibility": "@{if(user.qr_img_current == '', 'gone', 'visible')}"
    },
    {
     "type": "text",
     "text": "No QR yet — tap Build QR set.",
     "font_size": 12,
     "text_color": "#64748B",
     "id": "kiosk_transfer_qr_empty",
     "visibility": "@{if(user.qr_img_current == '', 'visible', 'gone')}"
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Build QR set",
       "font_size": 14,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": 0
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.scanned_chunks",
         "value": {
          "type": "array",
          "value": []
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.qr_status",
         "value": {
          "type": "string",
          "value": "BUILDING"
         }
        },
        {
         "url": "local-db://op/db.query",
         "payload": {
          "collection": "kiosk_orders",
          "where": {
           "direction": "CUSTOMER_REQUEST"
          },
          "limit": 1,
          "output": {
           "id": "user.kiosk_order_id",
           "status": "user.kiosk_status",
           "direction": "user.kiosk_direction",
           "total_display": "user.kiosk_total",
           "subtotal_display": "user.kiosk_subtotal",
           "item_count": "user.kiosk_item_count",
           "line_count": "user.kiosk_line_count",
           "lines_json": "user.kiosk_lines_json",
           "payload_json": "user.kiosk_payload_json",
           "checksum": "user.kiosk_checksum"
          },
          "single": true,
          "sort": "-created_at"
         },
         "log_id": "kiosk_transfer_load"
        },
        {
         "url": "local-db://op/doc.pack",
         "payload": {
          "collection": "kiosk_orders",
          "id": "@{user.kiosk_order_id}",
          "output": {
           "id": "user.kiosk_order_label",
           "status": "user.kiosk_status",
           "direction": "user.kiosk_direction",
           "total_display": "user.kiosk_total",
           "subtotal_display": "user.kiosk_subtotal",
           "item_count": "user.kiosk_item_count",
           "line_count": "user.kiosk_line_count",
           "lines_json": "user.kiosk_lines_json",
           "payload_json": "user.kiosk_payload_json",
           "checksum": "user.kiosk_checksum"
          }
         },
         "log_id": "kiosk_transfer_export"
        },
        {
         "url": "tools://codec/json/chunk",
         "payload": {
          "json": "@{user.kiosk_payload_json}",
          "max_bytes": 700,
          "encoding": "base45",
          "output": {
           "chunks": "user.qr_chunks",
           "count": "user.qr_count",
           "transfer_id": "user.qr_transfer_id",
           "checksum": "user.qr_checksum"
          }
         },
         "log_id": "kiosk_transfer_chunk"
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, 0, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_transfer_qr"
        }
       ],
       "background_color": "#1B2740",
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#24304A",
         "width": 1
        }
       },
       "weight": 1,
       "id": "kiosk_build_qr_set"
      },
      {
       "type": "button",
       "text": "Prev",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": "@{max(0, toInteger(user.qr_index) - 1)}"
         }
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_transfer_prev"
        }
       ],
       "id": "kiosk_qr_prev",
       "background_color": "#E2E8F0"
      },
      {
       "type": "button",
       "text": "Next",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.qr_index",
         "value": {
          "type": "integer",
          "value": "@{min(toInteger(user.qr_count) - 1, toInteger(user.qr_index) + 1)}"
         }
        },
        {
         "url": "tools://code-generate/generate",
         "payload": {
          "content": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}",
          "format": "QR_CODE",
          "width": 640,
          "height": 640,
          "margin": 4,
          "output": {
           "uri": "user.qr_img_current",
           "status": "user.qr_status"
          }
         },
         "log_id": "kiosk_transfer_next"
        }
       ],
       "id": "kiosk_qr_next",
       "background_color": "#E2E8F0"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Receive",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{len(user.scanned_chunks)} scanned",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "text",
     "text": "Take each chunk in order, then assemble and verify the checksum.",
     "font_size": 12,
     "text_color": "#64748B"
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Add chunk",
       "font_size": 14,
       "font_weight": "bold",
       "text_color": "#F8FAFC",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.kiosk_notice",
         "value": {
          "type": "string",
          "value": "Chunk @{toInteger(user.qr_index) + 1} added to the scanned set"
         }
        },
        {
         "type": "array_insert_value",
         "variable_name": "user.scanned_chunks",
         "value": "@{getArrayOptString(user.qr_chunks, user.qr_index, '')}"
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_status",
         "value": {
          "type": "string",
          "value": "SCANNED"
         }
        }
       ],
       "background_color": "#1B2740",
       "border": {
        "corner_radius": 12,
        "stroke": {
         "color": "#24304A",
         "width": 1
        }
       },
       "weight": 1,
       "id": "kiosk_scan_current"
      },
      {
       "type": "button",
       "text": "Clear scanned",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.scanned_chunks",
         "value": {
          "type": "array",
          "value": []
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_status",
         "value": {
          "type": "string",
          "value": "IDLE"
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_json",
         "value": {
          "type": "string",
          "value": ""
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_checksum_ok",
         "value": {
          "type": "boolean",
          "value": false
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_missing",
         "value": {
          "type": "array",
          "value": []
         }
        }
       ],
       "weight": 1,
       "id": "kiosk_clear_scanned",
       "background_color": "#E2E8F0"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Assemble",
       "font_size": 15,
       "font_weight": "bold",
       "text_color": "#FFFFFF",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.receipt_checksum_ok",
         "value": {
          "type": "boolean",
          "value": false
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_json",
         "value": {
          "type": "string",
          "value": ""
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_missing",
         "value": {
          "type": "array",
          "value": []
         }
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_error",
         "value": {
          "type": "string",
          "value": ""
         }
        },
        {
         "url": "tools://codec/json/assemble",
         "payload": {
          "chunks": "@{user.scanned_chunks}",
          "encoding": "base45",
          "output": {
           "status": "user.receipt_status",
           "json": "user.receipt_json",
           "checksum_ok": "user.receipt_checksum_ok",
           "missing": "user.receipt_missing",
           "error": "user.receipt_error"
          }
         },
         "log_id": "kiosk_transfer_assemble"
        }
       ],
       "background_color": "#8B5CF6",
       "weight": 1,
       "id": "kiosk_assemble_scanned"
      },
      {
       "type": "button",
       "text": "Corrupt chunk",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "type": "array_insert_value",
         "variable_name": "user.scanned_chunks",
         "value": "C1|corrupt|00|01|deadbeef|!!!"
        },
        {
         "type": "set_variable",
         "variable_name": "user.receipt_status",
         "value": {
          "type": "string",
          "value": "INJECTED_CORRUPT"
         }
        }
       ],
       "weight": 1,
       "id": "kiosk_corrupt_chunk",
       "background_color": "#E2E8F0"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Result",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.receipt_status == 'IDLE', 'Nothing scanned yet', if(user.receipt_status == 'COMPLETE', 'Verified — payload restored', if(user.receipt_status == 'PARTIAL', 'Incomplete — chunks missing', if(user.receipt_status == 'FAILED', 'Checksum mismatch', if(user.receipt_status == 'SCANNED', 'Chunk added — keep scanning', user.receipt_status)))))}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Checksum",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.receipt_checksum_ok, 'MATCH', 'NOT VERIFIED')}",
       "font_size": 13,
       "text_color": "#94A3B8",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Missing",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(len(user.receipt_missing) == 0, 'none', 'chunks ' + user.receipt_missing)}",
       "font_size": 13,
       "text_color": "#94A3B8",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Reason",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.receipt_error == '', 'none', user.receipt_error)}",
       "font_size": 12,
       "text_color": "#FCA5A5",
       "font_weight": "bold"
      }
     ]
    }
   ],
   "background_color": "#131C2E",
   "paddings": {
    "left": 16,
    "right": 16,
    "top": 16,
    "bottom": 16
   },
   "corner_radius": 14,
   "border": {
    "corner_radius": 14,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   }
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Reconstructed payload",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "vertical",
     "item_spacing": 12,
     "items": [
      {
       "type": "text",
       "text": "@{if(user.receipt_json == '', 'Nothing assembled yet.', if(user.receipt_checksum_ok, 'Checksum verified — the payload below is what the sending terminal packed.', 'Payload assembled but not verified.'))}",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_family": "monospace",
       "max_lines": 6
      },
      {
       "type": "text",
       "id": "kiosk_receipt_compare",
       "text": "@{if(user.receipt_json == '' || user.kiosk_payload_json == '', '', if(user.receipt_json == user.kiosk_payload_json, 'Matches the live order payload exactly', 'Differs from the live order payload'))}",
       "font_size": 11,
       "text_color": "#047857",
       "visibility": "@{if(user.receipt_json != '' && user.kiosk_payload_json != '', 'visible', 'gone')}"
      },
      {
       "type": "text",
       "id": "kiosk_receipt_json",
       "text": "@{user.receipt_json}",
       "font_size": 11,
       "font_family": "monospace",
       "text_color": "#334155",
       "visibility": "@{if(user.receipt_json == '', 'gone', 'visible')}"
      }
     ],
     "background_color": "#131C2E",
     "paddings": {
      "left": 12,
      "right": 12,
      "top": 12,
      "bottom": 12
     },
     "corner_radius": 12,
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     }
    }
   ]
  }
 ]
}

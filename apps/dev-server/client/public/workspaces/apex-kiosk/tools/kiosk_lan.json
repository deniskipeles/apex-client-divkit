{
 "type": "container",
 "orientation": "vertical",
 "item_spacing": 16,
 "items": [
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 10,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "container",
       "orientation": "vertical",
       "item_spacing": 4,
       "items": [
        {
         "type": "text",
         "text": "LAN share",
         "font_size": 24,
         "text_color": "#F8FAFC",
         "font_weight": "bold"
        },
        {
         "type": "text",
         "text": "Serve the order payload to other devices on this network",
         "font_size": 12,
         "text_color": "#94A3B8"
        }
       ],
       "weight": 1
      }
     ]
    },
    {
     "type": "text",
     "text": "@{if(user.net_status == '' , 'IDLE', user.net_status)}",
     "font_size": 11,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "background_color": "#1B2740",
     "corner_radius": 20,
     "paddings": {
      "left": 10,
      "right": 10,
      "top": 5,
      "bottom": 5
     },
     "margins": {
      "top": 6
     }
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Port",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "@{if(toInteger(user.net_hub_port) == 0, 'stopped', toInteger(user.net_hub_port))}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      },
      {
       "type": "text",
       "text": "·",
       "font_size": 11,
       "text_color": "#64748B"
      },
      {
       "type": "text",
       "text": "@{user.net_share_count} shared",
       "font_size": 12,
       "text_color": "#94A3B8"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#3F1D24",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.engine_error}",
     "font_size": 12,
     "text_color": "#FCA5A5",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.engine_error != '', 'visible', 'gone')}",
   "id": "kiosk_lan_error"
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "background_color": "#1B2740",
   "corner_radius": 10,
   "paddings": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 10
   },
   "items": [
    {
     "type": "text",
     "text": "@{user.kiosk_notice}",
     "font_size": 12,
     "text_color": "#F8FAFC",
     "max_lines": 3
    }
   ],
   "visibility": "@{if(user.kiosk_notice != '', 'visible', 'gone')}",
   "id": "kiosk_lan_notice"
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Hub URL",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.net_lan_url == '', 'Not running', user.net_lan_url)}",
       "font_size": 13,
       "text_color": "#F8FAFC",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Share id",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.net_share_id == '', '—', user.net_share_id)}",
       "font_size": 12,
       "text_color": "#94A3B8",
       "font_weight": "bold",
       "font_family": "monospace"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Last share",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(user.net_share_path == '', '—', user.net_share_path)}",
       "font_size": 12,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Size",
       "font_size": 12,
       "text_color": "#94A3B8",
       "weight": 1
      },
      {
       "type": "text",
       "text": "@{if(toInteger(user.net_share_bytes) == 0, '—', toInteger(user.net_share_bytes) + ' bytes')}",
       "font_size": 12,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      }
     ]
    }
   ],
   "background_color": "#131C2E",
   "paddings": {
    "left": 16,
    "right": 16,
    "top": 16,
    "bottom": 16
   },
   "corner_radius": 14,
   "border": {
    "corner_radius": 14,
    "stroke": {
     "color": "#24304A",
     "width": 1
    }
   }
  },
  {
   "type": "container",
   "orientation": "horizontal",
   "item_spacing": 8,
   "items": [
    {
     "type": "button",
     "text": "Start hub",
     "font_size": 14,
     "font_weight": "bold",
     "text_color": "#F8FAFC",
     "corner_radius": 12,
     "actions": [
      {
       "type": "set_variable",
       "variable_name": "user.net_status",
       "value": {
        "type": "string",
        "value": "STARTING"
       }
      },
      {
       "url": "tools://net/serve",
       "payload": {
        "port": 8089,
        "label": "Apex Kiosk",
        "output": {
         "status": "user.net_status",
         "lan_url": "user.net_lan_url",
         "port": "user.net_hub_port",
         "hub_id": "user.net_hub_id",
         "share_count": "user.net_share_count"
        }
       },
       "log_id": "kiosk_lan_start"
      }
     ],
     "background_color": "#1B2740",
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     },
     "weight": 1,
     "id": "kiosk_lan_start"
    },
    {
     "type": "button",
     "text": "Stop hub",
     "font_size": 13,
     "font_weight": "normal",
     "text_color": "#334155",
     "corner_radius": 12,
     "actions": [
      {
       "url": "tools://net/stop",
       "payload": {
        "output": {
         "status": "user.net_status",
         "lan_url": "user.net_lan_url",
         "port": "user.net_hub_port",
         "share_count": "user.net_share_count"
        }
       },
       "log_id": "kiosk_lan_stop"
      },
      {
       "type": "set_variable",
       "variable_name": "user.net_lan_url",
       "value": {
        "type": "string",
        "value": ""
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.net_hub_port",
       "value": {
        "type": "integer",
        "value": 0
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.net_share_id",
       "value": {
        "type": "string",
        "value": ""
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.net_share_count",
       "value": {
        "type": "integer",
        "value": 0
       }
      },
      {
       "type": "set_variable",
       "variable_name": "user.net_response",
       "value": {
        "type": "string",
        "value": ""
       }
      }
     ],
     "weight": 1,
     "id": "kiosk_lan_stop",
     "background_color": "#E2E8F0"
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Share",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      },
      {
       "type": "text",
       "text": "@{user.net_share_count} @{if(toInteger(user.net_share_count) == 1, 'item', 'items')}",
       "font_size": 11,
       "text_color": "#64748B",
       "weight": 1
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Share order",
       "font_size": 15,
       "font_weight": "bold",
       "text_color": "#FFFFFF",
       "corner_radius": 12,
       "actions": [
        {
         "type": "set_variable",
         "variable_name": "user.kiosk_notice",
         "value": {
          "type": "string",
          "value": "Shared the live order payload"
         }
        },
        {
         "url": "local-db://op/doc.pack",
         "payload": {
          "collection": "kiosk_orders",
          "id": "@{user.kiosk_order_id}",
          "output": {
           "id": "user.kiosk_order_label",
           "status": "user.kiosk_status",
           "direction": "user.kiosk_direction",
           "total_display": "user.kiosk_total",
           "subtotal_display": "user.kiosk_subtotal",
           "item_count": "user.kiosk_item_count",
           "line_count": "user.kiosk_line_count",
           "lines_json": "user.kiosk_lines_json",
           "payload_json": "user.kiosk_payload_json",
           "checksum": "user.kiosk_checksum"
          }
         },
         "log_id": "kiosk_lan_export"
        },
        {
         "url": "tools://net/share",
         "payload": {
          "name": "order-@{user.kiosk_order_label}.json",
          "payload": "@{user.kiosk_payload_json}",
          "content_type": "application/json",
          "output": {
           "status": "user.net_status",
           "id": "user.net_share_id",
           "path": "user.net_share_path",
           "bytes": "user.net_share_bytes",
           "count": "user.net_share_count",
           "warning": "user.kiosk_notice"
          }
         },
         "log_id": "kiosk_lan_share"
        }
       ],
       "background_color": "#8B5CF6",
       "weight": 1,
       "id": "kiosk_lan_share"
      },
      {
       "type": "button",
       "text": "Unshare",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "url": "tools://net/unshare",
         "payload": {
          "id": "@{user.net_share_id}",
          "output": {
           "status": "user.net_status",
           "remaining": "user.net_share_count"
          }
         },
         "log_id": "kiosk_lan_unshare"
        },
        {
         "type": "set_variable",
         "variable_name": "user.net_share_id",
         "value": {
          "type": "string",
          "value": ""
         }
        }
       ],
       "weight": 1,
       "id": "kiosk_lan_unshare",
       "background_color": "#E2E8F0"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "button",
       "text": "Refresh list",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "url": "tools://net/list",
         "payload": {
          "output": {
           "count": "user.net_share_count",
           "status": "user.net_status"
          }
         },
         "log_id": "kiosk_lan_list"
        }
       ],
       "weight": 1,
       "id": "kiosk_lan_list",
       "background_color": "#E2E8F0"
      },
      {
       "type": "button",
       "text": "Fetch /list",
       "font_size": 13,
       "font_weight": "normal",
       "text_color": "#334155",
       "corner_radius": 12,
       "actions": [
        {
         "url": "tools://net/request",
         "payload": {
          "url": "@{user.net_lan_url}/list",
          "method": "GET",
          "timeout_ms": 4000,
          "output": {
           "status": "user.net_status",
           "body": "user.net_response"
          }
         },
         "log_id": "kiosk_lan_fetch"
        }
       ],
       "weight": 1,
       "id": "kiosk_lan_fetch",
       "background_color": "#E2E8F0"
      }
     ]
    }
   ]
  },
  {
   "type": "container",
   "orientation": "vertical",
   "item_spacing": 8,
   "items": [
    {
     "type": "container",
     "orientation": "horizontal",
     "item_spacing": 8,
     "items": [
      {
       "type": "text",
       "text": "Hub response",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_weight": "bold"
      }
     ]
    },
    {
     "type": "container",
     "orientation": "vertical",
     "item_spacing": 12,
     "items": [
      {
       "type": "text",
       "text": "@{if(user.net_response == '', 'No response yet — start the hub, then fetch /list.', user.net_response)}",
       "font_size": 11,
       "text_color": "#94A3B8",
       "font_family": "monospace",
       "max_lines": 6
      }
     ],
     "background_color": "#131C2E",
     "paddings": {
      "left": 12,
      "right": 12,
      "top": 12,
      "bottom": 12
     },
     "corner_radius": 12,
     "border": {
      "corner_radius": 12,
      "stroke": {
       "color": "#24304A",
       "width": 1
      }
     }
    }
   ]
  }
 ]
}

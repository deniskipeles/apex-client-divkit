   {
    "name": "user.net_shares_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.print_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.screen_state",
    "type": "string",
    "value": "idle"
   },
   {
    "name": "user.samples_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.samples_count",
    "type": "integer",
    "value": 0
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "orientation": "vertical",
     "items": [
      {
       "type": "container",
       "orientation": "horizontal",
       "items": [
        {
         "type": "button",
         "text": "Back",
         "font_size": 12,
         "font_weight": "bold",
         "text_color": "#F8FAFC",
         "background_color": "#16233A",
         "corner_radius": 12,
         "height": {
          "type": "fixed",
          "value": 40
         },
         "width": {
          "type": "fixed",
          "value": 80
         },
         "actions": [
          {
           "url": "nav://pop"
          }
         ],
         "border": {
          "corner_radius": 12,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         },
         "id": "btn_back"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Data views",
           "font_size": 18,
           "font_weight": "bold",
           "text_color": "#F8FAFC"
          },
          {
           "type": "text",
           "text": "Chart and list blocks over the samples collection",
           "font_size": 12,
           "font_weight": "regular",
           "text_color": "#94A3B8"
          }
         ],
         "weight": 1
        }
       ],
       "item_spacing": 8,
       "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
       }
      },
      {
       "type": "container",
       "orientation": "vertical",
       "items": [
        {
         "type": "custom",
         "custom_type": "sdui_chart",
         "custom_props": {
          "chart_type": "donut",
          "title": "SAMPLES BY ID",
          "subtitle": "Live from user.samples_json",
          "label_field": "name",
          "value_field": "id",
          "value_prefix": "",
          "value_suffix": "",
          "accent_color": "#38BDF8",
          "height": 220,
          "show_grid": true,
          "show_legend": true,
          "interactive": true,
          "data_var": "user.samples_json"
         },
         "id": "samples_chart"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "SAMPLES",
           "font_size": 11,
           "font_weight": "bold",
           "text_color": "#94A3B8"
          },
          {
           "type": "json_list",
           "data_var": "user.samples_json",
           "empty_text": "Query the samples collection first",
           "row_card": {
            "type": "container",
            "orientation": "horizontal",
            "items": [
             {
              "type": "text",
              "text": "@{item.name}",
              "font_size": 12,
              "font_weight": "regular",
              "text_color": "#F8FAFC",
              "width": {
               "type": "match_parent"
              }
             },
             {
              "type": "text",
              "text": "#@{item.id}",
              "font_size": 11,
              "font_weight": "regular",
              "text_color": "#34D399"
             }
            ],
            "background_color": "#16233A",
            "paddings": {
             "left": 8,
             "top": 8,
             "right": 8,
             "bottom": 8
            },
            "border": {
             "corner_radius": 12
            }
           },
           "id": "samples_list"
          },
          {
           "type": "button",
           "text": "Refresh samples",
           "font_size": 14,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "background_color": "#16233A",
           "corner_radius": 12,
           "height": {
            "type": "fixed",
            "value": 44
           },
           "width": {
            "type": "match_parent"
           },
           "actions": [
            {
             "url": "local-db://op/db.query",
             "payload": {
              "collection": "samples",
              "order_by": "id",
              "limit": 50,
              "output": {
               "_json": "user.samples_json"
              }
             }
            }
           ],
           "border": {
            "corner_radius": 12,
            "stroke": {
             "color": "#1E293B",
             "width": 1
            }
           },
           "id": "refresh_samples"
          }
         ],
         "item_spacing": 8,
         "background_color": "#111C2E",
         "paddings": {
          "left": 12,
          "top": 12,
          "right": 12,
          "bottom": 12
         },
         "border": {
          "corner_radius": 16,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         }
        }
       ],
       "item_spacing": 12,
       "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
       }
      }
     ],
     "item_spacing": 8,
     "paddings": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 16
     }
    }
   }
  ]
 }
}

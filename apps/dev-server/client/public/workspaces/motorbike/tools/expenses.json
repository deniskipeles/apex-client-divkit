{
 "card": {
  "log_id": "motorbike_expenses",
  "variables": [
   {
    "name": "user.workspace_title",
    "type": "string",
    "value": "BODA BODA"
   },
   {
    "name": "user.rider_name",
    "type": "string",
    "value": "Rider"
   },
   {
    "name": "user.earnings_today",
    "type": "string",
    "value": "0"
   },
   {
    "name": "user.trip_count",
    "type": "integer",
    "value": 0
   },
   {
    "name": "user.net_profit",
    "type": "string",
    "value": "0"
   },
   {
    "name": "user.fare_input",
    "type": "string",
    "value": "150"
   },
   {
    "name": "user.payment_method",
    "type": "string",
    "value": "M-Pesa"
   },
   {
    "name": "user.route_input",
    "type": "string",
    "value": ""
   },
   {
    "name": "user.weekly_json",
    "type": "string",
    "value": "[{\"day\":\"Mon\",\"fare\":1240},{\"day\":\"Tue\",\"fare\":980},{\"day\":\"Wed\",\"fare\":1610},{\"day\":\"Thu\",\"fare\":1050},{\"day\":\"Fri\",\"fare\":1870},{\"day\":\"Sat\",\"fare\":2240},{\"day\":\"Sun\",\"fare\":0}]"
   },
   {
    "name": "user.trips_json",
    "type": "string",
    "value": "[{\"id\":\"t1\",\"day\":\"Sat\",\"fare\":350,\"payment\":\"M-Pesa\",\"route\":\"Kawangware → CBD\"},{\"id\":\"t2\",\"day\":\"Sat\",\"fare\":220,\"payment\":\"Cash\",\"route\":\"Westlands → Parklands\"},{\"id\":\"t3\",\"day\":\"Fri\",\"fare\":480,\"payment\":\"M-Pesa\",\"route\":\"CBD → Karen\"}]"
   },
   {
    "name": "user.expenses_json",
    "type": "string",
    "value": "[]"
   },
   {
    "name": "user.handover_status",
    "type": "string",
    "value": "NOT_STARTED"
   },
   {
    "name": "user.trip_modal",
    "type": "boolean",
    "value": false
   },
   {
    "name": "user.last_action",
    "type": "string",
    "value": "Ready"
   }
  ],
  "states": [
   {
    "state_id": 0,
    "div": {
     "type": "container",
     "orientation": "vertical",
     "items": [
      {
       "type": "container",
       "orientation": "horizontal",
       "items": [
        {
         "type": "button",
         "text": "Back",
         "font_size": 12,
         "font_weight": "bold",
         "text_color": "#F8FAFC",
         "background_color": "#16233A",
         "corner_radius": 12,
         "height": {
          "type": "fixed",
          "value": 40
         },
         "width": {
          "type": "fixed",
          "value": 80
         },
         "actions": [
          {
           "url": "nav://pop"
          }
         ],
         "border": {
          "corner_radius": 12,
          "stroke": {
           "color": "#1E293B",
           "width": 1
          }
         },
         "id": "btn_back"
        },
        {
         "type": "container",
         "orientation": "vertical",
         "items": [
          {
           "type": "text",
           "text": "Expenses",
           "font_size": 26,
           "font_weight": "bold",
           "text_color": "#F8FAFC",
           "max_lines": 2
          },
          {
           "type": "text",
           "text": "Fuel, repairs and licence",
           "font_size": 12,
           "font_weight": "regular",
           "text_color": "#94A3B8",
           "max_lines": 2
          }
         ],
         "weight": 1
        }
       ],
       "item_spacing": 8,
       "paddings": {
        "left": 16,
        "top": 32,
        "right": 16,
        "bottom": 8
       }
      },
      {
       "type": "container",
       "orientation": "vertical",
       "items": [
        {
         "type": "segmented",
         "custom_props": {
          "items": [
           {
            "value": "Fuel",
            "label": "Fuel"
           },
           {
            "value": "Repairs",
            "label": "Repairs"
           },
           {
            "value": "Licence",
            "label": "Licence"
           }
          ],
          "active_value": "Fuel"
         },
         "id": "expense_kind"
        },
        {
         "type": "json_list",
         "data_var": "user.expenses_json",
         "empty_text": "No expenses logged today",
         "row_card": {
          "type": "container",
          "orientation": "horizontal",
          "items": [
           {
            "type": "text",
            "text": "@{item.kind}",
            "font_size": 12,
            "font_weight": "regular",
            "text_color": "#F8FAFC",
            "width": {
             "type": "match_parent"
            }
           },
           {
            "type": "text",
            "text": "KES @{item.amount}",
            "font_size": 12,
            "font_weight": "bold",
            "text_color": "#F59E0B"
           }
          ],
          "background_color": "#16233A",
          "paddings": {
           "left": 8,
           "top": 8,
           "right": 8,
           "bottom": 8
          },
          "border": {
           "corner_radius": 12
          }
         },
         "id": "expense_list"
        },
        {
         "type": "fab",
         "custom_props": {
          "label": "Log expense",
          "actions": [
           {
            "url": "div-action://set_variable?name=user.expense_modal&value=true"
           }
          ]
         },
         "id": "expense_fab"
        },
        {
         "type": "form_modal",
         "custom_props": {
          "visible": false,
          "title": "Log an expense",
          "body": [
           {
            "type": "text",
            "text": "Amount and note",
            "font_size": 12,
            "font_weight": "regular",
            "text_color": "#94A3B8"
           },
           {
            "type": "text_field",
            "custom_props": {
             "label": "Amount",
             "variable": "user.expense_amount",
             "placeholder": "500"
            }
           }
          ],
          "primary_label": "Save",
          "primary": {
           "actions": [
            {
             "url": "local-db://op/db.insert",
             "payload": {
              "collection": "expenses",
              "data": {
               "kind": "@{user.expense_kind}",
               "amount": "@{user.expense_amount}"
              }
             }
            }
           ]
          },
          "secondary_label": "Cancel",
          "secondary": {
           "actions": [
            {
             "url": "div-action://set_variable?name=user.expense_modal&value=false"
            }
           ]
          }
         },
         "id": "expense_modal"
        }
       ],
       "item_spacing": 12,
       "paddings": {
        "left": 16,
        "top": 0,
        "right": 16,
        "bottom": 0
       }
      }
     ],
     "item_spacing": 8,
     "paddings": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 16
     }
    }
   }
  ]
 }
}

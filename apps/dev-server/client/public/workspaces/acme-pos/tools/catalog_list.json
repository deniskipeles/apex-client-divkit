{
  "type": "container",
  "item_spacing": 8,
  "items": [
    {
      "type": "text",
      "font_size": 11,
      "font_weight": "bold",
      "text": "CATALOG · LIVE FROM INVENTORY",
      "text_color": "#34D399"
    },
    {
      "type": "json_list",
      "data_var": "user.catalog_json",
      "empty_text": "No SKUs in acme_pos_catalog",
      "row_card": {
        "type": "container",
        "border": {
          "corner_radius": 10,
          "stroke": {
            "color": "#1E293B",
            "width": 1
          }
        },
        "items": [
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "bold",
                "text": "@{item.item_name} (@{item.category})",
                "text_color": "#F8FAFC"
              },
              {
                "type": "text",
                "font_family": "monospace",
                "font_size": 11,
                "text": "SKU: @{item.sku} • $@{item.price_display} • Stock: @{item.stock}",
                "text_color": "#34D399"
              }
            ],
            "orientation": "vertical"
          },
          {
            "type": "button",
            "weight": 0.4,
            "text": "+1 Order",
            "background_color": "#065F46",
            "text_color": "#A7F3D0",
            "corner_radius": 8,
            "actions": [
              {
                "log_id": "insert_order",
                "url": "local-db://op/db.insert",
                "payload": {
                  "table": "orders",
                  "values": {
                    "item_name": "@{item.item_name}",
                    "sku": "@{item.sku}",
                    "price": "@{item.price}",
                    "qty": 1,
                    "terminal_id": "POS-TERM-01",
                    "status": "OPEN"
                  },
                  "output": {
                    "id": "user.last_order_id"
                  }
                }
              },
              {
                "log_id": "refresh_orders_list",
                "url": "local-db://op/db.query",
                "payload": {
                  "table": "orders",
                  "order_by": "id",
                  "limit": 50,
                  "json_list_var": "user.orders_json",
                  "output": {
                    "_json": "user.orders_json"
                  }
                }
              },
              {
                "log_id": "count_orders",
                "url": "local-db://op/db.count",
                "payload": {
                  "table": "orders",
                  "output": {
                    "count": "user.order_count"
                  }
                }
              }
            ]
          }
        ],
        "orientation": "horizontal",
        "paddings": {
          "left": 12,
          "right": 12,
          "top": 8,
          "bottom": 8
        }
      }
    }
  ],
  "orientation": "vertical"
}

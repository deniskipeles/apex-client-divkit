{
  "id": "product_form_modal",
  "type": "form_modal",
  "custom_props": {
    "visible": true,
    "title": "@{product.is_edit ? 'Edit product' : 'New product'}",
    "body": [
      {
        "type": "container",
        "items": [
          {
            "type": "container",
            "items": [
              {
                "type": "container",
                "background": [
                  {
                    "type": "solid",
                    "color": "#E6E8EF"
                  }
                ],
                "border": {
                  "corner_radius": 12
                },
                "content_alignment_horizontal": "center",
                "content_alignment_vertical": "center",
                "height": {
                  "type": "fixed",
                  "value": 96
                },
                "items": [
                  {
                    "type": "image",
                    "border": {
                      "corner_radius": 12
                    },
                    "height": {
                      "type": "fixed",
                      "value": 72
                    },
                    "image_url": "@{product.photo_url}",
                    "placeholder_color": "#E6E8EF",
                    "width": {
                      "type": "fixed",
                      "value": 96
                    }
                  },
                  {
                    "type": "text",
                    "font_size": 11,
                    "text": "Add photo",
                    "text_color": "#5B6070"
                  }
                ],
                "orientation": "vertical",
                "width": {
                  "type": "fixed",
                  "value": 96
                }
              }
            ],
            "margins": {
              "bottom": 24
            }
          },
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Name",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 12,
                  "stroke": {
                    "color": "@{product.errors.name != '' ? '#C81E1E' : '#E6E8EF'}",
                    "width": 1
                  }
                },
                "height": {
                  "type": "fixed",
                  "value": 52
                },
                "items": [
                  {
                    "type": "input",
                    "font_size": 16,
                    "hint_color": "#5B6070",
                    "hint_text": "Latte",
                    "id": "field_name",
                    "keyboard_type": "single_line_text",
                    "max_visible_lines": 1,
                    "text_color": "#111319",
                    "text_variable": "product.name",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  }
                ],
                "margins": {
                  "top": 6
                },
                "orientation": "horizontal",
                "paddings": {
                  "left": 14,
                  "right": 14,
                  "top": 8,
                  "bottom": 8
                },
                "width": {
                  "type": "match_parent"
                }
              },
              {
                "type": "text",
                "font_size": 13,
                "margins": {
                  "top": 4
                },
                "text": "@{product.errors.name}",
                "text_color": "#C81E1E",
                "visibility": "@{product.errors.name != '' ? 'visible' : 'gone'}"
              }
            ],
            "margins": {
              "bottom": 24
            },
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Price",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 12,
                  "stroke": {
                    "color": "@{product.errors.price != '' ? '#C81E1E' : '#E6E8EF'}",
                    "width": 1
                  }
                },
                "height": {
                  "type": "fixed",
                  "value": 52
                },
                "items": [
                  {
                    "type": "text",
                    "font_size": 16,
                    "margins": {
                      "right": 6
                    },
                    "text": "$",
                    "text_color": "#5B6070"
                  },
                  {
                    "type": "input",
                    "font_size": 16,
                    "hint_color": "#5B6070",
                    "hint_text": "0.00",
                    "id": "field_price",
                    "keyboard_type": "number",
                    "max_visible_lines": 1,
                    "text_color": "#111319",
                    "text_variable": "product.price",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  }
                ],
                "margins": {
                  "top": 6
                },
                "orientation": "horizontal",
                "paddings": {
                  "left": 14,
                  "right": 14,
                  "top": 8,
                  "bottom": 8
                },
                "width": {
                  "type": "match_parent"
                }
              },
              {
                "type": "text",
                "font_size": 13,
                "margins": {
                  "top": 4
                },
                "text": "@{product.errors.price}",
                "text_color": "#C81E1E",
                "visibility": "@{product.errors.price != '' ? 'visible' : 'gone'}"
              }
            ],
            "margins": {
              "bottom": 24
            },
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Code",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 12,
                  "stroke": {
                    "color": "@{product.errors.code != '' ? '#C81E1E' : '#E6E8EF'}",
                    "width": 1
                  }
                },
                "height": {
                  "type": "fixed",
                  "value": 52
                },
                "items": [
                  {
                    "type": "input",
                    "font_size": 16,
                    "hint_color": "#5B6070",
                    "hint_text": "Barcode or QR value",
                    "id": "field_code",
                    "keyboard_type": "single_line_text",
                    "max_visible_lines": 1,
                    "text_color": "#111319",
                    "text_variable": "product.code",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  },
                  {
                    "type": "container",
                    "background": [
                      {
                        "type": "solid",
                        "color": "#E6F6F0"
                      }
                    ],
                    "border": {
                      "corner_radius": 999
                    },
                    "items": [
                      {
                        "type": "text",
                        "font_size": 13,
                        "font_weight": "medium",
                        "text": "✓ scanned",
                        "text_color": "#057A55"
                      }
                    ],
                    "margins": {
                      "right": 8
                    },
                    "paddings": {
                      "left": 10,
                      "right": 10,
                      "top": 4,
                      "bottom": 4
                    },
                    "visibility": "@{product.code_scanned ? 'visible' : 'gone'}"
                  },
                  {
                    "type": "container",
                    "actions": [
                      {
                        "log_id": "open_code_scan_sheet",
                        "url": "sheet://present?card_id=owner_scan_sheet"
                      }
                    ],
                    "background": [
                      {
                        "type": "solid",
                        "color": "#F1EDFF"
                      }
                    ],
                    "border": {
                      "corner_radius": 10
                    },
                    "content_alignment_horizontal": "center",
                    "content_alignment_vertical": "center",
                    "height": {
                      "type": "fixed",
                      "value": 48
                    },
                    "items": [
                      {
                        "type": "text",
                        "font_size": 13,
                        "font_weight": "bold",
                        "text": "Scan",
                        "text_alignment_horizontal": "center",
                        "text_color": "#5A3BE0"
                      }
                    ],
                    "width": {
                      "type": "fixed",
                      "value": 52
                    }
                  }
                ],
                "margins": {
                  "top": 6
                },
                "orientation": "horizontal",
                "paddings": {
                  "left": 14,
                  "right": 4,
                  "top": 8,
                  "bottom": 8
                },
                "width": {
                  "type": "match_parent"
                }
              },
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Scan the barcode or type it in",
                "text_color": "#5B6070"
              },
              {
                "type": "text",
                "font_size": 13,
                "margins": {
                  "top": 4
                },
                "text": "@{product.errors.code}",
                "text_color": "#C81E1E",
                "visibility": "@{product.errors.code != '' ? 'visible' : 'gone'}"
              }
            ],
            "margins": {
              "bottom": 24
            },
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "background": [
              {
                "type": "solid",
                "color": "#FEE2E2"
              }
            ],
            "border": {
              "corner_radius": 12
            },
            "id": "save_error_banner",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "line_height": 18,
                "text": "@{product.errors_json}",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "items": [
                  {
                    "type": "container",
                    "actions": [
                      {
                        "log_id": "dismiss_save_error",
                        "url": "div-action://set_variable?name=product.errors_json&value="
                      }
                    ],
                    "content_alignment_vertical": "center",
                    "height": {
                      "type": "fixed",
                      "value": 48
                    },
                    "items": [
                      {
                        "type": "text",
                        "font_size": 13,
                        "font_weight": "medium",
                        "text": "Dismiss",
                        "text_color": "#5B6070"
                      }
                    ]
                  }
                ],
                "margins": {
                  "top": 8
                },
                "orientation": "horizontal"
              }
            ],
            "orientation": "vertical",
            "paddings": {
              "left": 14,
              "right": 14,
              "top": 12,
              "bottom": 12
            },
            "visibility": "@{product.errors_json != '' ? 'visible' : 'gone'}",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "SKU",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 12,
                  "stroke": {
                    "color": "@{product.errors.sku != '' ? '#C81E1E' : '#E6E8EF'}",
                    "width": 1
                  }
                },
                "height": {
                  "type": "fixed",
                  "value": 52
                },
                "items": [
                  {
                    "type": "input",
                    "font_size": 16,
                    "hint_color": "#5B6070",
                    "hint_text": "LAT-01",
                    "id": "field_sku",
                    "keyboard_type": "single_line_text",
                    "max_visible_lines": 1,
                    "text_color": "#111319",
                    "text_variable": "product.sku",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  }
                ],
                "margins": {
                  "top": 6
                },
                "orientation": "horizontal",
                "paddings": {
                  "left": 14,
                  "right": 14,
                  "top": 8,
                  "bottom": 8
                },
                "width": {
                  "type": "match_parent"
                }
              },
              {
                "type": "text",
                "font_size": 13,
                "margins": {
                  "top": 4
                },
                "text": "@{product.errors.sku}",
                "text_color": "#C81E1E",
                "visibility": "@{product.errors.sku != '' ? 'visible' : 'gone'}"
              }
            ],
            "margins": {
              "bottom": 24
            },
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "items": [
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Description",
                "text_color": "#111319"
              },
              {
                "type": "container",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#FFFFFF"
                  }
                ],
                "border": {
                  "corner_radius": 12,
                  "stroke": {
                    "color": "#E6E8EF",
                    "width": 1
                  }
                },
                "height": {
                  "type": "fixed",
                  "value": 52
                },
                "items": [
                  {
                    "type": "input",
                    "font_size": 16,
                    "hint_color": "#5B6070",
                    "hint_text": "Optional notes",
                    "id": "field_desc",
                    "keyboard_type": "multi_line_text",
                    "max_visible_lines": 4,
                    "text_color": "#111319",
                    "text_variable": "product.description",
                    "width": {
                      "type": "match_parent",
                      "weight": 1
                    }
                  }
                ],
                "margins": {
                  "top": 6
                },
                "orientation": "horizontal",
                "paddings": {
                  "left": 14,
                  "right": 14,
                  "top": 8,
                  "bottom": 8
                },
                "width": {
                  "type": "match_parent"
                }
              },
              {
                "type": "text",
                "font_size": 13,
                "font_weight": "medium",
                "line_height": 18,
                "text": "Up to 240 characters",
                "text_color": "#5B6070"
              }
            ],
            "margins": {
              "bottom": 24
            },
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            }
          },
          {
            "type": "container",
            "actions": [
              {
                "log_id": "confirm_delete_prod",
                "url": "nav://push?id=confirm_delete_product"
              }
            ],
            "content_alignment_horizontal": "center",
            "content_alignment_vertical": "center",
            "height": {
              "type": "fixed",
              "value": 48
            },
            "items": [
              {
                "type": "text",
                "font_size": 16,
                "text": "Delete product",
                "text_color": "#5B6070"
              }
            ],
            "margins": {
              "top": 8
            },
            "visibility": "@{product.is_edit ? 'visible' : 'gone'}",
            "width": {
              "type": "match_parent"
            }
          }
        ],
        "orientation": "vertical",
        "paddings": {
          "left": 20,
          "right": 20,
          "top": 20,
          "bottom": 32
        },
        "width": {
          "type": "match_parent"
        }
      }
    ],
    "primary_label": "Save",
    "primary": {
      "actions": [
        {
          "log_id": "save_product_form",
          "url": "local-db://op/db.upsert",
          "payload": {
            "table": "inventory",
            "data": {
              "name": "@{product.name}",
              "sku": "@{product.sku}",
              "price": "@{product.price}",
              "code": "@{product.code}",
              "barcode": "@{product.code}",
              "description": "@{product.description}",
              "photo_url": "@{product.photo_url}",
              "stock": "@{product.is_edit ? product.stock : 0}"
            },
            "id": "@{product.id}",
            "output": {
              "errors_json": "product.errors_json"
            }
          }
        },
        {
          "log_id": "reload_after_save",
          "url": "local-db://op/db.query",
          "payload": {
            "table": "inventory",
            "filter": {
              "$or": [
                {
                  "name": {
                    "$contains": "@{owner.inv_query}"
                  }
                },
                {
                  "sku": {
                    "$contains": "@{owner.inv_query}"
                  }
                },
                {
                  "barcode": {
                    "$contains": "@{owner.inv_query}"
                  }
                },
                {
                  "code": {
                    "$contains": "@{owner.inv_query}"
                  }
                }
              ]
            },
            "order_by": "name",
            "limit": 100,
            "json_list_var": "owner.inv_items",
            "output": {
              "_count": "owner.inv_count"
            }
          }
        },
        {
          "log_id": "close_product_form",
          "url": "nav://pop"
        }
      ]
    },
    "secondary_label": "Cancel",
    "secondary": {
      "actions": [
        {
          "log_id": "cancel_product_form",
          "url": "nav://pop"
        }
      ]
    },
    "dirty_var": "product.dirty",
    "valid_var": "product.valid"
  }
}

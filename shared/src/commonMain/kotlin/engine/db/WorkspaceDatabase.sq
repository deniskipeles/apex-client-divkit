-- WorkspaceDatabase.sq
-- SQLDelight schema for a single tenant workspace.
-- Each workspace gets its own SQLite file, physically isolated.

CREATE TABLE op_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ts INTEGER NOT NULL,
    op TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    rowcount INTEGER,
    error TEXT
);

CREATE INDEX idx_op_log_ts ON op_log(ts);

CREATE TABLE pending_sync (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_uuid TEXT UNIQUE NOT NULL,
    op TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT
);

-- Persistent DivKit SDUI Schema Cache & Version Rollback Ledger
-- Stores every verified DivKit JSON schema received for this tenant workspace.
CREATE TABLE sdui_schema_versions (
    version_id INTEGER PRIMARY KEY AUTOINCREMENT,
    schema_version TEXT NOT NULL,
    jti TEXT NOT NULL,
    signed_envelope TEXT NOT NULL,
    verified_payload TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1,
    summary TEXT NOT NULL
);

CREATE INDEX idx_sdui_schema_active ON sdui_schema_versions(is_active, version_id DESC);

insertOpLog:
INSERT INTO op_log (ts, op, duration_ms, rowcount, error) VALUES (?, ?, ?, ?, ?);

insertPendingSync:
INSERT OR IGNORE INTO pending_sync (client_uuid, op, payload, created_at) VALUES (?, ?, ?, ?);

selectPendingBatch:
SELECT id, client_uuid, op, payload, attempts FROM pending_sync
WHERE attempts < ? ORDER BY id LIMIT ?;

deletePendingSync:
DELETE FROM pending_sync WHERE client_uuid = ?;

incrementPendingAttempts:
UPDATE pending_sync SET attempts = attempts + 1 WHERE client_uuid = ?;

markPendingDead:
UPDATE pending_sync SET attempts = attempts + 1, last_error = ? WHERE client_uuid = ?;

deactivateAllSchemaVersions:
UPDATE sdui_schema_versions SET is_active = 0;

insertSchemaVersion:
INSERT INTO sdui_schema_versions (schema_version, jti, signed_envelope, verified_payload, received_at, is_active, summary)
VALUES (?, ?, ?, ?, ?, 1, ?);

activateSchemaVersionById:
UPDATE sdui_schema_versions SET is_active = CASE WHEN version_id = ? THEN 1 ELSE 0 END;

selectActiveSchemaVersion:
SELECT version_id, schema_version, jti, signed_envelope, verified_payload, received_at, is_active, summary
FROM sdui_schema_versions WHERE is_active = 1 ORDER BY version_id DESC LIMIT 1;

selectAllSchemaVersions:
SELECT version_id, schema_version, jti, signed_envelope, verified_payload, received_at, is_active, summary
FROM sdui_schema_versions ORDER BY version_id DESC;

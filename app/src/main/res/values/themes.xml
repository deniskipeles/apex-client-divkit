<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme. Uses the branded splash background as the window background so the
         very first frame (before Compose draws) is never a blank white screen. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
